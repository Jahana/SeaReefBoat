# Secret of the Damp Scroll (outlands 135), the offer's level and the scroll: Norg fame 125 everywhere. A level 9
# Warrior with the Damp Scroll: Shivivi: the default 85; a level 10 char (bob) with it: 31, option 0 (none read): begun; a
# level 10 char (cid) without it: 85. main (available) at Horlais Peak: the scroll traded to the Hot Springs: no
# section: nothing. The scroll in another container than the inventory (hasItem looks in all) is not set
# up: the harness adds items to the inventory only.
lists Norg/Shivivi/onTrigger Norg/onEventFinish/31
char zone=Norg pos=71.62,-6.281,-7.341 job=WAR lvl=9
char bob zone=Norg pos=71.62,-6.281,-7.341 job=WAR lvl=10
char cid zone=Norg pos=71.62,-6.281,-7.341 job=WAR lvl=10
fame Norg 125
item DampScroll
bob: fame Norg 125
bob: item DampScroll
cid: fame Norg 125
login
trigger Shivivi                         # level 9: 85
finish
bob: login
bob: trigger Shivivi                    # level 10, the scroll: 31
bob: finish option=0                    # begun (no option read)
cid: login
cid: trigger Shivivi                    # no scroll: 85
cid: finish
warp 446.827,-37.752,-18.6 HorlaisPeak
trade Hot_Springs DampScroll x1         # available: no section: nothing
