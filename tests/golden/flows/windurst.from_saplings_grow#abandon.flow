# From Saplings Grow (windurst 85): 662 without the bow and its options. Accepted by GM with the guide alone: 662 (param
# 0), option 0, 2 and 4 (nothing); option 1 with a full bag (giveItem fails: nothing); option 1 (the bow, 0 weapon
# skill points); the bow traded: 663 (no finish handler); 662 (param 2), the Map to the Annals of Truth given by GM
# while it is open, option 3: the quest deleted, the guide and the map taken. Then available, Archery 0: not offered (338).
lists WindurstWoods/Perih_Vashai/onTrigger WindurstWoods/Perih_Vashai/onTrade WindurstWoods/onEventFinish/662
char zone=WindurstWoods pos=119.5,-3.7,90.45 job=RNG lvl=75
quest Windurst.TheFangedOne completed
quest Windurst.SinHunting completed
quest Windurst.FireAndBrimstone completed
quest Windurst.UnbridledPassion completed
quest Windurst.FromSaplingsGrow accepted
keyitem WeaponTrainingGuide
login
trigger Perih_Vashai                                   # accepted, no key items, no bow: event 662 (0, Bow of Trials, 0, 0, 0)
finish option=0                                     # nothing
trigger Perih_Vashai                                   # 662 again
finish option=2                                     # neither 1 nor 3: nothing
trigger Perih_Vashai                                   # 662 again
finish option=4                                     # nothing
trigger Perih_Vashai                                   # 662 again
fill-inventory
finish option=1                                     # no bow, the bag full: giveItem fails (its message)
free-inventory
trigger Perih_Vashai                                   # 662 again
finish option=1                                     # no bow: the Bow of Trials (0 weapon skill points)
walk 119.5,-3.7,90.45
trade Perih_Vashai BowOfTrials x1                     # 0 weapon skill points: event 663
finish                                              # 663 has no finish handler: the bow kept
trigger Perih_Vashai                                   # the bow held: 662 (..., 2)
keyitem MapToTheAnnalsOfTruth                       # the map given by GM while 662 is open
finish option=3                                     # the quest deleted; the guide and the map taken
trigger Perih_Vashai                                   # available, Archery 0: not offered; his default 338
finish
