# Lakeside Minuet (jeuno 95): 10113's finish guard (Prog 0). Accepted at Prog 0, Rhea Myuliah plays 10113; a GM sets
# Prog 2 while it is open, so its finish sets nothing; Rhea then plays 10115 (Prog 2 kept).
lists UpperJeuno/Rhea_Myuliah/onTrigger UpperJeuno/onEventFinish/10113 UpperJeuno/onEventFinish/10115
char zone=UpperJeuno pos=-52.5,0,101 job=WAR lvl=30
quest Jeuno.LakesideMinuet accepted
login
trigger Rhea_Myuliah                    # Prog 0: 10113
charvar Quest[3][95]Prog 2              # a GM, 10113 open
finish                                  # Prog 2, not 0: nothing
trigger Rhea_Myuliah                    # Prog 2: 10115
finish                                  # Prog 3
