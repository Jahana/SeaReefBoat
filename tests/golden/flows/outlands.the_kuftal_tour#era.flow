# The Kuftal Tour (outlands 195) with its module, modules/era/lua/quests/outlands/the_kuftal_tour.lua (Module
# 'the_kuftal_tour', xi.pre(ROV): RESTRICT_CONTENT 1, ENABLE_ROV 0): qm5 asks for a party of exactly 6. main, the quest
# accepted (a GM), and five Warriors by the qm (fay at level 40, the rest 30). A party of 2: nil (the base: 14); 5: nil;
# 6: 14, finished: Prog 1; bob walks 15.5 yalms east (15.53 from main): nil (the module's distance test); bob back: 14.
module modules/era/lua/quests/outlands/the_kuftal_tour.lua
lists KuftalTunnel/qm5/onTrigger KuftalTunnel/onEventFinish/14
char zone=KuftalTunnel pos=-27.695,-22.159,-183.716 job=WAR lvl=30
char bob zone=KuftalTunnel pos=-27.695,-22.159,-182.716 job=WAR lvl=30
char cid zone=KuftalTunnel pos=-27.695,-22.159,-184.716 job=WAR lvl=30
char dan zone=KuftalTunnel pos=-26.695,-22.159,-183.716 job=WAR lvl=30
char eve zone=KuftalTunnel pos=-28.695,-22.159,-183.716 job=WAR lvl=30
char fay zone=KuftalTunnel pos=-26.695,-22.159,-182.716 job=WAR lvl=40
setting RESTRICT_CONTENT 1
setting ENABLE_ROV 0
quest Outlands.TheKuftalTour accepted
login
bob: login
invite bob
bob: accept
trigger qm5                             # a party of 2: the module: nil (the base: 14)
cid: login
invite cid
cid: accept
dan: login
invite dan
dan: accept
eve: login
invite eve
eve: accept
trigger qm5                             # 5: nil
fay: login
invite fay
fay: accept
trigger qm5                             # 6, fay at 40: 14
finish                                  # Prog 1
bob: walk -12.195,-22.159,-182.716      # 15.5 yalms east (15.53 from main)
trigger qm5                             # bob beyond 15 yalms: nil
bob: walk -27.695,-22.159,-182.716      # back by the qm
trigger qm5                             # 14
finish
