# _6s1: no 6-1 reply (124), the zone-in: no event.
lists RuludeGardens/Pherimociel/onTrigger RuludeGardens/onZoneIn/1 UpperJeuno/_6s1/onTrigger
char zone=RuludeGardens pos=-31.6,2,66 job=WAR lvl=75 nation=0
mission Cop ForWhomTheVerseIsSung current
login                                   # Status 0: no zone-in event
warp -97,-1.7,90 UpperJeuno
