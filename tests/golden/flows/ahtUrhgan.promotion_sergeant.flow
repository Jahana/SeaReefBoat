carl: quest AhtUrhgan.PromotionSuperiorPrivate completed
carl: quest AhtUrhgan.PromotionLanceCorporal accepted
carl: charvar AssaultPromotion 25
login
bob: login
bob: trigger Naja_Salaheem              # AssaultPromotion 24: nothing
bob: finish-if-event
bob: logout
carl: login
carl: trigger Naja_Salaheem             # Corporal not completed: nothing
carl: finish-if-event
carl: logout
trigger Naja_Salaheem                   # available: 5055
finish option=1                         # not begun
trigger Naja_Salaheem                   # 5055
finish option=0                         # begun
trigger Naja_Salaheem                   # Prog 0: 5058 (once per zone)
finish
trigger Naja_Salaheem                   # Ignore: nothing
finish-if-event
warp -80,0,12 AhtUrhganWhitegate        # north of area 10
tick 1000
tick 1000
tick 1000
walk -80,0,0                            # area 10, Prog 0: 5056
finish option=1                         # nothing
walk -80,0,12
walk -80,0,0                            # 5056
finish option=0                         # Prog 1
trigger Naja_Salaheem                   # Prog 1, after the warps (zone-ins: the marks cleared): 5058
finish
trigger Naja_Salaheem                   # Prog 1 again: once per zone: nothing
finish-if-event
warp 10,0,-30 Nashmau                   # north of area 1
tick 1000
tick 1000
tick 1000
walk 10,0,-42                           # area 1, day > Stage 0: 303
finish option=3                         # not option 2: Stage = tomorrow
walk 10,0,-30
walk 10,0,-42                           # day < Stage: nil
wait vana=24                            # day = Stage
walk 10,0,-30
walk 10,0,-42                           # not day > Stage: nil
wait vana=24                            # day > Stage
walk 10,0,-30
walk 10,0,-42                           # 303
finish option=2                         # Prog 2
warp 24.2,-7.804,-45.591 AhtUrhganWhitegate
trigger Naja_Salaheem                   # Prog 2: 5058
finish
trigger Naja_Salaheem                   # once per zone: nothing
finish-if-event
warp 10,0,-30 Nashmau
