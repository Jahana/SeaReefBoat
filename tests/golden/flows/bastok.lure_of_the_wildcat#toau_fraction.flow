# Lure of the Wildcat (Bastok) (bastok 84): the guard xi.settings.main.ENABLE_TOAU == 1 compares the setting as the Lua
# number it is, so a fraction (1.25) is not 1: not offered, Alib-Mufalib's own script (361). A port that rounds the
# setting (Settings.Main) would offer it. Recorded on Lua at 93992a4c^ (the parent of the commit that deleted the Lua).
lists PortBastok/Alib-Mufalib/onTrigger PortBastok/onEventFinish/357
char zone=PortBastok pos=116.1,7.4,-31.8 job=WAR lvl=20
setting ENABLE_TOAU 1.25
login
trigger Alib-Mufalib           # ENABLE_TOAU 1.25: not offered, 361
finish
