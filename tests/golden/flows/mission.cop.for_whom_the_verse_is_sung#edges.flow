finish-if-event
charvar Mission[6][578]Status 1         # a GM
warp -31.6,2,66 RuludeGardens           # Status 1: no zone-in event
charvar Mission[6][578]Status 3         # a GM: past the last Status
trigger Pherimociel                     # Status 3: no 6-1 reply (155)
finish-if-event
warp -97,-1.7,90 UpperJeuno
trigger _6s1                            # Status 3: no 6-1 reply (124)
finish-if-event
warp -31.6,2,66 RuludeGardens           # Status 3: no zone-in event
