charvar Quest[7][69]Prog 1              # a GM, while available
trigger Mainchelite                     # 171 and 14 tie (Progress): 171, the first container
finish option=1                         # Carnelian begun
trigger Mainchelite                     # Option 0: 14 (Progress) over 173 (an Event)
finish option=0                         # nothing
warp 314.321,-30.495,-67.15 EastRonfaureS open # from Southern San d'Oria [S], Prog 1: 12, left open
finish                                  # Prog 2
trigger qm3                             # 13 and 1 tie (Progress): 13, the first container
finish                                  # bit 0
trigger qm3                             # bit 0 set: 1 (Progress) over 4 (an Event)
finish                                  # the Charred Propeller
trigger qm4                             # 14 and 2 tie: 14
finish                                  # bit 1
trigger qm4                             # bit 1 set: 2 over 5
finish                                  # the Piece of Shattered Lumber
trigger qm5                             # 15 and 3 tie: 15
finish                                  # bit 2 (Option 7)
trigger qm5                             # bit 2 set: 3 over 6
finish                                  # the Oxidized Plate
warp -13.849,1.398,-30.368 SouthernSanDoriaS # accepted: no zone-in reply
trigger Mainchelite                     # Option 7, the three held: 172 and 624 tie: 172 (the cycle at 171)
finish                                  # Carnelian completed (Large Memory Fragment 4); checkMemoryFragments: nothing
trigger Mainchelite                     # Carnelian completed: 624 alone
finish                                  # Steamed Rams completed; the evidence taken
