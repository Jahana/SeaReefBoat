# Carbuncle Debacle (windurst 83): the arms against a completed quest (GM), an SMN 75 with The Puppet Master and
# Class Reunion completed. Koru-Moru at vars 1, 4, 5 and 7: 420 each time, none of the accepted arms.
# Ripapa at vars 2 and 3 (no pendulum): his 10020 (Trial by Lightning: Windurst fame 0).
# Agado-Pugado at var 5 with the Daze Breaker Charm and at var 6 (no pendulum): his 70
# (Trial by Wind: Selbina-Rabao fame 0).
char zone=WindurstWalls pos=-120.2,-5.5,122.4 job=SMN lvl=75
quest Windurst.ThePuppetMaster completed
quest Windurst.ClassReunion completed
quest Windurst.CarbuncleDebacle completed
login
charvar CarbuncleDebacleProgress 1
trigger Koru-Moru                       # the default's turn: 193
finish
trigger Koru-Moru                       # completed, var 1: no 416: 420
finish
charvar CarbuncleDebacleProgress 4
trigger Koru-Moru                       # the default's turn: 193
finish
trigger Koru-Moru                       # completed, var 4: no 417: 420
finish
charvar CarbuncleDebacleProgress 5
trigger Koru-Moru                       # the default's turn: 193
finish
trigger Koru-Moru                       # completed, var 5: no 418: 420
finish
charvar CarbuncleDebacleProgress 7
trigger Koru-Moru                       # the default's turn: 193
finish
trigger Koru-Moru                       # completed, var 7: no 419: 420
finish
charvar CarbuncleDebacleProgress 2
warp 31.1,-15.7,55.4 Mhaura
trigger Ripapa                          # completed, var 2: no 10022: 10020
finish
charvar CarbuncleDebacleProgress 3
trigger Ripapa                          # completed, var 3, no pendulum: no 10023: 10020
finish
charvar CarbuncleDebacleProgress 5
keyitem DazeBreakerCharm
warp -16.5,7.8,-10.5 Rabao
trigger Agado-Pugado                    # completed, var 5, the charm: no 86: 70
finish
charvar CarbuncleDebacleProgress 6
trigger Agado-Pugado                    # completed, var 6, no pendulum: no 87: 70
finish
