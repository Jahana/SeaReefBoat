# A New Dawn (jeuno 62): a BST 50 (the level's lower bound; `#level49` takes the other side) with Scattered into Shadow
# and the BST chain completed (GM). Available with the var 6 (GM): nothing. The var 0: 5, option 1: the var 1, then
# begun and the var 2; accepted, 2: the door's 2.
char zone=LowerJeuno pos=-80.7,-7.65,-168.8 job=BST lvl=50
quest Jeuno.ScatteredIntoShadow completed
quest Jeuno.ChocobosWounds completed
quest Jeuno.SaveMySon completed
quest Jeuno.PathOfTheBeastmaster completed
charvar ANewDawn_Event 6
login
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # available, BST 50, the var 6: nothing (132 again)
finish
charvar ANewDawn_Event 0
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # available, BST 50, the var 0: 5
finish option=1                         # the var 1; begun; the var 2
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # accepted, the var 2: 2
finish
