# Drachenfall accepted with neither canteen (a GM status): Black Mud's 102 gives a new Brass Canteen; with it held, his
# trigger is nil again.
lists BastokMines/Black_Mud/onTrigger BastokMines/onEventFinish/102
char zone=BastokMines pos=60,7,0.5
fame Bastok 50
quest Bastok.Drachenfall accepted
login
trigger Black_Mud                    # neither canteen: 102
finish                               # Brass Canteen given
trigger Black_Mud                    # the canteen held: nil, 100
finish-if-event
