# Waking the Beast (battlefield.waking_the_beast_cloister_of_frost, CloisterOfFrost): the exit. The char enters arena 1, then Ice_Protocrystal (arena 1's), in the battlefield:
# 32003 (an optional cutscene, skippable); its update: nothing; finished with 0: not 4: still inside. Again, finished with
# 4: leaveBattlefield(1) (no win, no loss event).
lists CloisterOfFrost/IP_Entrance/onTrigger CloisterOfFrost/Ice_Protocrystal/onTrigger CloisterOfFrost/onEventUpdate/32003 CloisterOfFrost/onEventFinish/32003
char zone=CloisterOfFrost pos=561.5,-0.8,600.0 job=WAR lvl=75
quest OtherAreas.WakingTheBeast accepted
keyitem RainbowResonator
login
trigger IP_Entrance                     # the resonator: the menu 32000
update 32000 option=49                  # area 1: registered, entered
finish                                  # in the arena
trigger Ice_Protocrystal                  # in the battlefield: 32003
update 32003 option=1                   # onExitEventUpdate: nothing
finish option=0                         # not 4: still inside
trigger Ice_Protocrystal                  # 32003
finish option=4                         # leaveBattlefield(1): out
