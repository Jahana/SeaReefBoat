# Mog House Exposition, section 1 in the San d'Oria Mog Houses: a char of nation 0 (a GM's notSeen 1 before each
# entry: charCreate writes it): in the home nation's Mog House the zone-in 30000 (the zoneline finishes it with 0):
# quest:complete (the vars cleared), oNation 1. `zoneline <Zone>` is the zone's line to its own Mog House.
lists SouthernSanDoria/onZoneIn/1 SouthernSanDoria/onEventFinish/30000 NorthernSanDoria/onZoneIn/1 NorthernSanDoria/onEventFinish/30000 PortSanDoria/onZoneIn/1 PortSanDoria/onEventFinish/30000
char zone=SouthernSanDoria pos=123.7,0,92.1 job=WAR lvl=1 nation=0
login
warp 123.7,0,92.1 SouthernSanDoria
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline SouthernSanDoria        # the home Mog House: 30000 (finished with 0): complete; oNation 1
warp 128.3,-6.5,97.2 NorthernSanDoria
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline NorthernSanDoria        # the home Mog House: 30000 (finished with 0): complete; oNation 1
warp -17.65,-8,-129.728 PortSanDoria
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline PortSanDoria            # the home Mog House: 30000 (finished with 0): complete; oNation 1
