# Enter the Talekeeper (Bastok 8-2, mission.bastok.enter_the_talekeeper) through the Metalworks's Malduc's 1001: a
# level 75 Warrior at rank 8 with the ASA, ACP, RoV and SoA logs current (their zone-ins quiet) and the nation's
# missions before it completed. Section 1 (no mission current, a char of the nation; no rank and no completed test,
# kept): the gate guard's own mission list, option 24 (no mission's) begins nothing, option 21 begins the mission with
# the zone's YOU_ACCEPT_THE_MISSION; then, current, the mission's EXTENDED_MISSION_OFFSET + 12.
char zone=Metalworks pos=66,-15,6 job=WAR lvl=75 nation=1
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Bastok TheZeruhnReport completed
mission Bastok GeologicalSurvey completed
mission Bastok Fetichism completed
mission Bastok TheCrystalLine completed
mission Bastok WadingBeasts completed
mission Bastok TheEmissary completed
mission Bastok TheFourMusketeers completed
mission Bastok ToTheForsakenMines completed
mission Bastok Jeuno completed
mission Bastok Magicite completed
mission Bastok DarknessRising completed
mission Bastok XarcabardLandOfTruths completed
mission Bastok ReturnOfTheTalekeeper completed
mission Bastok ThePiratesCove completed
mission Bastok TheFinalImage completed
mission Bastok OnMyWay completed
mission Bastok TheChainsThatBindUs completed
rank 8
login
trigger Malduc                          # no mission current: the guard's own 1001 (the mission list)
finish option=24                        # no mission's option (this mission takes 21): not begun
trigger Malduc                          # 1001 again
finish option=21                        # begun, YOU_ACCEPT_THE_MISSION
trigger Malduc                          # current: the mission's EXTENDED_MISSION_OFFSET + 12
finish-if-event
