# The Secrets of Worship (CoP 4-3) completed, Slanderous Utterings current (a GM): the Wooden Gate east of x 45 without
# the key (CANNOT_BE_OPENED, the default), with it (a GM; cutscene 110 of 4-3's not-current section, which returns no
# reply, so the default CANNOT_BE_OPENED follows in the same step) and west of it (CANNOT_OPEN_SIDE).
lists Sacrarium/_0s8/onTrigger
char zone=Sacrarium pos=47,-1.5,10 job=WAR lvl=75 nation=0
mission Cop SlanderousUtterings current
login
trigger _0s8                            # east, no key
finish-if-event
keyitem ReliquiariumKey                 # a GM
trigger _0s8                            # east, with the key: 110, then 7236
finish-if-event
warp 41,-1.5,10 Sacrarium
trigger _0s8 here                       # west: CANNOT_OPEN_SIDE
finish-if-event
