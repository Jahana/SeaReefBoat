# The Talekeeper's Truth (bastok 55): a WAR 50 without The Doorman completed is not offered it; Phara offers The Doorman
# (151) instead, and Deidogg gives his default.
char zone=BastokMines pos=75,0,-80 job=WAR lvl=50
login
trigger Phara                   # The Doorman available: its 151
finish                          # The Doorman accepted (its 151 begins it whatever the option)
trigger Deidogg                 # 32
finish
