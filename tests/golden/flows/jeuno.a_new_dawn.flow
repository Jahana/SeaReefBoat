# A New Dawn (jeuno 62, BST AF3; call-only): the door _6t2 (Lower Jeuno), Osker (Upper Jeuno), the Sarcophagus and Sturm
# (The Eldieme Necropolis). A BST 75 with Scattered into Shadow, Chocobo's Wounds, Save My Son and Path of the Beastmaster
# completed (GM, as a real BST has them).
# Turns: _6t2 (default 64; Save My Son completed: its 132, replaceDefault) and Osker (default 50; Path of the Beastmaster
# completed: its 45, replaceDefault) take turns with their scripts: each script talk follows a turn talk. The Sarcophagus
# has no default.
# Available, the var 2 (GM): nothing. The var 0: 5, option 0: the var 1; again (GM var 0) option 2: the var 1, not begun;
# 4 option 0 and option 2: nothing; option 1: begun, the var 2. Accepted, 2: the door's 2; Osker 146 (his script's
# finish: the var 3); 146 again at 3; the door at 3: nothing. Osker's trade (the lumber, his script: the Tamer's Whistle,
# the var 4); 147, and 147 at the var 5 (GM); the door: 3, and 3 at the var 5 (GM). The Sarcophagus: the second one at 4:
# its message; the first at 4: the three NMs popped (nothing shown); again: popFromQM refuses (spawned), nothing. Sturm
# killed: the var 5 (Taifun and Trombe despawned by its script). The second one at 5: its message. 45 refused on a full
# inventory (completeQuest false: nothing), then the Beast Trousers, the title, completed, the var 6, the whistle taken.
# Completed: the Sarcophagus's message; Osker 145 at the var 6; the door's 0 (the var 0), then nothing at 0 and at 1 (GM);
# Osker 145 at 0.
char zone=LowerJeuno pos=-80.7,-7.65,-168.8 job=BST lvl=75
quest Jeuno.ScatteredIntoShadow completed
quest Jeuno.ChocobosWounds completed
quest Jeuno.SaveMySon completed
quest Jeuno.PathOfTheBeastmaster completed
charvar ANewDawn_Event 2
item PieceOfMahoganyLumber
login
trigger _6t2                            # the turn: Save My Son's 132
finish
trigger _6t2                            # the script: available, BST 75, the var 2: nothing (132 again)
finish
charvar ANewDawn_Event 0
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # available, BST 75, the var 0: 5
finish option=0                         # the var 1
charvar ANewDawn_Event 0
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # the var 0: 5
finish option=2                         # the var 1, not begun
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # the var 1: 4
finish option=0                         # nothing
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # 4
finish option=2                         # nothing
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # 4
finish option=1                         # begun; the var 2
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # accepted, the var 2: 2
finish
warp -59.9,8.2,94.2 UpperJeuno          # beside Osker
trigger Osker                           # the turn: Path of the Beastmaster's 45
finish
trigger Osker                           # accepted, the var 2: 146
finish                                  # his script's finish: the var 3
trigger Osker                           # the turn: 45
finish
trigger Osker                           # the var 3: 146
finish                                  # the var stays 3
warp -80.7,-7.65,-168.8 LowerJeuno
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # accepted, the var 3: nothing (132 again)
finish
warp -59.9,8.2,94.2 UpperJeuno
trade Osker PieceOfMahoganyLumber x1    # the var 3 (his script): the lumber taken, 148
finish                                  # the Tamer's Whistle; the var 4
trigger Osker                           # the turn: 45
finish
trigger Osker                           # the var 4: 147
finish
charvar ANewDawn_Event 5
trigger Osker                           # the turn: 45
finish
trigger Osker                           # the var 5: 147
finish
charvar ANewDawn_Event 4
warp -80.7,-7.65,-168.8 LowerJeuno
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # the var 4: 3
finish
charvar ANewDawn_Event 5
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # the var 5: 3
finish
charvar ANewDawn_Event 4
warp -410.4,6.5,503.0 TheEldiemeNecropolis  # beside the first Sarcophagus
trigger Sarcophagus+1                   # accepted, the var 4, not the first one: SARCOPHAGUS_CANNOT_BE_OPENED
trigger Sarcophagus                     # the first, the var 4: Sturm, Taifun, Trombe popped (claim false); no event
tick 400                                # a zone tick (the NMs' spawn packets reach the char with the next step)
trigger Sarcophagus                     # spawned: popFromQM false: nothing
kill STURM                              # accepted, the var 4: the var 5; its script despawns Taifun and Trombe
tick 4000
trigger Sarcophagus+1                   # the var 5, not the first one: SARCOPHAGUS_CANNOT_BE_OPENED
fill-inventory
trigger Sarcophagus                     # the var 5: 45
finish                                  # no free slot: npcUtil.completeQuest false: nothing
free-inventory
trigger Sarcophagus                     # 45
finish                                  # Beast Trousers; Paragon of Beastmaster Excellence; completed; the var 6; the whistle taken
trigger Sarcophagus                     # completed: SARCOPHAGUS_CANNOT_BE_OPENED
warp -59.9,8.2,94.2 UpperJeuno
trigger Osker                           # the turn: 45
finish
trigger Osker                           # completed, the var 6: 145
finish
warp -80.7,-7.65,-168.8 LowerJeuno
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # completed, the var 6: 0
finish                                  # the var 0
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # completed, the var 0: nothing (132 again)
finish
charvar ANewDawn_Event 1
trigger _6t2                            # the turn: 132
finish
trigger _6t2                            # completed, the var 1: nothing (132 again)
finish
charvar ANewDawn_Event 0
warp -59.9,8.2,94.2 UpperJeuno
trigger Osker                           # the turn: 45
finish
trigger Osker                           # completed, the var 0: 145
finish
