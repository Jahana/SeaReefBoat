trigger Gulldago                        # 699
finish                                  # 6 Meat Jerky; Prog 3
trigger Gulldago                        # no food: 700
finish
effect 251                              # a GM: food
trigger Gulldago                        # 701
finish                                  # Prog 4
trigger Gulldago                        # no combat skill at 5: 702
finish
skill Sword 40                          # a GM: Sword 4, under 5
trigger Gulldago                        # still no combat skill at 5: 702
finish
skill Sword 50                          # a GM: Sword 5
trigger Gulldago                        # 703
finish                                  # 100 x GIL_RATE gil; Prog 5
trigger Gulldago                        # no Memorandoll: 704
finish
keyitem Memorandoll
fill-inventory
trigger Gulldago                        # 705
finish                                  # no room: giveItem fails; Prog stays 5
free-inventory
trigger Gulldago                        # 705
finish                                  # Lizard Tail, Pot of Honey, Fire Crystal; Prog 6
trigger Gulldago                        # Option 0: 706
finish
charvar HQuest[Tutorial]Option 2       # a GM: not 1: 706
trigger Gulldago
finish
trigger Auction_Counter                 # Option 1; the auction menu; noAction
trigger Gulldago                        # 707
finish                                  # the Conquest Promotion Voucher; Prog 7; Option 0
trigger Gulldago                        # level 1: 708
finish
charvar HQuest[Tutorial]Prog 8          # a GM (the level 5 arm: #later)
trigger Gulldago                        # no permit: 710
finish
keyitem BastokTrustPermit
fill-inventory
trigger Gulldago                        # 711
finish                                  # no room: the Warp Ring fails; Prog stays 8
free-inventory
trigger Gulldago                        # 711
finish                                  # the Warp Ring; Prog 9
trigger Gulldago                        # TutorialBypass 0: 712 (1)
finish
warp 20,0,-113 BastokMines
trigger Survival_Guide                  # 0: TutorialBypass 1; message 16066; the guide's 8500
finish-if-event
trigger Survival_Guide                  # 1 is not 0: the guide's 8500 only
finish-if-event
warp -362,-10,-167 BastokMarkets
trigger Gulldago                        # TutorialBypass 1: 712 (1)
finish
warp -582.7,40.1,54 NorthGustaberg
trigger Survival_Guide                  # 1: TutorialBypass 2; message 12493; 8500 (param 20)
finish-if-event
warp -362,-10,-167 BastokMarkets
fill-inventory
trigger Gulldago                        # TutorialBypass 2: 713 (1)
finish                                  # no room: no Saltena; Prog stays 9
charvar TutorialBypass 3                # a GM: over 2
trigger Gulldago                        # TutorialBypass 3: 713 (1)
finish                                  # no room
free-inventory
trigger Gulldago                        # 713 (1)
finish                                  # 12 Saltena; Prog 10; TutorialBypass 0
trigger Gulldago                        # level 1: 714
finish
