# Testing the Waters (ToAU 34): Naja Salaheem first (3132). Then with the Ephramadian Gold Coin and the must-zone
# var set, after zone ticks and a walk out of the area, Arrapago Reef's area 1 plays nothing (the area handler runs
# and answers nil).
lists AhtUrhganWhitegate/Naja_Salaheem/onTrigger ArrapagoReef/onTriggerAreaEnter/1 ArrapagoReef/onEventFinish/15 TalaccaCove/onZoneIn/1 TalaccaCove/onEventFinish/106
char zone=AhtUrhganWhitegate pos=40,-6,-30 job=WAR lvl=75 nation=1
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Toau TestingTheWaters current
keyitem EphramadianGoldCoin
login
tick 1000
tick 1000
tick 1000
trigger Naja_Salaheem                   # 3132
finish-if-event
warp -463.026,-2,-394.478 ArrapagoReef
charvar Mission[4][33]mustZone 1
tick 1000
tick 1000
tick 1000
walk -463.026,-2,-394.478
walk -458,-2,-400                       # must zone alone: nothing
