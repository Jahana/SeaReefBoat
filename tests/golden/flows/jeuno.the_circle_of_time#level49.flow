# The Circle of Time (jeuno 65), a level 49 bard at Prog 1: Imasuke's level check returns nil (default 12); and Imasuke
# at Prog 0 for a level 50 bard is #prog0.
lists PortJeuno/Imasuke/onTrigger
char zone=PortJeuno pos=-165,11,94.5 job=BRD lvl=49
quest Jeuno.TheOldMonument completed
quest Jeuno.AMinstrelInDespair completed
quest Jeuno.PathOfTheBard completed
quest Jeuno.PainfulMemory completed
quest Jeuno.TheRequiem completed
charvar Quest[3][65]Prog 1
login
trigger Imasuke                             # below AF3_QUEST_LEVEL: nil; default 12
finish
