# Lure of the Wildcat (Jeuno) (jeuno 90): ENABLE_TOAU 0: not offered; Ajithaam's script starts nothing without the
# ToAU mission, so his default 10092 plays.
lists UpperJeuno/Ajithaam/onTrigger
char zone=UpperJeuno pos=-79.7,0,161.5 job=WAR lvl=20
setting ENABLE_TOAU 0
login
trigger Ajithaam               # ENABLE_TOAU 0: not offered; his script: nothing; his default 10092
finish
