# A Moral Manifest (otherAreas 108): the offer at level 60 (the threshold) declined on zone-in, moraldecline set until the
# next conquest tally, no offer while it holds, the offer again after the tally, accepted.
char zone=WindurstWoods pos=-38.243,-2.25,-120.954 lvl=60
login
warp -313,24.77,12 AltarRoom option=1   # 46 declined: moraldecline 1, expiring at the next tally
rezone                          # declined: nothing
wait jst=8                      # past the tally
rezone                          # 46 again, accepted (option 0): moral 1
