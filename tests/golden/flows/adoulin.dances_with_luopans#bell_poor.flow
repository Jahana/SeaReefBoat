# Dances with Luopans (adoulin 118), the Matre Bell unaffordable: a level 99 Geomancer in Western Adoulin, the quest
# completed (a GM), no Matre Bell, 299999 gil, 149999 bayld (a GM). Sylvie: 37; update 0: not 1 or 2: nothing (no
# updateEvent); update 1 (299999 gil): param 0; update 2 (149999 bayld): param 0; finished on 1: no payment: nothing.
lists WesternAdoulin/Sylvie/onTrigger WesternAdoulin/onEventUpdate/37 WesternAdoulin/onEventFinish/37
char zone=WesternAdoulin pos=79.594,32,135.725 job=GEO lvl=99 gil=299999
quest Adoulin.DancesWithLuopans completed
login
currency bayld 149999                   # a GM
trigger Sylvie                          # completed, a Geomancer, no bell: 37
update 37 option=0                      # not 1 or 2: return
update 37 option=1                      # 299999 gil: param 0
update 37 option=2                      # 149999 bayld: param 0
finish option=1                         # no payment chosen: nothing
