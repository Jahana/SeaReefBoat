# Introduction to Teamwork (sandoria 63) with its era module (quest rework B3b, Task 9): six Bastok chars (nation 1),
# main one of them. The module (xi.pre(xi.expansion.ROV): RESTRICT_CONTENT 1, ENABLE_ROV 0) counts the members of the
# nation of the char who talks, not of nation 0: six of nation 1, the local Prog 1, updateEvent(15, 1); finish option 1:
# nothing.
module modules/era/lua/quests/sandoria/introduction_to_teamwork.lua
lists WestRonfaure/Vilatroire/onTrigger WestRonfaure/onEventUpdate/129 WestRonfaure/onEventFinish/129
char zone=WestRonfaure pos=-258.861,-70.999,423.42 job=WAR lvl=10 nation=1
char bob zone=WestRonfaure pos=-258.861,-70.999,428 job=WAR lvl=10 nation=1
char carl zone=WestRonfaure pos=-256,-70.999,426 job=WAR lvl=10 nation=1
char dave zone=WestRonfaure pos=-256,-70.999,421 job=WAR lvl=10 nation=1
char eve zone=WestRonfaure pos=-261.5,-70.999,426 job=WAR lvl=10 nation=1
char fay zone=WestRonfaure pos=-261.5,-70.999,421 job=WAR lvl=10 nation=1
setting RESTRICT_CONTENT 1
setting ENABLE_ROV 0
quest Sandoria.IntroductionToTeamwork accepted
login
bob: login
carl: login
dave: login
eve: login
fay: login
invite bob
bob: accept
invite carl
carl: accept
invite dave
dave: accept
invite eve
eve: accept
invite fay
fay: accept                               # six Bastok
trigger Vilatroire                        # 129 { [1] = 1 }
update 129 option=0                       # six of main's nation (nation 1): the local Prog 1, updateEvent(15, 1)
finish option=1                           # option 1: nothing
