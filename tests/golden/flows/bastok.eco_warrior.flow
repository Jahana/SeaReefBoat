# Eco-Warrior (Bastok) (bastok 65): Raifa in Port Bastok, Degga, the qm5 and the two Puddings in Gusgen Mines. Raifa's
# offer 278 (Bastok fame level 1, EcoReset 0; 283 while the San d'Oria or the Windurst Eco-Warrior is accepted, each on
# its own; option 1 begins it; a trade while available: no handler), Degga's 13 (option 1: Level Restriction 25,
# ON_ZONE), the qm5 under the restriction at Prog 0 (the two Puddings popped, claimed, OINTMENT_DRAWS_MONSTERS; while
# they are up popFromQM refuses), the Puddings killed without the restriction (nothing), the death of the first Pudding
# under it (the other alive: nothing) and of the last (Prog 1), the qm5's KI Indigested Ore, Degga's 16 (option 0:
# Informed 1) and 15 (option 0: the restriction off), Raifa's 280 without the ore and 282 with it (completed: Dragon
# Chronicles, 5000 gil, Cerulean Soldier, fame +20, the ore deleted, EcoReset 1 until the next conquest tally); once
# completed: 283 for either other nation's, nil while EcoReset is 1, and 278 (option 1 deletes the quest and begins it
# again).
# The restriction is ON_ZONE: a warp, even inside Gusgen Mines, zones the char and drops it, so the flow moves between
# Degga and the qm5 by `trigger` (which walks) and uses `rezone` only to drop it on purpose. Dead Puddings despawn
# between 15 and 45 s after the kill (two ticks).
# Defaults: Raifa 279, Degga 12, the qm5 NOTHING_OUT_OF_ORDINARY (DefaultActions; no scripts; no other quest or mission
# names them). The San d'Oria and Windurst Eco-Warriors (both C#) read this quest's status. The era
# module is #era.
lists PortBastok/Raifa/onTrigger PortBastok/onEventFinish/278 PortBastok/onEventFinish/282 GusgenMines/Degga/onTrigger GusgenMines/qm5/onTrigger GusgenMines/Pudding/onMobDeath GusgenMines/onEventFinish/13 GusgenMines/onEventFinish/15 GusgenMines/onEventFinish/16
char zone=PortBastok pos=-166.4,-7.5,8.6 lvl=30
charvar EcoReset 1
item BoneChip
login
trigger Raifa                        # available, EcoReset 1: nil, 279
finish-if-event
trade Raifa BoneChip x1              # available: no trade handler either way, nothing
charvar EcoReset 0
quest Sandoria.EcoWarrior accepted
trigger Raifa                        # the San d'Oria Eco-Warrior accepted: 283
finish
quest Sandoria.EcoWarrior available
quest Windurst.EcoWarrior accepted
trigger Raifa                        # the Windurst Eco-Warrior accepted: 283
finish
quest Windurst.EcoWarrior available
trigger Raifa                        # the offer, 278
finish option=0                      # declined: still available
trigger Raifa                        # 278 again
finish option=1                      # accepted
trigger Raifa                        # accepted, no ore: 280
finish
warp 40.2,-68.1,-256.3 GusgenMines
trigger Degga                        # no ore, no restriction: 13
finish option=0                      # no ointment
trigger Degga                        # 13 again
finish option=1                      # Level Restriction 25 (ON_ZONE)
trigger Degga                        # no ore, the restriction: 15
finish option=1                      # kept
trigger qm5                          # walks; Prog 0, the restriction: the Puddings popped, OINTMENT_DRAWS_MONSTERS
finish-if-event
trigger qm5                          # the Puddings up: popFromQM false, Prog 0: nil, NOTHING_OUT_OF_ORDINARY
finish-if-event
rezone                               # ON_ZONE: the restriction gone (the Puddings stay up)
kill PUDDING_OFFSET                  # no restriction: the death handler returns at once
kill PUDDING_OFFSET+1                # no restriction: nothing, Prog 0
tick 15000                           # the dead Puddings despawning (the death and the despawn each take a zone tick)
tick 30000                           # despawned: popFromQM refuses a spawned mob
trigger qm5                          # Prog 0, no restriction: nil, NOTHING_OUT_OF_ORDINARY
finish-if-event
trigger Degga                        # no ore, no restriction: 13
finish option=1                      # the restriction again
trigger qm5                          # the Puddings popped again
finish-if-event
kill PUDDING_OFFSET                  # the restriction, the other Pudding alive: returns, Prog 0
kill PUDDING_OFFSET+1                # the last Pudding: Prog 1
trigger qm5                          # Prog 1, no ore: KI Indigested Ore
finish-if-event
trigger qm5                          # the ore held: nil, NOTHING_OUT_OF_ORDINARY
finish-if-event
trigger Degga                        # the ore, Informed 0: 16
finish option=1                      # Informed stays 0
trigger Degga                        # 16 again
finish                               # option 0: Informed 1
trigger Degga                        # the ore, Informed 1, the restriction: 15
finish                               # option 0: the restriction off
trigger Degga                        # the ore, Informed 1, no restriction: nil, 12
finish-if-event
warp -166.4,-7.5,8.6 PortBastok
trigger Raifa                        # the ore: 282
finish                               # completed: Dragon Chronicles, 5000 gil, Cerulean Soldier, fame +20, EcoReset 1
trigger Raifa                        # completed, EcoReset 1: nil, 279
finish-if-event
charvar EcoReset 0
quest Sandoria.EcoWarrior accepted
trigger Raifa                        # completed, the San d'Oria one accepted: 283
finish
quest Sandoria.EcoWarrior available
quest Windurst.EcoWarrior accepted
trigger Raifa                        # completed, the Windurst one accepted: 283
finish
quest Windurst.EcoWarrior available
trigger Raifa                        # completed, EcoReset 0: 278
finish option=0                      # nothing
trigger Raifa                        # 278 again
finish option=1                      # the quest deleted and begun again: accepted, Prog 0
