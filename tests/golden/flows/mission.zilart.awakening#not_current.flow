# Awakening not current (The Chamber of Oracles current): the zone-in to Norg and Gilgamesh play nothing, and _6tc is
# the NPC's own ITS_LOCKED.
lists Norg/onZoneIn/1 Norg/onEventFinish/176 Norg/Gilgamesh/onTrigger Norg/onEventFinish/232 Norg/onEventFinish/234 LowerJeuno/_6tc/onTrigger LowerJeuno/onEventFinish/20
char zone=LowerJeuno pos=36,0,-15 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart TheChamberOfOracles current
login
warp 98,-7,-12 Norg open                    # nothing
trigger Gilgamesh                       # nothing
finish-if-event
warp 36,0,-15 LowerJeuno
trigger _6tc                            # the NPC's own ITS_LOCKED
finish-if-event
