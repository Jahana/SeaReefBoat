# Ark Angels 1: the entry requirements. At Zilart status 0 or 2, with the Shard of Apathy held (entryRequirement), or
# with Ark Angels not current, qm1_1 opens no menu (LaLoff has no NO_BATTLEFIELD_qm1_1 text); at status 1 without the
# shard it opens.
warning: lua: addMission: overwriting current mission 26 of log 3 with 27 -- the GM's mission line: The Sealed Shrine over Ark Angels (not current)
lists LaloffAmphitheater/qm1_1/onTrigger LaloffAmphitheater/onEventUpdate/32000 LaloffAmphitheater/onEventFinish/32000 LaloffAmphitheater/onEventFinish/32001 LaloffAmphitheater/onEventFinish/32002 LaloffAmphitheater/qm2/onTrigger LaloffAmphitheater/onEventFinish/32003
char zone=LaloffAmphitheater pos=-603.563,-22.681,483.937 job=WAR lvl=99 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart ArkAngels current
login
trigger qm1_1                           # status 0: no menu
missionstatus Zilart 2                  # a GM
trigger qm1_1                           # status 2: no menu
missionstatus Zilart 1                  # a GM
keyitem ShardOfApathy                  # a GM
trigger qm1_1                           # the shard held: no menu
delkeyitem ShardOfApathy               # a GM
trigger qm1_1                           # the menu
finish
mission Zilart TheSealedShrine current  # a GM
trigger qm1_1                           # not current: no menu
