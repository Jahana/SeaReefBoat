# Immortal Sentries in Bhaflau Thickets: Daswil with the package 5 (option 0: nothing; option 1: handed over, the
# messages), then without it 6.
lists BhaflauThickets/Daswil/onTrigger BhaflauThickets/onEventFinish/5
char zone=BhaflauThickets pos=-200,-12,-770 job=WAR lvl=75 nation=1
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Toau ImmortalSentries current
keyitem SuppliesPackage
login
trigger Daswil                          # the package: 5
finish option=0                         # nothing
trigger Daswil
finish option=1                         # handed over
trigger Daswil                          # no package: 6
finish
