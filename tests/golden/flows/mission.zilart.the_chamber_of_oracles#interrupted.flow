# The Chamber of Oracles: status 255 set by a GM (a 1 interrupted). The Ice pedestal plays 1 at once, with
# no message; its finish takes the eight fragments and completes the mission (the Prismatic Fragment,
# KEYITEM_OBTAINED 6398; the Lightweaver title; Return to Delkfutt's Tower current).
lists ChamberOfOracles/Pedestal_of_Fire/onTrigger ChamberOfOracles/Pedestal_of_Darkness/onTrigger ChamberOfOracles/Pedestal_of_Earth/onTrigger ChamberOfOracles/Pedestal_of_Ice/onTrigger ChamberOfOracles/Pedestal_of_Light/onTrigger ChamberOfOracles/Pedestal_of_Lightning/onTrigger ChamberOfOracles/Pedestal_of_Water/onTrigger ChamberOfOracles/Pedestal_of_Wind/onTrigger ChamberOfOracles/onEventFinish/1
char zone=ChamberOfOracles pos=200.3419,-2.25,37.12 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart TheChamberOfOracles current
keyitem FireFragment
keyitem WaterFragment
keyitem EarthFragment
keyitem WindFragment
keyitem LightningFragment
keyitem IceFragment
keyitem LightFragment
keyitem DarkFragment
login
missionstatus Zilart 255                # a GM
trigger Pedestal_of_Ice                 # 255: 1
finish                                  # completed
