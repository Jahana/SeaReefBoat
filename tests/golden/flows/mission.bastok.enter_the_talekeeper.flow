mission Bastok XarcabardLandOfTruths completed
mission Bastok ReturnOfTheTalekeeper completed
mission Bastok ThePiratesCove completed
mission Bastok TheFinalImage completed
mission Bastok OnMyWay completed
mission Bastok TheChainsThatBindUs completed
rank 8
login
trigger Rashid                          # the guard's own 1001
finish option=21                        # section 1: begun, YOU_ACCEPT_THE_MISSION
trigger Rashid                          # current: EXTENDED_MISSION_OFFSET + 12
finish-if-event
warp -74,0.1,60 ZeruhnMines
trigger Drake_Fang                      # status 0: 202
finish                                  # status 1
trigger Drake_Fang                      # status 1: 203
finish
warp -27.695,-22.159,-183.716 KuftalTunnel
trigger qm6                             # status 1: nothing from the mission
finish-if-event
trigger qm5                             # status 1: 12
finish option=0                         # status 2, FELL
trigger qm5                             # status 2: nothing from the mission
finish-if-event
trigger qm6                             # status 2, no ghost: the three spawned, EVIL
effect 49                               # a GM: Perfect Dodge
effect 50                               # a GM: Invincible
effect 522                              # a GM: Elemental Sforzo
kill TALEKEEPER_OFFSET                  # two ghosts up: nothing
kill TALEKEEPER_OFFSET+1                # one up: nothing
kill TALEKEEPER_OFFSET+2                # none up: status 3
trigger qm6                             # status 3, no ghost up: 13
finish                                  # status 4, the Old Piece of Wood
warp -74,0.1,60 ZeruhnMines
trigger Drake_Fang                      # status 4: 204
finish                                  # status 5, setPos
tick 400
warp -8,-2,-121 BastokMines open        # from Zeruhn Mines at status 5: 176
finish                                  # completed: 80000 gil, rank 9; the wood taken
trigger Detzo                           # section 3: 184
finish
trigger Detzo                           # again
finish-if-event
trigger Gumbah                          # section 3: Blade of Darkness's 99 (progress) over the mission's 183
finish
trigger Pavvke                          # section 3: 76
finish
warp 92,-19.5,4 Metalworks
trigger Iron_Eater                      # section 3: 769
finish
