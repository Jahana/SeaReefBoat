# The Secrets of Worship (CoP 4-3) played through. A level 75 Warrior of San d'Oria with 4-3 current (a GM; Status 0):
# Tavnazian Safehold's _0qa plays 111 (finished: Status 1), Parelbriaux 137 (Status 1). Misareaux Coast's _0p8 (Status
# 1): cutscene 9, finished with option 0: nothing; again, finished with option 1: Status 2 and the char set down in the
# Sacrarium. The Wooden Gate east of x 45 (Status 2): cutscene 6 (finished: Status 3). A GM sets the qm qm_prof_1 as the
# professor's: its trigger pops Old Professor Mariselle (EVIL_PRESENCE), again: DRAWER_SHUT while she is spawned. Her
# death at Status 3 sets the local var that makes the qm hand over the Reliquarium Key (no event). The gate at Status 3
# with the key: cutscene 5; finished: the mission completes.
lists TavnazianSafehold/_0qa/onTrigger TavnazianSafehold/Parelbriaux/onTrigger TavnazianSafehold/onEventFinish/111 MisareauxCoast/_0p8/onTrigger MisareauxCoast/onEventFinish/9 Sacrarium/_0s8/onTrigger Sacrarium/qm_prof_1/onTrigger Sacrarium/Old_Professor_Mariselle/onMobDeath Sacrarium/onEventFinish/6 Sacrarium/onEventFinish/5
char zone=TavnazianSafehold pos=116,-42,41 job=WAR lvl=75 nation=0
mission Cop TheSecretsOfWorship current
login
trigger _0qa                            # Status 0: 111
finish                                  # Status 1
trigger Parelbriaux                     # Status 1: 137
finish-if-event
warp 57,-25.5,739 MisareauxCoast
trigger _0p8                            # Status 1: cutscene 9
finish option=0                         # not option 1
trigger _0p8                            # Status 1: cutscene 9 again
finish option=1                         # Status 2, set down in the Sacrarium
tick 10000                              # the zone change
warp -220.075,-15.999,79.634 Sacrarium
warp 47,-1.5,10 Sacrarium
trigger _0s8                            # east of x 45, Status 2: cutscene 6
finish                                  # Status 3
npclocalvar qm_prof_1 hasProfessorMariselle 1
warp 62.7,-3.1,125 Sacrarium
trigger qm_prof_1                       # Status 3, no key, her qm, she is not spawned: she pops
tick 2000
trigger qm_prof_1                       # she is spawned: DRAWER_SHUT
kill OLD_PROFESSOR_MARISELLE            # Status 3: hasKilledMariselle
trigger qm_prof_1                       # the key, no event
warp 47,-1.5,10 Sacrarium
trigger _0s8                            # Status 3 with the key: cutscene 5
finish                                  # complete
