# The Holy Crest (battlefield.holy_crest, Ghelsba Outpost): main has the quest accepted but no remedy, bob has the
# remedy but the quest only available: each gets the requirements message and a release, no menu. cat and dan are
# declared and never log in or trigger.
lists GhelsbaOutpost/Hut_Door/onTrigger
char zone=GhelsbaOutpost pos=-163.5,-11.7,77.8 job=DRG lvl=30
char bob zone=GhelsbaOutpost pos=-163.5,-11.7,77.8 job=DRG lvl=30
char cat zone=GhelsbaOutpost pos=-163.5,-11.7,77.8 job=DRG lvl=30
char dan zone=GhelsbaOutpost pos=-163.5,-11.7,77.8 job=DRG lvl=30
quest Sandoria.TheHolyCrest accepted
bob: keyitem DragonCurseRemedy
login
bob: login
trigger Hut_Door
bob: trigger Hut_Door
