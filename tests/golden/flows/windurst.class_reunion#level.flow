trigger _6n2                            # the default's turn: DOORS_SEALED_SHUT
trigger _6n2                            # 49 under 49.4: nothing (the default message again)
setting AF2_QUEST_LEVEL 49
trigger _6n2                            # the default's turn: DOORS_SEALED_SHUT
trigger _6n2                            # 49 at 49: 413
finish option=2                         # begun (any option); Carbuncle's Tear; var 1
