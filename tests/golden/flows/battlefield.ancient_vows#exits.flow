# Ancient Vows' exits (battlefield.ancient_vows#exits): the leave NPCs SD_BCNM_Exit_1 to 3, one per arena. A level 75
# Warrior of San d'Oria with Ancient Vows current at Status 2 (a GM), in from Riverne - Site #A01, enters arena 1, 2 and 3
# in turn and leaves each by its exit NPC: 32003, finished with 4: leaveBattlefield(1).
lists MonarchLinn/SD_Entrance/onTrigger MonarchLinn/onEventUpdate/32000 MonarchLinn/SD_BCNM_Exit_1/onTrigger MonarchLinn/SD_BCNM_Exit_2/onTrigger MonarchLinn/SD_BCNM_Exit_3/onTrigger MonarchLinn/onEventFinish/32000 MonarchLinn/onEventFinish/32003
char zone=RiverneSiteA01 pos=0,0,0 job=WAR lvl=75 nation=0
mission Cop AncientVows current
charvar Mission[6][248]Status 2
login
warp -39.1,-3.3,-537 MonarchLinn        # from A01
trigger SD_Entrance                     # the menu 32000
update 32000 option=1                   # arena 1: entered
finish                                  # in the arena
trigger SD_BCNM_Exit_1                  # arena 1's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 0,0,0 RiverneSiteA01
warp -39.1,-3.3,-537 MonarchLinn        # from A01
trigger SD_Entrance                     # the menu 32000
update 32000 option=2                   # arena 2: entered
finish                                  # in the arena
trigger SD_BCNM_Exit_2                  # arena 2's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 0,0,0 RiverneSiteA01
warp -39.1,-3.3,-537 MonarchLinn        # from A01
trigger SD_Entrance                     # the menu 32000
update 32000 option=3                   # arena 3: entered
finish                                  # in the arena
trigger SD_BCNM_Exit_3                  # arena 3's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 0,0,0 RiverneSiteA01
warp -39.1,-3.3,-537 MonarchLinn        # from A01
