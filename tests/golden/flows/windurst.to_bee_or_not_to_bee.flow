trigger Raamimi                         # completed, var 5: 80
finish                                  # no free slot: ITEM_CANNOT_BE_OBTAINED (4156); var kept
free-inventory
trigger Raamimi                         # 80
finish                                  # var 0; 3 Bottles of Mulsum (ITEMS_OBTAINED); needToZone
trigger Raamimi                         # completed, var 0, needToZone: 79
finish
