# Tutorial, San d'Oria, level 4: a level 4 Warrior (nation 0) at Alaune in Southern San d'Oria. Prog 7 (a GM): level 4
# is under 5: 3651; Prog 10 (a GM): level 4 is under 18: 3657 (0).
# Prog 4 (a GM), only Staff 50 (the last combat skill): 3646.
lists SouthernSanDoria/Alaune/onTrigger
char zone=SouthernSanDoria pos=-90.6,1,-57.5 job=WAR lvl=4 nation=0
charvar HQuest[Tutorial]Prog 7
login
trigger Alaune                          # level 4: 3651
finish
charvar HQuest[Tutorial]Prog 10         # a GM
trigger Alaune                          # level 4: 3657 (0)
finish
charvar HQuest[Tutorial]Prog 4         # a GM
skill Staff 50
trigger Alaune                          # Staff 5 is a learnt weaponskill: 3646
finish                                  # the gil; Prog 5
