# An Explorer's Footsteps (otherAreas 19): the eight [S] monuments (issue #10817): each credits its present-day
# monument's index and gil. The missions set as scripts/tests/quests/an_explorers_footsteps.lua does (no [S] zone-in
# cutscene: the trace shows none). Abelard 40, option 100: a clay, TargetMonument 0. Each [S] monument: the clay
# pressed: a tablet, TabletZoneId the [S] zone; Abelard: its bit clear, not the requested 0: 46, finished with option
# 100: the row's gil, a new clay, TargetMonument still 0 (bit 0 never set).
lists Selbina/Abelard/onTrade Selbina/onEventFinish/46 EastRonfaureS/Stone_Monument/onTrade JugnerForestS/Stone_Monument/onTrade BatalliaDownsS/Stone_Monument/onTrade PashhowMarshlandsS/Stone_Monument/onTrade RolanberryFieldsS/Stone_Monument/onTrade WestSarutabarutaS/Stone_Monument/onTrade MeriphataudMountainsS/Stone_Monument/onTrade SauromugueChampaignS/Stone_Monument/onTrade
char zone=Selbina pos=-50.6,-11.3,-13.1 job=WAR lvl=99
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
login
trigger Abelard                         # 40
finish option=100                       # the clay; TargetMonument 0; begun
warp 78.8,-2.9,-517.4 EastRonfaureS     # [S] monument 1
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId EastRonfaureS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 1, not requested 0: 46
finish option=100                       # the tablet taken; 800 gil; a clay; TargetMonument 0
warp -64.5,-23.8,-661.4 JugnerForestS   # [S] monument 4
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId JugnerForestS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 4, not requested 0: 46
finish option=100                       # the tablet taken; 1000 gil; a clay; TargetMonument 0
warp 187.2,9.0,-614.0 BatalliaDownsS    # [S] monument 5
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId BatalliaDownsS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 5, not requested 0: 46
finish option=100                       # the tablet taken; 10000 gil; a clay; TargetMonument 0
warp -299.2,21.6,304.2 PashhowMarshlandsS # [S] monument 9
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId PashhowMarshlandsS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 9, not requested 0: 46
finish option=100                       # the tablet taken; 1000 gil; a clay; TargetMonument 0
warp 364.0,-34.9,-399.0 RolanberryFieldsS # [S] monument 10
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId RolanberryFieldsS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 10, not requested 0: 46
finish option=100                       # the tablet taken; 3000 gil; a clay; TargetMonument 0
warp -204.1,-23.2,-119.7 WestSarutabarutaS # [S] monument 11
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId WestSarutabarutaS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 11, not requested 0: 46
finish option=100                       # the tablet taken; 800 gil; a clay; TargetMonument 0
warp 452.2,2.1,-290.7 MeriphataudMountainsS # [S] monument 15
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId MeriphataudMountainsS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 15, not requested 0: 46
finish option=100                       # the tablet taken; 1000 gil; a clay; TargetMonument 0
warp 79.0,-2.7,-184.8 SauromugueChampaignS # [S] monument 16
trade Stone_Monument LumpOfSelbinaClay x1 # a Clay Tablet; TabletZoneId SauromugueChampaignS
warp -50.6,-11.3,-13.1 Selbina
trade Abelard ClayTablet x1             # index 16, not requested 0: 46
finish option=100                       # the tablet taken; 10000 gil; a clay; TargetMonument 0
