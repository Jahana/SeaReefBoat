# Give a Moogle a Break (otherAreas 100) with its era module,
# modules/era/lua/quests/otherareas/give_a_moogle_a_break.lua, enabled by xi.pre(SOA) (RESTRICT_CONTENT 1, ENABLE_SOA
# 0). The module's check: the bed placed before the last conquest tally (bedPlacedTime < NextConquestTally() - 7 days:
# the harness clock's tally is 1800198000, so the edge is 1799593200). bedPlacedTime 1799999939 (the quest's own check
# would offer: placed 61 s ago): the menu. 1799593200 (not <): the menu. 1799593199: 30005, option 1: begun. Out and
# back: 30006; the trade: 30007, finished: the module's copy (both taken, Prog 1, Timer = JstMidnight(): 1800025200).
# Out and back: the Timer ahead: the menu (the quest's own finish would have set now + 60: the trace's char var shows
# which). Timer now - 1 (a GM): 30008, finished: completed.
module modules/era/lua/quests/otherareas/give_a_moogle_a_break.lua
lists BastokMines/Moogle/onTrigger BastokMines/Moogle/onTrade BastokMines/onEventFinish/30005 BastokMines/onEventFinish/30006 BastokMines/onEventFinish/30007 BastokMines/onEventFinish/30008
char zone=BastokMines pos=116.9,-1.6,-72 job=WAR lvl=75 nation=1
setting ENABLE_AMK 0                    # AMK 1 (30023, the Moogle, ENABLE_AMK 1) off: #kinds shows it
setting RESTRICT_CONTENT 1
setting ENABLE_SOA 0
fame Bastok 125
charvar Quest[4][100]bedPlacedTime 1799999939
item PowerBow
item BeetleRing
login
zoneline BastokMines                    # into the Mog House
trigger Moogle                          # placed after the tally - 7 days: the menu
charvar Quest[4][100]bedPlacedTime 1799593200 # a GM: the edge (not <)
trigger Moogle                          # the menu
charvar Quest[4][100]bedPlacedTime 1799593199 # a GM
trigger Moogle                          # 30005
finish option=1                         # begun
warp -6,0,-50 BastokMarkets
warp 116.9,-1.6,-72 BastokMines
zoneline BastokMines
trigger Moogle                          # 30006
finish
trade Moogle PowerBow x1 BeetleRing x1  # 30007
finish                                  # the module's: both taken; Prog 1; Timer = JstMidnight() (1800025200)
warp -6,0,-50 BastokMarkets
warp 116.9,-1.6,-72 BastokMines
zoneline BastokMines
trigger Moogle                          # the Timer ahead: nil; the menu
charvar Quest[4][100]Timer 1799999999   # a GM: now - 1
trigger Moogle                          # 30008
finish                                  # completed
