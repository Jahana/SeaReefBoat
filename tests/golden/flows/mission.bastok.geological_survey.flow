# A Geological Survey (Bastok 1-2, mission.bastok.geological_survey). A level 10 Warrior of Bastok (1-1 completed by a
# GM: no mission current; a GM's Resonance current keeps RoV 1-1's 30035 out of the logins). Section 1 (no current
# mission, a Bastokan): the four gate guards have no handler of their own, so each plays its script's mission list 1001;
# the finish of Bastok Markets, Bastok Mines and Metalworks with option 0 (not 1) does nothing; Port Bastok's with
# option 1 begins the mission (YOU_ACCEPT_THE_MISSION). Section 2 (1-2 current): Argus, Cleades, Rashid and Malduc
# each play their zone's ORIGINAL_MISSION_OFFSET + 3. Cid with neither tester plays 503, whose finish gives the Blue
# Acidity Tester; Cid with it plays 502 (mission:event); the I-8 geyser (Dangruf Wadi's trigger area 1) plays 10,
# whose finish turns the Blue tester into the Red one; Cid with the Red one plays 504, whose finish completes the
# mission (no reward table) and takes the Red tester. Completed: Cid has no section (his script's default); Cleades's
# section 1 matches again (nothing current): his 1001.
# Rival zone-in, another mission's script: the login in Bastok Markets plays Seekers of Adventure's Rumors from the West
# onZoneIn, which returns 22 (the trace records only that return, with no event packet).
lists BastokMarkets/Cleades/onTrigger BastokMarkets/onEventFinish/1001 BastokMines/Rashid/onTrigger BastokMines/onEventFinish/1001 Metalworks/Malduc/onTrigger Metalworks/Cid/onTrigger Metalworks/onEventFinish/1001 Metalworks/onEventFinish/503 Metalworks/onEventFinish/504 PortBastok/Argus/onTrigger PortBastok/onEventFinish/1001 DangrufWadi/onTriggerAreaEnter/1 DangrufWadi/onEventFinish/10
char zone=BastokMarkets pos=-358,-10,-168 job=WAR lvl=10 nation=1
mission Rov Resonance current
mission Bastok TheZeruhnReport completed
login
trigger Cleades                         # section 1: no handler: his script's 1001
finish option=0                         # not 1: nothing
warp -8.4,-1,-121 BastokMines
trigger Rashid                          # section 1: 1001
finish option=0                         # not 1: nothing
warp 64,-14,-4 Metalworks
trigger Malduc                          # section 1: 1001
finish option=0                         # not 1: nothing
warp 132,8.5,-4 PortBastok
trigger Argus                           # section 1: 1001
finish option=1                         # 1: begun, YOU_ACCEPT_THE_MISSION
trigger Argus                           # section 2: ORIGINAL_MISSION_OFFSET + 3
warp -358,-10,-168 BastokMarkets
trigger Cleades                         # section 2: ORIGINAL_MISSION_OFFSET + 3
warp -8.4,-1,-121 BastokMines
trigger Rashid                          # section 2: ORIGINAL_MISSION_OFFSET + 3
warp 64,-14,-4 Metalworks
trigger Malduc                          # section 2: ORIGINAL_MISSION_OFFSET + 3
trigger Cid                             # neither tester: 503
finish                                  # the Blue Acidity Tester
trigger Cid                             # the Blue tester: 502 (mission:event)
finish
warp -136,3,133 DangrufWadi
tick 1000
tick 1000
tick 1000
walk -133.1,3,133.2                     # area 1: 10
finish                                  # the Blue tester turned into the Red one
warp 64,-14,-4 Metalworks
trigger Cid                             # the Red tester: 504
finish                                  # completed; the Red tester deleted
trigger Cid                             # completed: no section: his script's default
finish
warp -358,-10,-168 BastokMarkets
trigger Cleades                         # completed, nothing current: section 1 again: 1001
finish option=0
