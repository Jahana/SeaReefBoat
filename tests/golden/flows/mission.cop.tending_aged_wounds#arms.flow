# Tending Aged Wounds, the other statuses (mission.cop.tending_aged_wounds#arms). 3-4 current with Status 1 (a GM):
# Lower Jeuno's zone-in: nothing. _6tc at Status 0 and 2: nothing. Metalworks Cid: 862, once a zone.
# A Crystalline Prophecy is not current (the default char has its own Lower Jeuno zone-in).
lists LowerJeuno/onZoneIn/1 LowerJeuno/_6tc/onTrigger Metalworks/Cid/onTrigger
char zone=Metalworks pos=0,0,0 job=WAR lvl=75 nation=0
mission Acp TheEchoAwakens current       # A Crystalline Prophecy's own Lower Jeuno zone-in is off
mission Cop TendingAgedWounds current
charvar Mission[6][350]Status 1         # a GM
login
trigger Cid                             # 862
finish-if-event
trigger Cid                             # once a zone: nothing
finish-if-event
warp 15.5,-0.1,-6.1 LowerJeuno               # Status 1: nothing
charvar Mission[6][350]Status 0         # a GM
trigger _6tc                            # Status 0: nothing
finish-if-event
charvar Mission[6][350]Status 2         # a GM
trigger _6tc                            # Status 2: nothing
finish-if-event
