dan: keyitem WhisperOfRadiance
eve: quest AhtUrhgan.WakingTheColossus accepted
eve: charvar Quest[6][74]Prog 5
eve: keyitem WhisperOfRadiance
fay: quest AhtUrhgan.WakingTheColossus accepted
fay: charvar Quest[6][74]Prog 5
fay: keyitem WhisperOfRadiance
login
trigger Naja_Salaheem                   # 929 ([0] 0, [7] 5)
finish option=0                         # no pick: completed anyway
bob: login
bob: trigger Naja_Salaheem              # 929 ([7] 0)
bob: finish option=2                    # the Colossus's Earring; completed
carl: login
carl: trigger Naja_Salaheem
carl: finish option=3                   # the Colossus's Torque; completed
dan: login
dan: trigger Naja_Salaheem
dan: finish option=4                    # 10000 gil; completed
eve: login
eve: trigger Naja_Salaheem
eve: finish option=5                    # Alexander, ALEXANDER_UNLOCKED; completed
