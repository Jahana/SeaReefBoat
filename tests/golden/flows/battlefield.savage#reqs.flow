# The Savage, the requirements. A level 75 Warrior of San d'Oria with The Savage current (a GM) at Status 0 (below
# requiredValue 1), in from Riverne - Site #B01: SD_Entrance: no options. Status 1 (a GM): the menu 32000; area 2
# (option 18): entered; its Ouryu (+1) killed: WON, 32001, finished: Status 2.
lists MonarchLinn/SD_Entrance/onTrigger MonarchLinn/onEventUpdate/32000 MonarchLinn/onEventFinish/32000 MonarchLinn/onEventFinish/32001
char zone=RiverneSiteB01 pos=0,0,0 job=WAR lvl=75 nation=0
mission Cop TheSavage current
charvar Mission[6][418]Status 0
login
warp -39.1,-3.3,-537 MonarchLinn        # from B01, Status 0
trigger SD_Entrance                     # Status 0: no options
finish-if-event
charvar Mission[6][418]Status 1         # a GM
trigger SD_Entrance                     # the menu 32000
update 32000 option=18                  # index 1, area 2: entered
finish                                  # in the arena
tick 2000
kill OURYU+1                            # allDeath: WON; 32001
finish                                  # Status 2
tick 11000
tick 10000
