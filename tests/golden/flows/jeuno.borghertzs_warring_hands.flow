# Borghertz's Warring Hands (jeuno 44): the template BorghertzQuests on its first quest, every NPC in turn. A level 50
# Warrior, The Talekeeper's Truth accepted (not available is enough), 1000 gil, an Eldieme Coffer Key. Guslam (Upper
# Jeuno; default 154): 155 (Option 1); finished: begun. Accepted, no Old Gauntlets: Guslam 43. The Eldieme Necropolis'
# Treasure Coffer: the key opens it to the Old Gauntlets (the key-item bypass), noAction. Guslam 26; finished at Prog
# 0, no Borghertz quest completed: Prog 1; 26 again (Prog 1): nothing. Deadly Minnow 24; finished: Prog 2. Yin
# Pocanakhu 220, its update with 1000 gil: the gil taken, Prog 3, (1, 1, 0, 0); 221 at Prog 3. Port Jeuno's qm1 20;
# finished 1: Prog 4; 49 (Prog 4, no Shadow Flames). Castle Zvahl Baileys' Torch at Prog 4: Dark Spark popped (claimed,
# hide 0), SENSE_OF_FOREBODING; its death: Prog 5; the Torch at Prog 5: the Shadow Flames, noAction; again with them:
# nil (the Torch's default NOTHING_OUT_OF_ORDINARY). qm1 48; finished: completed (Fighter's Mufflers), fame +7 x3 (San
# d'Oria, Bastok, Windurst), both key items taken. Completed: Guslam's default 154.
lists UpperJeuno/Guslam/onTrigger UpperJeuno/onEventFinish/155 UpperJeuno/onEventFinish/26 UpperJeuno/onEventFinish/24 UpperJeuno/Deadly_Minnow/onTrigger LowerJeuno/Yin_Pocanakhu/onTrigger LowerJeuno/onEventUpdate/220 PortJeuno/qm1/onTrigger PortJeuno/onEventFinish/20 PortJeuno/onEventFinish/48 CastleZvahlBaileys/Torch/onTrigger CastleZvahlBaileys/Dark_Spark/onMobDeath TheEldiemeNecropolis/Treasure_Coffer/onTrade
char zone=UpperJeuno pos=-4.2,1.3,47.5 job=WAR lvl=50 gil=1000
quest Bastok.TheTalekeepersTruth accepted
item EldiemeCofferKey
login
trigger Guslam                          # available, all four checks: 155 (Option 1)
finish                                  # Option 1 = WAR: begun
trigger Guslam                          # accepted, no Old Gauntlets: 43
finish
warp 301.5,-0.25,19.99 TheEldiemeNecropolis
tick 13000                              # the coffer placed
trigger Treasure_Coffer                 # walks to the coffer
trade Treasure_Coffer EldiemeCofferKey x1 # the old-gauntlet zone: the Old Gauntlets; noAction
tick 4500                               # the coffer opened
warp -4.2,1.3,47.5 UpperJeuno
trigger Guslam                          # the Old Gauntlets: 26
finish                                  # Prog 0, the first Borghertz quest: Prog 1
trigger Guslam                          # 26
finish                                  # Prog 1: nothing
warp -1.5,1.3,38 UpperJeuno
trigger Deadly_Minnow                   # Prog 1: 24
finish                                  # Prog 2
warp 35.3,4.1,-44 LowerJeuno
trigger Yin_Pocanakhu                   # Prog 2: 220
update 220 option=0                     # 1000 gil: taken; Prog 3; updateEvent(1, 1, 0, 0)
finish
trigger Yin_Pocanakhu                   # Prog 3: 221
finish
warp -52.7,6.1,-4.6 PortJeuno
trigger qm1                             # Prog 3: 20
finish option=1                         # Prog 4
trigger qm1                             # Prog 4, no Shadow Flames: 49
finish
warp 61.4,-26.2,15 CastleZvahlBaileys
trigger Torch                           # Prog 4: Dark Spark popped; SENSE_OF_FOREBODING
kill DARK_SPARK                         # its death: Prog 5
trigger Torch                           # Prog 5, no flames: the Shadow Flames; noAction
trigger Torch                           # the flames held: nil; NOTHING_OUT_OF_ORDINARY
warp -52.7,6.1,-4.6 PortJeuno
trigger qm1                             # Prog 5, the flames: 48
finish                                  # completed: Fighter's Mufflers; fame +7 x3; both key items taken
warp -4.2,1.3,47.5 UpperJeuno
trigger Guslam                          # completed, no other quest startable: 154
finish
