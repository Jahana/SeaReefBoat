# Trial by Earth (bastok 61): accepted with neither the fork nor the whisper (the fork is used up by a lost fight):
# 284 gives a new fork; then 250.
lists PortBastok/Juroro/onTrigger PortBastok/onEventFinish/284
char zone=PortBastok pos=32,7,-41 job=WAR lvl=75
quest Bastok.TrialByEarth accepted
login
trigger Juroro                 # no whisper, no fork: 284 (0, fork)
finish                         # a new Tuning Fork of Earth
trigger Juroro                 # the fork: 250
finish
