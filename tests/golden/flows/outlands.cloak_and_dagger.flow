lists Kazham/Jakoh_Wahcondalo/onTrigger Kazham/Jakoh_Wahcondalo/onTrade GustavTunnel/qm1/onTrigger GustavTunnel/Baronial_Bat/onMobDeath Kazham/onEventFinish/284
char zone=Kazham pos=101.702,-15.023,-115.841 job=THF lvl=75
skill Dagger 2300
