# Candle Making (jeuno 22) while A Candlelight Vigil is not accepted: check 1 false. Vigil available: no section,
# Rouliette's default 30; Vigil completed (GM): the same.
lists UpperJeuno/Rouliette/onTrigger
char zone=UpperJeuno pos=-19.7,-1.5,12.6 job=WAR lvl=30
login
trigger Rouliette                       # A Candlelight Vigil available: no section; default 30
finish
quest Jeuno.ACandlelightVigil completed
trigger Rouliette                       # A Candlelight Vigil completed: no section; default 30
finish
