# An Empty Vessel (ahtUrhgan 5): a level 30 Warrior with 5000 gil, a Siren's Tear and a Bone Chip. Waoud (no script;
# default 61) is the whole quest in Whitegate; Aydeewa Subterrane's trigger area 1 (378 -3 338 .. 382 3 342) ends it.
# Available: a trade to Waoud: no section-1 trade handler: nothing; Waoud 60 (5000): three right answers and a wrong
# one, then option 40: updateEvent(5000, 0, 0, 0, 0, 0, 0, 20) (floor(3 / 2) + 1 = 2: Stone); finished with option 45:
# mustZone, Timer = day + 1, 1000 gil taken (PAY_DIVINATION). Waoud 63 (the mustZone); out of Whitegate and back: 63
# (Timer > day); the next Vana'diel day: 60, the ten right answers, option 40: Option = randomInt(1, 3) and
# updateEvent(4000, 0, 0, 0, 0, 0, Option, 70) (CHECK the drawn Option in the trace); finished with option 50: begun,
# mustZone, Timer = day + 1. A GM pins Option to 1 (the Siren's Tear) whatever the draw. Accepted: Waoud 64 (mustZone),
# a tear at Prog 0: nil; out and back: 64 (Timer); the next day: 65 (Prog 1); 66 ({ [6] = 1 }); a Bone Chip: nil; the
# tear with a Bone Chip: nil; the tear: 67 ({ [6] = 1 }: Prog 2, the tear kept); the tear again at Prog 2: nil; 68. Aydeewa: area 1 at Prog 2 with the tear: 3 (576); option 13:
# completed (Bearer of the Mark of Zahak), BLU unlocked, the Mark of Zahak and the BLU gesture (no message: the event
# shows them), completeEvent 1; setPos Whitegate 148 -2 0. Completed: Waoud 69 (completeEvent 1), option 0: kept; 69
# again, option 1: cleared; 78 (gil; the vars cleared by the completion), update option 1: nothing, option 40:
# updateEvent(gil, 0, 0, 0, 0, 0, 0, randomInt(1, 5) * 10); finished with option 1: mustZone, Timer, 1000 gil; 63.
# xi.player.onGameIn's ZoningIn lock keeps trigger areas off for 2.5 s after a zone-in (hence the ticks); Aydeewa's own
# onTriggerAreaEnter does nothing.
lists AhtUrhganWhitegate/Waoud/onTrigger AhtUrhganWhitegate/Waoud/onTrade AhtUrhganWhitegate/onEventUpdate/60 AhtUrhganWhitegate/onEventFinish/60 AydeewaSubterrane/onTriggerAreaEnter/1 AydeewaSubterrane/onEventFinish/3
char zone=AhtUrhganWhitegate pos=67.116,-6,-78.222 job=WAR lvl=30 gil=5000
item SirensTear
item BoneChip
login
trade Waoud SirensTear x1               # available: no trade handler in section 1: nothing
trigger Waoud                           # no mustZone, Timer 0 <= day: 60 (5000)
update 60 option=2                      # a right answer: numCorrect 1
update 60 option=1                      # a wrong one: unchanged
update 60 option=6                      # 2
update 60 option=9                      # 3
update 60 option=40                     # numCorrect 3 < 10: updateEvent(5000, 0, 0, 0, 0, 0, 0, 20)
finish option=45                        # numCorrect 0; gil >= 1000: mustZone, Timer = day + 1, 1000 gil taken, PAY_DIVINATION
trigger Waoud                           # mustZone: 63
finish
warp -64,-7,38 AlZahbi                  # the mustZone cleared (another zone)
warp 67.116,-6,-78.222 AhtUrhganWhitegate
trigger Waoud                           # Timer = day + 1 > day: 63
finish
wait vana=24                            # the next Vana'diel day
trigger Waoud                           # 60 (4000)
update 60 option=2
update 60 option=6
update 60 option=9
update 60 option=12
update 60 option=13
update 60 option=18
update 60 option=21
update 60 option=24
update 60 option=26
update 60 option=30                     # numCorrect 10
update 60 option=40                     # Option = randomInt(1, 3) (CHECK the draw); updateEvent(4000, 0, 0, 0, 0, 0, Option, 70)
finish option=50                        # begun; mustZone; Timer = day + 1
charvar Quest[6][5]Option 1             # a GM: the Siren's Tear, whatever the draw
trigger Waoud                           # accepted, mustZone: 64
finish
trade Waoud SirensTear x1               # Prog 0: nil
warp -64,-7,38 AlZahbi
warp 67.116,-6,-78.222 AhtUrhganWhitegate
trigger Waoud                           # Timer > day: 64
finish
wait vana=24
trigger Waoud                           # Prog 0: 65
finish                                  # Prog 1
trigger Waoud                           # Prog 1: 66 ({ [6] = 1 })
finish
trade Waoud BoneChip x1                 # not the item: nil
trade Waoud SirensTear x1 BoneChip x1   # the tear with another item (tradeMatches is exact): nil
trade Waoud SirensTear x1               # Prog 1, the tear alone: 67 ({ [6] = 1 })
finish                                  # Prog 2; the tear kept
trade Waoud SirensTear x1               # Prog 2: nil
trigger Waoud                           # Prog 2: 68
finish
warp 372,0,340 AydeewaSubterrane        # beside area 1 (CHECK the ground height)
tick 1000
tick 1000
tick 1000
walk 380,0,340                          # area 1, Prog 2, the tear held: 3 (576)
finish option=13                        # completed: Bearer of the Mark of Zahak; BLU, the Mark of Zahak, the BLU gesture; completeEvent 1; setPos Whitegate 148 -2 0
tick 400
login                                   # the zone change: Whitegate
warp 67.116,-6,-78.222 AhtUrhganWhitegate   # beside Waoud (and the flow checker's zone)
trigger Waoud                           # completed, completeEvent 1: 69
finish option=0                         # completeEvent kept
trigger Waoud                           # 69
finish option=1                         # completeEvent 0
trigger Waoud                           # no mustZone, Timer 0: 78 (gil)
update 78 option=1                      # not 40: nothing
update 78 option=40                     # updateEvent(gil, 0, 0, 0, 0, 0, 0, randomInt(1, 5) * 10)
finish option=1                         # gil >= 1000: mustZone, Timer = day + 1, 1000 gil, PAY_DIVINATION
trigger Waoud                           # mustZone: 63
finish
