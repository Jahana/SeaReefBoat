# Mog House Exposition, section 2 in the Bastok Mog Houses: a char of nation 0,
# the quest's notSeen 0 and oNation 1 (a GM's
# charvar before each: quest:complete clears it): not the home nation, inside the Mog House: the Moogle's 30001,
# finished: quest:complete (oNation cleared).
lists BastokMines/Moogle/onTrigger BastokMines/onEventFinish/30001 BastokMarkets/Moogle/onTrigger BastokMarkets/onEventFinish/30001 PortBastok/Moogle/onTrigger PortBastok/onEventFinish/30001
char zone=BastokMines pos=116.9,-1.6,-72 job=WAR lvl=1 nation=0
login
warp 116.9,-1.6,-72 BastokMines
zoneline BastokMines             # into the Mog House
charvar HQuest[moghouseExpo]oNation 1  # a GM
trigger Moogle                          # not the home nation, oNation 1: 30001
finish                                  # complete: oNation cleared
warp -98.9,-4.8,-77.5 BastokMarkets
zoneline BastokMarkets           # into the Mog House
charvar HQuest[moghouseExpo]oNation 1  # a GM
trigger Moogle                          # not the home nation, oNation 1: 30001
finish                                  # complete: oNation cleared
warp -3,1.407,49 PortBastok
zoneline PortBastok              # into the Mog House
charvar HQuest[moghouseExpo]oNation 1  # a GM
trigger Moogle                          # not the home nation, oNation 1: 30001
finish                                  # complete: oNation cleared
