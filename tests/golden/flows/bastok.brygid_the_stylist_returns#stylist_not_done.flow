# Brygid the Stylist Returns with artifact armor worn but Brygid the Stylist not completed: its guard fails, and
# Brygid the Stylist's offer (310) plays instead of 380.
# Recorded with `--lua-at 949ac2eb`, which brought back only this quest's Lua: Brygid the Stylist (whose 310 this is)
# ran on C# in that recording, so the trace mixes the two. A re-record does the same unless both Lua files come back.
char zone=BastokMarkets pos=-90.2,-4.302,-107.5 job=MNK lvl=75
item TempleCrown
login
equip TempleCrown Head
trigger Brygid                  # Brygid the Stylist available: its offer, 310
finish                          # Brygid the Stylist accepted; this quest untouched
