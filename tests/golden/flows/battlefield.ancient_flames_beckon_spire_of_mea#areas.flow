# Ancient Flames Beckon, Spire of Mea, areas 2 and 3. Below the Arks current (a GM). Area 2 (option 2): the arena's
# Delver is DELVER + 5; killed: WON; 32001 (the area 2), finished: the light of Mea. The light gone and Below
# the Arks current again (GMs): area 3 (option 3): DELVER + 10; 32001 (area 3).
lists SpireOfMea/_0l0/onTrigger SpireOfMea/onEventUpdate/32000 SpireOfMea/onEventFinish/32000 SpireOfMea/onEventFinish/32001
char zone=SpireOfMea pos=0,-3.8,240 job=WAR lvl=75 nation=0
mission Cop BelowTheArks current
login
trigger _0l0                            # the menu 32000
update 32000 option=2                   # area 2: entered
finish                                  # in the arena
tick 2000                               # area 2's Delver spawns
kill DELVER+1                     # allDeath: WON; 32001
finish                                  # the light of Mea, 1-2 complete
tick 11000                              # the won arena's cleanup
tick 10000                              # out of the battlefield
delkeyitem LightOfMea                   # a GM
warp 179,35,255 TahrongiCanyon
warp 0,-3.8,240 SpireOfMea
trigger _0l0                            # the menu 32000
update 32000 option=3                   # area 3: entered
finish                                  # in the arena
tick 2000                               # area 3's Delver spawns
kill DELVER+2                    # allDeath: WON; 32001
finish                                  # the light of Mea, 1-2 complete
tick 11000
tick 10000
