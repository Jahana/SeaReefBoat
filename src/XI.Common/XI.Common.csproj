<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- XI.Common: pure-Math foundation (Vana'diel clock, later scheduler shells).
         Product build targets net8.0; spike/verify uses net10.0 for the local SDK. -->
    <AssemblyName>XI.Common</AssemblyName>
    <RootNamespace>XI.Common</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
