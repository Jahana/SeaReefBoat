# Martial Mastery (jeuno 167), the level either side of 96 alone: a level 95 Warrior, Great Axe 357, 15 merit points.
# Available: no section (getMainLvl() >= 96), the default 10045 (0, 0, 2, 0). Accepted (a GM): no section either (the
# accepted check reads the level too), the default.
lists RuludeGardens/Nomad_Moogle/onTrigger
char zone=RuludeGardens pos=10.0,1.5,119.9 job=WAR lvl=95
skill GreatAxe 3570
merits 15
login
trigger Nomad_Moogle                    # level 95: no section; the default 10045 (0, 0, 2, 0)
finish
quest Jeuno.MartialMastery accepted     # a GM
trigger Nomad_Moogle                    # accepted, level 95: no section; the default
finish
