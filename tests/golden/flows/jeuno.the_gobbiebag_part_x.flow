# The Gobbiebag Part X (jeuno 124): Lower Jeuno's Bluffnix (no script; default 43 with 81), the template GobbiebagQuest.
# A level 75 Warrior at Jeuno fame level 5 ((650 + 0 + 0) / 2 = 325), the inventory at 75 (storage; a fresh char has
# 30), Parts I-IX completed (the chain's earlier parts, by a GM), the four items, a Bowl of Goblin Stew (880) and a
# Chocobo Feather. Available: a trade: no trade handler; 43 (76, 0, 1), option 1: nothing; option 0: begun. Accepted: 43
# (76, 1, 1), its finish: no handler; three items, the four and the feather, the stew and an item: 43 (76, 1, 1); the
# stew alone: 73 (81), the quest completed by a GM while it is open: no 73 finish (the stew kept); accepted again (a
# GM): the four items: 73 (81), finished: completed (GrandGreedalox), the inventory 80, INVENTORY_INCREASED, the items
# taken (no satchel: unchanged). Completed: no section; Bluffnix's default 43 (81). Set accepted by a GM at 80: the
# accepted check fails: no section (43 (81)), a trade: nothing; set available by a GM at 80: no section. A GM sets a
# part available before accepted (accepted over completed keeps it completed).
lists LowerJeuno/Bluffnix/onTrigger LowerJeuno/Bluffnix/onTrade LowerJeuno/onEventFinish/43 LowerJeuno/onEventFinish/73
char zone=LowerJeuno pos=-41.7,5.9,-113 job=WAR lvl=75
storage inventory 75                    # the part's start size (char_storage.inventory; a fresh char has 30)
fame Sandoria 650
quest Jeuno.TheGobbiebagPartI completed
quest Jeuno.TheGobbiebagPartIi completed
quest Jeuno.TheGobbiebagPartIii completed
quest Jeuno.TheGobbiebagPartIv completed
quest Jeuno.TheGobbiebagPartV completed
quest Jeuno.TheGobbiebagPartVi completed
quest Jeuno.TheGobbiebagPartVii completed
quest Jeuno.TheGobbiebagPartViii completed
quest Jeuno.TheGobbiebagPartIx completed
item MolybdenumIngot
item SquareOfGriffonLeather
item SquareOfFoulard
item AngelSkinOrb
item BowlOfGoblinStew880
item ChocoboFeather
login
trade Bluffnix ChocoboFeather x1        # available: no trade handler; nothing
trigger Bluffnix                        # reqsMet: 43 (76, 0, 1)
finish option=1                         # not 0: nothing
trigger Bluffnix                        # 43 (76, 0, 1)
finish option=0                         # begun
trigger Bluffnix                        # accepted: 43 (76, 1, 1)
finish option=0                         # no 43 finish while accepted: nothing
trade Bluffnix MolybdenumIngot x1 SquareOfGriffonLeather x1 SquareOfFoulard x1 # three of the four: 43 (76, 1, 1)
finish
trade Bluffnix MolybdenumIngot x1 SquareOfGriffonLeather x1 SquareOfFoulard x1 AngelSkinOrb x1 ChocoboFeather x1 # an extra item: 43 (76, 1, 1)
finish
trade Bluffnix BowlOfGoblinStew880 x1 MolybdenumIngot x1 # the stew and an item: 43 (76, 1, 1)
finish
trade Bluffnix BowlOfGoblinStew880 x1   # the stew alone: 73 (81)
quest Jeuno.TheGobbiebagPartX completed # a GM, while 73 is open
finish                                  # no 73 finish while completed: nothing (the stew kept)
quest Jeuno.TheGobbiebagPartX available # a GM: accepted over completed keeps it completed
quest Jeuno.TheGobbiebagPartX accepted  # a GM
trade Bluffnix MolybdenumIngot x1 SquareOfGriffonLeather x1 SquareOfFoulard x1 AngelSkinOrb x1 # the four items: 73 (81)
finish                                  # completed (GrandGreedalox); inventory 80; INVENTORY_INCREASED; the items taken
trigger Bluffnix                        # completed: no section; 43 (81)
finish option=1                         # declined: nothing
quest Jeuno.TheGobbiebagPartX available # a GM: accepted over completed keeps it completed
quest Jeuno.TheGobbiebagPartX accepted  # a GM, at 80
trigger Bluffnix                        # accepted, the inventory 80: no section; 43 (81)
finish
trade Bluffnix BowlOfGoblinStew880 x1   # no section: nothing
quest Jeuno.TheGobbiebagPartX available # a GM, at 80
trigger Bluffnix                        # available, the inventory 80: no section; 43 (81)
finish option=0                         # no section: not begun
