# The Mothercrystals, the Konschtat telepoint's first branch by lights (CoP 1-3). 1-3 current, Option 0, Status 0. One
# light and it is Dem's own (a GM): 913 (the own light, no first-branch 912). The light swapped for Holla's and Mea's (two
# lights, none of Dem's; GMs): 913 with the flag 0, not the 912 of one light.
lists KonschtatHighlands/Shattered_Telepoint/onTrigger KonschtatHighlands/onEventFinish/913
char zone=KonschtatHighlands pos=135,19,220 job=WAR lvl=75 nation=0
mission Cop TheMothercrystals current
keyitem LightOfDem                      # a GM
login
trigger Shattered_Telepoint             # one light, its own: 913
finish option=1                         # not 0: nothing
delkeyitem LightOfDem                   # a GM
keyitem LightOfHolla                    # a GM
keyitem LightOfMea                      # a GM
trigger Shattered_Telepoint             # two lights, Option 0: 913 with the flag 0
finish option=1                         # not 0: nothing
