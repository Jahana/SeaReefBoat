# Distant Loyalties (sandoria 74): Femitte and Rouva in Southern San d'Oria, Michea in Bastok Markets. Fame 224 (level
# 3): Femitte's default 661, Rouva's default 662. Fame 225: Femitte's 663 with option 1 (declined: nothing), option 0
# (begun, the Goldsmithing Order); Femitte (Prog 0: nil, 661); Rouva's 664. Michea: an ingot at Prog 0 (nil; no script:
# nothing); 315 (the order taken, Prog 1); 316; the ingot with a chip (not exactly: nil); the ingot (317: taken, Prog 2,
# mustZone); 320; out to Southern San d'Oria (Femitte at Prog 2: nil, 661; and with the Mythril Hearts by GM, her Prog
# operand: nil) and back: mustZone cleared; 318 (Prog 3, Mythril Hearts); Prog 3: nil (his default 125); Prog 3 with the
# order and mustZone by GM (the Prog operands of 315's and 320's arms): nil. Femitte at Prog 3 without the hearts by GM
# (her hearts operand): nil; with them, 665 (completed: White Cape, fame +40; finalCS 1; the hearts taken); then
# Femitte's and Rouva's defaults. Michea's 319 (finalCS 0), then his default 125; completed with Prog 1 by GM (section 2's
# status operand): his default 125.
# Femitte's and Rouva's scripts have empty onTrigger and onEventFinish: the quest's replies play. Spice Gals needs CoP
# 2-5, Elderly Pursuits its own offer: neither opens for Rouva here. Michea has no script; his default is 125. His
# other quests are closed by the setup: The Elvaan Goldsmith completed at Bastok fame level 2 (its repeat needs level 1)
# and Father Figure completed (its offer needs level 2 and not completed). The
# container's mustZone is the zone id it was set in; it clears on entering another zone (player.lua's onZoneIn), not on a
# rezone into Bastok Markets, so the flow goes out and back.
lists SouthernSanDoria/Femitte/onTrigger SouthernSanDoria/Rouva/onTrigger SouthernSanDoria/onEventFinish/663 SouthernSanDoria/onEventFinish/665 BastokMarkets/Michea/onTrigger BastokMarkets/Michea/onTrade BastokMarkets/onEventFinish/315 BastokMarkets/onEventFinish/317 BastokMarkets/onEventFinish/318 BastokMarkets/onEventFinish/319
char zone=SouthernSanDoria pos=-15.654,2.101,12.203 job=WAR lvl=30
fame Sandoria 224
quest Bastok.TheElvaanGoldsmith completed
quest Bastok.FatherFigure completed
fame Bastok 50
item MythrilIngot
item MythrilIngot
item BoneChip
login
trigger Femitte                           # fame level 3: no section; her default 661
finish
trigger Rouva                             # available: no section; her default 662
finish
fame Sandoria 225
trigger Femitte                           # fame level 4: 663
finish option=1                           # not 0: nothing
trigger Femitte                           # 663
finish                                    # option 0: begun; the Goldsmithing Order
trigger Femitte                           # accepted, Prog 0: nil (section 1 closed: its 663 would play); her default 661
finish
trigger Rouva                             # accepted: 664
finish
warp -296.096,-15.948,-157.074 BastokMarkets
trade Michea MythrilIngot x1              # Prog 0: nil; no script: nothing
trigger Michea                            # Prog 0, the order: 315
finish                                    # the order taken; Prog 1
trigger Michea                            # Prog 1: 316
finish
trade Michea MythrilIngot x1 BoneChip x1  # not exactly the ingot: nil
trade Michea MythrilIngot x1              # Prog 1: 317
finish                                    # the ingot taken; Prog 2; mustZone (Bastok Markets)
trigger Michea                            # Prog 2, mustZone: 320
finish
warp -15.654,2.101,12.203 SouthernSanDoria   # mustZone cleared
trigger Femitte                           # Prog 2: nil; her default 661
finish
keyitem MythrilHearts
trigger Femitte                           # Prog 2 with the hearts: nil (the Prog operand); her default 661
finish
delkeyitem MythrilHearts
warp -296.096,-15.948,-157.074 BastokMarkets
trigger Michea                            # Prog 2, no mustZone: 318
finish                                    # Prog 3; Mythril Hearts
trigger Michea                            # Prog 3: nil; his default 125
finish
keyitem GoldsmithingOrder
charvar Quest[0][74]mustZone 235
trigger Michea                            # Prog 3 with the order and mustZone: nil; his default 125
finish
delkeyitem GoldsmithingOrder
charvar Quest[0][74]mustZone 0
warp -15.654,2.101,12.203 SouthernSanDoria
delkeyitem MythrilHearts
trigger Femitte                           # Prog 3 without the hearts: nil (the hearts operand); her default 661
finish
keyitem MythrilHearts
trigger Femitte                           # Prog 3, the hearts: 665
finish                                    # completed: White Cape, fame +40; finalCS 1; the hearts taken
trigger Femitte                           # completed: no section; her default 661
finish
trigger Rouva                             # completed: her default 662
finish
warp -296.096,-15.948,-157.074 BastokMarkets
trigger Michea                            # completed, finalCS 1: 319
finish                                    # finalCS 0 (the order, long gone, deleted again)
trigger Michea                            # finalCS 0: nil; his default 125
finish
charvar Quest[0][74]Prog 1
trigger Michea                            # completed, Prog 1: no section 2 (its status operand); his default 125
finish
