finish option=0                         # begun
trigger Ambrosius                       # accepted: 49
finish
trigger Orudoba-Sondeba                 # accepted: 51
finish
trigger Tsuaora-Tsuora                  # accepted: 50
finish
trigger Ambrosius                       # 49 (back beside him)
finish
trade Ambrosius TornEpistle x1 BlockOfAnimalGlue x1  # one point, two items: nothing
trade Ambrosius TornEpistle x1 MuddyBarTab x1 OddPostcard x1 DampEnvelope x1  # four: 55 (500, 4)
finish                                  # the four taken; 500 gil; fame 10; completed
trigger Ambrosius                       # completed: 56
finish
trigger Orudoba-Sondeba                 # completed: his 43
finish
trigger Tsuaora-Tsuora                  # completed: her 42
finish
trigger Ambrosius                       # 56 (back beside him)
finish
item TornEpistle
trade Ambrosius TornEpistle x1          # completed, one: 57 (50)
finish                                  # taken; 50 gil; fame 10
item TornEpistle
item MuddyBarTab
trade Ambrosius TornEpistle x1 MuddyBarTab x1  # two: 58 (150, 2)
finish                                  # taken; 150 gil; fame 10
item TornEpistle
item MuddyBarTab
item OddPostcard
