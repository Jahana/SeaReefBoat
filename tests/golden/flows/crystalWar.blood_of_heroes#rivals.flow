finish
charvar Quest[7][52]Prog 2                   # a GM
charvar Quest[7][50]Prog 3                   # a GM
delkeyitem CommandersEndorsement             # a GM
trigger Forbidding_Portal                    # no endorsement: What Price Loyalty has no section: Blood's 4 alone
finish
keyitem CommandersEndorsement                # a GM
charvar Quest[7][50]Prog 3                   # a GM
trigger Forbidding_Portal                    # Blood at Prog 3: nothing of its own: What Price Loyalty's 9
finish                                       # What Price Loyalty's Prog 4
trigger Forbidding_Portal                    # both without a Portal reply: NO_RESPONSE
finish-if-event
warp -167.043,-2,55.484 SouthernSanDoriaS
mission Wotg FateInHaze completed       # a GM
mission Wotg TheScentOfBattle current   # a GM: not Fate in Haze (its Rholont reply is the same 656)
