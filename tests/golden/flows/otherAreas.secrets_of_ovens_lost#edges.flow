# Secrets of Ovens Lost (otherAreas 73): the checks' edges. Spice Gals completed. Accepted at Prog 0 (a GM; no check
# reads the status): Despachiaire (not available): nil, 106; Jonette (Option 0, not completed): nil, 365. Option 1 (a
# GM): Jonette 506 (section 1 answers an accepted quest), finished: Prog 1; Prog 2 (a GM): both sections off: 365. Wait
# 1800198000 (a GM, = the tally) at Prog 0, available: Despachiaire: section 1 off, 106; Wait 1800197999: 505. Prog 1
# with the cookbook while available (a GM): Jonette 508 (section 2 answers an available quest), finished: completed. A
# trade to Jonette while available: no trade handler, nothing.
lists TavnazianSafehold/Despachiaire/onTrigger TavnazianSafehold/Jonette/onTrigger TavnazianSafehold/onEventFinish/505 TavnazianSafehold/onEventFinish/506 TavnazianSafehold/onEventFinish/507 TavnazianSafehold/onEventFinish/508 Sacrarium/qm_tavnazian_cookbook/onTrigger PhomiunaAqueducts/qm_tavnazian_cookbook/onTrigger
lists TavnazianSafehold/Jonette/onTrade
char zone=TavnazianSafehold pos=112.7,-40,-85.5 job=WAR lvl=75
quest Sandoria.SpiceGals completed
quest OtherAreas.SecretsOfOvensLost accepted
item ChocoboFeather
login
trigger Despachiaire                    # accepted, Prog 0: not available; nil; 106
finish
warp -68.5,-11.3,9.2 TavnazianSafehold
trigger Jonette                         # Option 0, not completed: nil; 365
finish
charvar Quest[4][73]Option 1            # a GM
trigger Jonette                         # accepted, Option 1: 506
finish                                  # begun again (accepted already); Prog 1
charvar Quest[4][73]Prog 2              # a GM
trigger Jonette                         # Prog 2: both sections off; 365
finish
quest OtherAreas.SecretsOfOvensLost available # a GM
charvar Quest[4][73]Prog 0              # a GM
charvar Quest[4][73]Option 0            # a GM
charvar Quest[4][73]Wait 1800198000     # a GM: = the tally
trade Jonette ChocoboFeather x1         # available: no trade handler; nothing
warp 112.7,-40,-85.5 TavnazianSafehold
trigger Despachiaire                    # Wait = the tally: section 1 off; 106
finish
charvar Quest[4][73]Wait 1800197999     # a GM
trigger Despachiaire                    # Wait below the tally: 505
finish                                  # Option 1
charvar Quest[4][73]Prog 1              # a GM
keyitem TavnazianCookbook               # a GM
warp -68.5,-11.3,9.2 TavnazianSafehold
trigger Jonette                         # available, Prog 1, the cookbook: 508
finish                                  # completed
