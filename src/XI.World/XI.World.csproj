<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- XI.World: port of src/world (message server). Transport-agnostic: the ZMQ router is behind IWorldChannel. -->
    <AssemblyName>XI.World</AssemblyName>
    <RootNamespace>XI.World</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetMQ" Version="4.0.1.13" />
    <ProjectReference Include="..\XI.Persistence\XI.Persistence.csproj" />
    <ProjectReference Include="..\XI.Ipc\XI.Ipc.csproj" />
    <ProjectReference Include="..\XI.Login\XI.Login.csproj" />
    <ProjectReference Include="..\XI.Common\XI.Common.csproj" />
  </ItemGroup>

</Project>
