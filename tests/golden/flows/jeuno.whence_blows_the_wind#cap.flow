# Whence Blows the Wind (jeuno 130), a level 56 Warrior, the level cap alone either side of 60 (a GM's setLevelCap):
# cap 59 and cap 61: no section (no other limit break answers), MAAT_DIALOG; cap 60: 85.
lists RuludeGardens/Maat/onTrigger RuludeGardens/onEventFinish/85
char zone=RuludeGardens pos=12.4,3.1,119.5 job=WAR lvl=56
levelcap 59
login
trigger Maat                            # cap 59: no section; MAAT_DIALOG
levelcap 61                             # a GM
trigger Maat                            # cap 61: no section; MAAT_DIALOG
levelcap 60                             # a GM
trigger Maat                            # cap 60: 85
finish option=0                         # nothing
