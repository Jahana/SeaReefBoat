charvar Quest[6][15]Prog 3              # a GM pins the draw
finish                                  # Prog 3: no stew; completed; the fish taken
trade Ququroon Ahtapot x1 Istakoz x1 Istavrit1 x1 Istiridye x1 Mercanbaligi x1   # completed: 243 ([7] = the draw)
charvar Quest[6][15]Prog 3              # a GM pins the draw
