# The Old Monument (jeuno 11) below ADVANCED_JOB_LEVEL (30): no section. Mertaire's default LOVE_ROMANCE, Mataligeat's
# default 141, the Song Runes' default SONG_RUNES_DEFAULT.
lists LowerJeuno/Mertaire/onTrigger LowerJeuno/Mataligeat/onTrigger BuburimuPeninsula/Song_Runes/onTrigger
char zone=LowerJeuno pos=-19.5,0,-59 job=WAR lvl=29
login
trigger Mertaire                            # level 29: no section; LOVE_ROMANCE
trigger Mataligeat                          # 141
finish
warp -244,16,-280 BuburimuPeninsula
trigger Song_Runes                          # SONG_RUNES_DEFAULT
