# Divine Might (outlands 163) with its era module, modules/era/lua/quests/outlands/divine_might.lua, enabled by
# xi.pre(ROV) (RESTRICT_CONTENT 1, ENABLE_ROV 0): the Qu'Hau Spring takes the pair on the full moon from 00:00 to 02:59
# in clear weather (the zone's NONE or SUNSHINE) only. A level 75 Warrior in Ro'Maeve, Divine Might accepted (a GM), two
# pairs and a Bone Chip. Day 8022 (the full moon), each weather set by a GM right before its trade (the zone's own roll
# moves it): 00:00 NONE: the pair with the chip: nothing; the pair: 7, finished: the Ark Pentasphere, the pair taken;
# SUNSHINE: 7, finished: the pentasphere held (rare): nothing; CLOUDS (2): nothing; 02:00 SUNSHINE with a Rainstorm on
# the char (a GM: the char's weather RAIN, the zone's SUNSHINE: the module reads the zone): 7, finished: nothing (held);
# 03:00 NONE (the base quest's window): nothing; 18:00 NONE (the base's): nothing; day 8029 00:00 NONE (not the full
# moon): nothing.
module modules/era/lua/quests/outlands/divine_might.lua
lists Romaeve/QuHau_Spring/onTrade Romaeve/onEventFinish/7
char zone=Romaeve pos=1.748,-27.402,67.751 job=WAR lvl=75
setting RESTRICT_CONTENT 1
setting ENABLE_ROV 0
quest Outlands.DivineMight accepted
item SheetOfParchment x2
item BottleOfIlluminink
item BottleOfIlluminink
item BoneChip
login
wait vana=516                           # day 8022, 00:00 (FULL_MOON)
weather 0                               # NONE
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1 BoneChip x1   # not exactly: nothing
weather 0                               # NONE
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # 7
finish                                  # the Ark Pentasphere; the pair taken
weather 1                               # SUNSHINE
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # 7
finish                                  # the pentasphere held: nothing taken
weather 2                               # CLOUDS
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # the module: nothing
wait vana=2                             # 02:00
effect 183                              # a GM: Rainstorm (the char's weather RAIN)
weather 1
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # 7
finish                                  # held: nothing
wait vana=1                             # 03:00
weather 0
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # the module: nothing (the base: 7)
wait vana=15                            # 18:00
weather 0
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # the module: nothing (the base: 7)
wait vana=150                           # day 8029, 00:00 (93% waning: not the full moon)
weather 0
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # nothing
