# Awakening: Apocalypse Nigh's 232 and 234 at Gilgamesh (that quest's events; this mission's finishes). At status 3 the
# 232 finish on option 1 completes the mission (The Last Verse next) beside Apocalypse Nigh's earring. Put back (a GM),
# 234 on option 0 or 5 does nothing; at status 2 option 4 completes only the quest; at status 3 option 4 completes the
# mission while the quest, its earring held, says ITEM_CANNOT_BE_OBTAINED and stays open.
warning: lua: addMission: overwriting current mission 31 of log 3 with 30 -- the GM's mission line puts Awakening back over The Last Verse
lists Norg/onZoneIn/1 Norg/onEventFinish/176 Norg/Gilgamesh/onTrigger Norg/onEventFinish/232 Norg/onEventFinish/234 LowerJeuno/_6tc/onTrigger LowerJeuno/onEventFinish/20
char zone=Norg pos=120.9,-8,-12 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart Awakening current
quest Jeuno.ShadowsOfTheDeparted completed
quest Jeuno.ApocalypseNigh accepted
charvar Quest[3][89]Prog 5
login                                   # bit 0 clear: 176, answered: status 1
missionstatus Zilart 3                  # a GM
trigger Gilgamesh                       # Apocalypse Nigh's 232
finish option=1                         # the earring; status 3, option 1: completed
mission Zilart Awakening current        # a GM
missionstatus Zilart 3                  # a GM
quest Jeuno.ApocalypseNigh available    # a GM
quest Jeuno.ApocalypseNigh accepted     # a GM
charvar Quest[3][89]Prog 6              # a GM
trigger Gilgamesh                       # 234
finish option=0                         # option 0: nothing
trigger Gilgamesh                       # 234
finish option=5                         # option 5: nothing
missionstatus Zilart 2                  # a GM
trigger Gilgamesh                       # 234
finish option=4                         # the quest completed; status 2: nothing
quest Jeuno.ApocalypseNigh available    # a GM
quest Jeuno.ApocalypseNigh accepted     # a GM
charvar Quest[3][89]Prog 6              # a GM
missionstatus Zilart 3                  # a GM
trigger Gilgamesh                       # 234
finish option=4                         # completed
