# Testing the Waters (ToAU 34). Naja's trigger (3132). Arrapago Reef: the first walk, with the Ephramadian Gold Coin
# and the must-zone var set, comes right after the warp and enters no area (the must-zone-alone arm is in
# #mustzone_tick, with ticks and a walk out first); after a rezone: 15 (progress); finished with option 0 (the wrong
# answer): must zone, Status 0; the area again: nothing (the must-zone var is set); after leaving the zone and coming
# back: 15, finished with option 1: Status 1 and a move to Talacca Cove; its zone-in 106, finished: completed (the
# Percipient Eye, the Treasure Trove Tender title, the coin taken).
lists AhtUrhganWhitegate/Naja_Salaheem/onTrigger ArrapagoReef/onTriggerAreaEnter/1 ArrapagoReef/onEventFinish/15 TalaccaCove/onZoneIn/1 TalaccaCove/onEventFinish/106
char zone=AhtUrhganWhitegate pos=40,-6,-30 job=WAR lvl=75 nation=1
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Toau TestingTheWaters current
keyitem EphramadianGoldCoin
login
tick 1000
tick 1000
tick 1000
trigger Naja_Salaheem                   # 3132
finish-if-event
warp -463.026,-2,-394.478 ArrapagoReef
charvar Mission[4][33]mustZone 1
walk -458,-2,-400                       # must zone alone: nothing
walk -463.026,-2,-394.478
rezone
tick 1000
tick 1000
tick 1000
walk -458,-2,-400                       # 15
finish option=0                         # the wrong answer: must zone
walk -463.026,-2,-394.478
walk -458,-2,-400                       # nothing
walk -463.026,-2,-394.478
warp 40,-6,-30 AhtUrhganWhitegate   # out of the zone: the flag clears
tick 1000
warp -463.026,-2,-394.478 ArrapagoReef
tick 1000
walk -458,-2,-400                       # 15
tick 1000
finish option=1                         # Status 1, to Talacca Cove
tick 1000
login open
finish                                  # 106: completed
