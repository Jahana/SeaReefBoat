# Ark Angels 1 (index 0), at Zilart status 1 with the Shard of Apathy not held. qm1_1 opens the menu; option 0 is
# ignored and another fight's option not offered; this one's option enters area 1 (the framework's entry texts). Killing
# the Ark Angel wins (its group's all-death): 32001, whose finish is the mission's, giving the Shard of Apathy.
lists LaloffAmphitheater/qm1_1/onTrigger LaloffAmphitheater/onEventUpdate/32000 LaloffAmphitheater/onEventFinish/32000 LaloffAmphitheater/onEventFinish/32001 LaloffAmphitheater/onEventFinish/32002 LaloffAmphitheater/qm2/onTrigger LaloffAmphitheater/onEventFinish/32003
char zone=LaloffAmphitheater pos=-603.563,-22.681,483.937 job=WAR lvl=99 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart ArkAngels current
login
missionstatus Zilart 1                  # a GM
effect 50                               # a GM: Invincible
effect 522
effect 49
trigger qm1_1                           # the menu
update 32000 option=0                   # ignored
update 32000 option=17                  # not offered
update 32000 option=1                  # index 0, area 1: entered
finish
tick 2000
kill ARK_ANGEL_HM                     # won: 32001
finish                                  # the mission's: the ShardOfApathy
tick 11000
tick 10000
