# Out of the Depths (bastok 75): Ayame in the Metalworks, Ravorara in Port Bastok, Brakobrik in Oldton Movalpolos,
# Pavvke in Bastok Mines. The guard (Bastok fame level 3), the offer 859 (option 3 begins it), Ayame's 860 reminder
# (setPriority 101), Ravorara's 307 (Prog 1) and 308, Brakobrik's cutscene 2 (option 2: Prog 2) and KILLING_BOMBS,
# Pinches of Hoary Bomb Ash (1 to 4 without that count's KI: cutscene 4, whose option gives the KI Dusty Tome / Pointed
# Jug / Cracked Club / Peeling Hairpin; with it: cutscene 4 (0, 0, 0, 0, 1), option 6 takes the ash,
# REFUSES_TO_GIVE_ANOTHER; five: nil), each KI shown to Ravorara in order (309: option n takes it for n x 100 gil and
# sets bit n-1 of Option), at Option 15 two ash without and with the jug, one ash without the tome (cutscene 4 (5, 4, 1,
# 1, 0): option 1 gives the tome, Prog unchanged) and with it ((5, 4, 1, 1, 1): option 5, KI Old Nametag, Prog 3),
# Ravorara at Prog 3 with KIs (309), without the nametag (GM: 308) and with it (309, option 5: Prog 4), 311 at Prog 4
# (also with a KI, GM), Pavvke's 238 (setPriority 1005: completed, 1200 gil, Trash Collector, fame +80).
# The cutscene options are the client's: the flow sends each one the Lua tests (the comments say which the real client
# would send). Defaults: Ayame 701, Ravorara 310, Brakobrik NO_FIRES_NO_BOMBS, Pavvke 75. Shared: Ayame is A Question of
# Faith's (C#: needs this quest completed and fame level 4), Faded Promises' (C#: NIN), MNK AF3's, Trust: Bastok's and
# Bastok 2-1 / 3-1's; Pavvke is Fallen Comrades' (C#: offers 90 from fame level 2, below 238's priority 1005; this flow
# sets it completed so the other probes at Pavvke stay clean), The Eleventh's Hour's and 5-2 / 8-2's. A Question of
# Faith's offer 875 at Ayame follows the completion only at fame level 4 (this char stays at level 3).
lists Metalworks/Ayame/onTrigger Metalworks/Ayame/onTrade Metalworks/onEventFinish/859 PortBastok/Ravorara/onTrigger PortBastok/onEventFinish/307 PortBastok/onEventFinish/309 OldtonMovalpolos/Brakobrik/onTrigger OldtonMovalpolos/Brakobrik/onTrade OldtonMovalpolos/onEventFinish/2 OldtonMovalpolos/onEventFinish/4 BastokMines/Pavvke/onTrigger BastokMines/onEventFinish/238
char zone=Metalworks pos=133.9,-19,34.8
fame Bastok 124
quest Bastok.FallenComrades completed
item PinchOfHoaryBombAsh x12
item PinchOfHoaryBombAsh x12
item BoneChip
login
trigger Ayame                        # fame 124 (level 2): not offered, 701
finish-if-event
fame Bastok 125
trade Ayame BoneChip x1              # available: no trade handler, nothing
trigger Ayame                        # fame level 3: the offer, 859
finish                               # option 0: not 3, nothing
trigger Ayame                        # 859 again
finish option=3                      # accepted
trigger Ayame                        # accepted: 860 (setPriority 101)
finish
warp -151,-6,-5.7 PortBastok
trigger Ravorara                     # Prog 0: 307
finish                               # Prog 1
trigger Ravorara                     # Prog 1, no key items: 308
finish
warp 164.6,12,-89.7 OldtonMovalpolos
trade Brakobrik PinchOfHoaryBombAsh x1  # Prog 1: nil
trigger Brakobrik                    # Prog 1: cutscene 2
finish option=1                      # not 2: nothing
trigger Brakobrik                    # cutscene 2 again
finish option=2                      # Prog 2
trigger Brakobrik                    # Prog 2: KILLING_BOMBS
finish-if-event
trade Brakobrik BoneChip x1          # no ash: nil
trade Brakobrik PinchOfHoaryBombAsh x5  # five ash: clamped to 4, the trade does not match 4: nil
trade Brakobrik PinchOfHoaryBombAsh x1  # one ash, no tome, Option 0: cutscene 4 (0, 0, 1)
finish option=1                      # the ash taken, KI Dusty Tome
trade Brakobrik PinchOfHoaryBombAsh x1  # one ash, the tome held: cutscene 4 (0, 0, 0, 0, 1)
finish option=6                      # the ash taken, REFUSES_TO_GIVE_ANOTHER
trade Brakobrik PinchOfHoaryBombAsh x2  # two ash, no jug: cutscene 4 (0, 0, 2)
finish option=2                      # KI Pointed Jug
trade Brakobrik PinchOfHoaryBombAsh x3  # three ash, no club: cutscene 4 (0, 0, 3)
finish option=3                      # KI Cracked Club
trade Brakobrik PinchOfHoaryBombAsh x3  # three ash, the club held: cutscene 4 (0, 0, 0, 0, 1)
finish option=6                      # the ash taken, REFUSES_TO_GIVE_ANOTHER
trade Brakobrik PinchOfHoaryBombAsh x4  # four ash, no hairpin: cutscene 4 (0, 0, 4)
finish option=4                      # KI Peeling Hairpin
trade Brakobrik PinchOfHoaryBombAsh x4  # four ash, the hairpin held: cutscene 4 (0, 0, 0, 0, 1)
finish option=5                      # option 5 with Option 0: nothing, the ash kept
warp -151,-6,-5.7 PortBastok
trigger Ravorara                     # Prog 2, the four key items: 309 for the tome (0, 1, 0, tome)
finish option=0                      # nothing
trigger Ravorara                     # 309 for the tome
finish option=1                      # the tome taken, Option bit 0, 100 gil
trigger Ravorara                     # 309 for the jug
finish option=2                      # bit 1, 200 gil
trigger Ravorara                     # 309 for the club
finish option=3                      # bit 2, 300 gil
trigger Ravorara                     # 309 for the hairpin
finish option=4                      # bit 3, 400 gil: Option 15
trigger Ravorara                     # Prog 2, no key items: 308
finish
warp 164.6,12,-89.7 OldtonMovalpolos
trade Brakobrik PinchOfHoaryBombAsh x2  # two ash, Option 15, no jug: cutscene 4 (0, 0, 2)
finish option=2                      # KI Pointed Jug again
trade Brakobrik PinchOfHoaryBombAsh x2  # the jug held, Option 15, count not 1: cutscene 4 (0, 0, 0, 0, 1)
finish option=6                      # the ash taken, REFUSES_TO_GIVE_ANOTHER
trade Brakobrik PinchOfHoaryBombAsh x1  # one ash, Option 15, no tome: cutscene 4 (5, 4, 1, 1, 0)
finish option=1                      # selection 1: the ash taken, KI Dusty Tome (Prog stays 2)
trade Brakobrik PinchOfHoaryBombAsh x1  # one ash, Option 15, the tome held: cutscene 4 (5, 4, 1, 1, 1)
finish option=5                      # Option 15: the ash taken, KI Old Nametag, Prog 3
trigger Brakobrik                    # Prog 3: nil, NO_FIRES_NO_BOMBS
finish-if-event
trade Brakobrik PinchOfHoaryBombAsh x1  # Prog 3: nil
warp -151,-6,-5.7 PortBastok
trigger Ravorara                     # Prog 3 (<= 3), the tome: 309 for the tome
finish option=1                      # the tome taken, 100 gil
trigger Ravorara                     # 309 for the jug
finish option=2                      # the jug taken, 200 gil
delkeyitem OldNametag                # GM: the nametag gone
trigger Ravorara                     # Prog 3, none of the four, no nametag: 308
finish
keyitem OldNametag                   # GM: the nametag back
trigger Ravorara                     # Prog 3, none of the four, the nametag: 309 (0, 5, 0, nametag)
finish option=5                      # the nametag deleted, Prog 4
trigger Ravorara                     # Prog 4: 311
finish
keyitem DustyTome                    # GM: a key item at Prog 4
trigger Ravorara                     # Prog 4 (not <= 3), the tome: 311
finish
delkeyitem DustyTome
warp 16.6,7,-13.3 BastokMines
trigger Pavvke                       # Prog 4: 238 (setPriority 1005)
finish                               # completed: 1200 gil, Trash Collector, fame +80
trigger Pavvke                       # completed: no handler, 75
finish-if-event
