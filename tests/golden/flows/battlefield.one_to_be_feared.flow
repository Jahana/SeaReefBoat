# One to be Feared (battlefield.one_to_be_feared, Sealion's Den: a BattlefieldMission, index 0, 45 minutes, six players,
# entry NPC _0w0, the airship doors for exit and for the phase changes). A level 75 Warrior of San d'Oria with 6-4
# current at Status 3 (a GM): the menu 32000; area 1 (option 1): entered. Phase 1: five Mammet-22 Zetas; all dead:
# event 10 (the title, healed, back on the airship). The door: 32003; finished with 100: event 1, whose update with
# option 0 spawns Omega; killed: event 11 (title, back on the airship); the door, option 101: event 2, whose update
# spawns Ultima; killed: WON; 32001; finished: the mission's handler (Status 4, set down at the Iron Gate), 1500 XP.
lists SealionsDen/_0w0/onTrigger SealionsDen/Airship_Door/onTrigger SealionsDen/onEventUpdate/32000 SealionsDen/onEventUpdate/1 SealionsDen/onEventUpdate/2 SealionsDen/onEventFinish/32000 SealionsDen/onEventFinish/32001 SealionsDen/onEventFinish/32003 SealionsDen/onEventFinish/10 SealionsDen/onEventFinish/11
char zone=SealionsDen pos=0,0,0 job=WAR lvl=75 nation=0
mission Cop OneToBeFeared current
charvar Mission[6][638]Status 3
login
trigger _0w0                            # the menu 32000
update 32000 option=1                   # index 0, area 1: entered
finish                                  # in the arena
tick 2000                               # phase 1 spawns
kill MAMMET_22_ZETA
kill MAMMET_22_ZETA+1
kill MAMMET_22_ZETA+2
kill MAMMET_22_ZETA+3
kill MAMMET_22_ZETA+4                   # allDeath: event 10
finish                                  # title, healed, to the airship
trigger Airship_Door                    # 32003
finish option=100                       # event 1
update 1 option=0                       # Omega spawns
finish
kill MAMMET_22_ZETA+5                   # event 11
finish                                  # title, to the airship
trigger Airship_Door                    # 32003
finish option=101                       # event 2
update 2 option=0                       # Ultima spawns
finish
kill MAMMET_22_ZETA+6                   # WON: 32001
finish                                  # Status 4
tick 11000
tick 10000
