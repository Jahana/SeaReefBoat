finish                                  # begun
warp 83.1,8.5,-229.1 PortBastok
trigger Suspicious_Galka                # no ring: 418 (INTRO)
finish
trade Suspicious_Galka RabbitHide x1 ChocoboFeather x1 # not exact: nil; nothing
