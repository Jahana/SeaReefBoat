# The Crystal Line (Bastok 2-1): begun in Metalworks. A level 10 Warrior of Bastok (1-1 to 1-3 completed by a GM;
# Resonance current keeps RoV 1-1 out). Malduc: section 1: 1001, finished with 3: Metalworks' own handleAcceptMission
# registration: begun, YOU_ACCEPT_THE_MISSION. Section 2: ORIGINAL_MISSION_OFFSET + 19. Cid at status 0, 505 finished
# with a full inventory: no crystal, the status stays 0; the inventory freed, 505 again: a crystal, status 1.
lists Metalworks/Malduc/onTrigger Metalworks/Cid/onTrigger Metalworks/onEventFinish/1001 Metalworks/onEventFinish/505
char zone=Metalworks pos=64,-14,-4 job=WAR lvl=10 nation=1
mission Rov Resonance current
mission Bastok TheZeruhnReport completed
mission Bastok GeologicalSurvey completed
mission Bastok Fetichism completed
login
trigger Malduc                          # section 1: 1001
finish option=3                         # 3: begun, YOU_ACCEPT_THE_MISSION
trigger Malduc                          # section 2: ORIGINAL_MISSION_OFFSET + 19
warp -12,-12,1 Metalworks
fill-inventory
trigger Cid                             # status 0: 505
finish option=0                         # the inventory full: no crystal, status 0
free-inventory
trigger Cid                             # 505 again
finish option=0                         # a crystal: status 1
trigger Cid                             # status 1: event 502
finish
