# Atop the Highest Mountains (jeuno 129), a level 51 Warrior at cap 55, MAX_LEVEL either side of 60: 59: no section,
# MAAT_DIALOG; 60: 82.
lists RuludeGardens/Maat/onTrigger RuludeGardens/onEventFinish/82
char zone=RuludeGardens pos=12.4,3.1,119.5 job=WAR lvl=51
levelcap 55
setting MAX_LEVEL 59
login
trigger Maat                            # MAX_LEVEL 59: no section; MAAT_DIALOG
setting MAX_LEVEL 60
trigger Maat                            # MAX_LEVEL 60: 82
finish option=0                         # nothing
