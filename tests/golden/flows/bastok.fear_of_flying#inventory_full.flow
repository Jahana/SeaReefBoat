# Fear of Flying with a full inventory: 171 plays, the Black Silk Neckerchief does not fit, the quest stays accepted, the
# egg is kept and Option is not set; once there is room the same trade completes it.
char zone=PortBastok pos=-23.9,4.898,1.9
item SilkwormEgg
quest Bastok.FearOfFlying accepted
login
fill-inventory
trade Kurando SilkwormEgg x1    # 171
finish                          # the inventory full: not completed, the egg kept, no Option
free-inventory
trade Kurando SilkwormEgg x1    # 171 again
finish                          # completed: the neckerchief, fame +30, Airship Denouncer, Option 1
trigger Kurando                 # Option 1: 172
finish                          # Option 0
