# The Mothercrystals completed (CoP, An Invitation West current): section 2. Konschtat's, Tahrongi's and La Theine's
# Shattered_Telepoint play 913, 913 and 202 and replace the default; each finish with 1 does nothing, with 0 sets the char
# down in the Hall of Transference.
lists KonschtatHighlands/Shattered_Telepoint/onTrigger KonschtatHighlands/onEventFinish/913 TahrongiCanyon/Shattered_Telepoint/onTrigger TahrongiCanyon/onEventFinish/913 LaTheinePlateau/Shattered_Telepoint/onTrigger LaTheinePlateau/onEventFinish/202
char zone=KonschtatHighlands pos=135,19,220 job=WAR lvl=75 nation=0
mission Cop AnInvitationWest current
login
trigger Shattered_Telepoint             # 913, replaces the default
finish option=1                         # not 0: nothing
trigger Shattered_Telepoint
finish option=0                         # the Hall (R)
warp -267.194,-40.634,-280.019 HallOfTransference
warp 179,35,255 TahrongiCanyon
trigger Shattered_Telepoint             # 913
finish option=1
trigger Shattered_Telepoint
finish option=0
warp 280.066,-80.635,-67.096 HallOfTransference
warp 334,19,-60 LaTheinePlateau
trigger Shattered_Telepoint             # 202
finish option=1
trigger Shattered_Telepoint
finish option=0
