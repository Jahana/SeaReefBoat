# Ancient Flames Beckon, Dem's exits (battlefield.ancient_flames_beckon_spire_of_dem#exits): the leave NPCs _0j1 to _0j3, one
# per arena. A level 75 Warrior of San d'Oria with Below the Arks current (a GM) enters arena 1, 2 and 3 in turn (option
# 1, 2, 3 of the menu 32000) and leaves each by its exit NPC: 32003, finished with 4: leaveBattlefield(1).
lists SpireOfDem/_0j0/onTrigger SpireOfDem/onEventUpdate/32000 SpireOfDem/_0j1/onTrigger SpireOfDem/_0j2/onTrigger SpireOfDem/_0j3/onTrigger SpireOfDem/onEventFinish/32000 SpireOfDem/onEventFinish/32003
char zone=SpireOfDem pos=0,-3.8,240 job=WAR lvl=75 nation=0
mission Cop BelowTheArks current        # a GM
login
trigger _0j0                            # the menu 32000
update 32000 option=1                   # arena 1: entered
finish                                  # in the arena
trigger _0j1                            # arena 1's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 135,19,220 KonschtatHighlands
warp 0,-3.8,240 SpireOfDem
trigger _0j0                            # the menu 32000
update 32000 option=2                   # arena 2: entered
finish                                  # in the arena
trigger _0j2                            # arena 2's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 135,19,220 KonschtatHighlands
warp 0,-3.8,240 SpireOfDem
trigger _0j0                            # the menu 32000
update 32000 option=3                   # arena 3: entered
finish                                  # in the arena
trigger _0j3                            # arena 3's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 135,19,220 KonschtatHighlands
warp 0,-3.8,240 SpireOfDem
