# Lakeside Minuet (jeuno 95) one level below ADVANCED_JOB_LEVEL (29), ENABLE_WOTG 1: the level alone fails check 1; no
# section; Laila's default 10120.
lists UpperJeuno/Laila/onTrigger
char zone=UpperJeuno pos=-52.5,0,101 job=WAR lvl=29
login
trigger Laila                           # level 29: no section; default 10120
finish
