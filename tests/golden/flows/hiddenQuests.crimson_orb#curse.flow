# Crimson Orb, the Curse I of the fourth pond: a level 75 Warrior (race 1) in Davoi with Prog 2 (a GM) and the ponds
# _45g, _45h, _45i done (Option 7), the Blood Orb held. The fourth pond's finish adds the Curse I (power 50, 600 s) and
# moves to Prog 3. CHECK: the char_effects rows of the effect added and of its expiry, ticked to just before the 600 s
# (590 + 9 s: still there) and past them (a further 2 s: gone).
lists Davoi/_45j/onTrigger Davoi/onEventFinish/53
char zone=Davoi pos=187,-3,-115 job=WAR lvl=75 race=1
charvar HQuest[CrimsonOrb]Prog 2
charvar HQuest[CrimsonOrb]Option 7
keyitem BloodOrb
login
trigger _45j                            # cutscene 53 (0, 3, 1)
finish                                  # Blood -> Cursed; Curse I; ORB + 5; Prog 3
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
tick 30000
