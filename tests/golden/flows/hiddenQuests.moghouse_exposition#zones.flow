# Mog House Exposition, section 2 in every Mog House outside Bastok (Northern San d'Oria is the
# main flow's): a char of nation 1,
# the quest's notSeen 0 and oNation 1 (a GM's
# charvar before each: quest:complete clears it): not the home nation, inside the Mog House: the Moogle's 30001,
# finished: quest:complete (oNation cleared).
lists AlZahbi/Moogle/onTrigger AlZahbi/onEventFinish/30001 AhtUrhganWhitegate/Moogle/onTrigger AhtUrhganWhitegate/onEventFinish/30001 SouthernSanDoriaS/Moogle/onTrigger SouthernSanDoriaS/onEventFinish/30001 BastokMarketsS/Moogle/onTrigger BastokMarketsS/onEventFinish/30001 WindurstWatersS/Moogle/onTrigger WindurstWatersS/onEventFinish/30001 SouthernSanDoria/Moogle/onTrigger SouthernSanDoria/onEventFinish/30001 PortSanDoria/Moogle/onTrigger PortSanDoria/onEventFinish/30001 WindurstWaters/Moogle/onTrigger WindurstWaters/onEventFinish/30001 WindurstWalls/Moogle/onTrigger WindurstWalls/onEventFinish/30001 PortWindurst/Moogle/onTrigger PortWindurst/onEventFinish/30001 WindurstWoods/Moogle/onTrigger WindurstWoods/onEventFinish/30001 RuludeGardens/Moogle/onTrigger RuludeGardens/onEventFinish/30001 UpperJeuno/Moogle/onTrigger UpperJeuno/onEventFinish/30001 LowerJeuno/Moogle/onTrigger LowerJeuno/onEventFinish/30001 PortJeuno/Moogle/onTrigger PortJeuno/onEventFinish/30001 WesternAdoulin/Moogle/onTrigger WesternAdoulin/onEventFinish/30001 EasternAdoulin/Moogle/onTrigger EasternAdoulin/onEventFinish/30001
char zone=BastokMines pos=116.9,-1.6,-72 job=WAR lvl=1 nation=1
login
warp -106.3,0,60 AlZahbi
zoneline AlZahbi                 # into the Mog House
charvar HQuest[moghouseExpo]oNation 1  # a GM
trigger Moogle                          # not the home nation, oNation 1: 30001
finish                                  # complete: oNation cleared
