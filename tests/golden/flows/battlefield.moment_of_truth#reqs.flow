# Moment of Truth (battlefield.moment_of_truth#reqs, Jade Sepulcher): All four chars are refused; each gets
# NO_BATTLEFIELD_ENTRY 7377 (the framework's trigger), then the entry NPC's default 32767 (DefaultActions.lua): main at
# Prog 2, bob accepted at Prog 5, cat available at Prog 4, dan completed at Prog 4.
lists JadeSepulcher/_1v0/onTrigger
char zone=JadeSepulcher pos=300,-2.517,-198.5 job=WAR lvl=75
char bob zone=JadeSepulcher pos=300,-2.517,-198.5 job=WAR lvl=75
char cat zone=JadeSepulcher pos=300,-2.517,-198.5 job=WAR lvl=75
char dan zone=JadeSepulcher pos=300,-2.517,-198.5 job=WAR lvl=75
quest AhtUrhgan.MomentOfTruth accepted
charvar Quest[6][30]Prog 2
bob: quest AhtUrhgan.MomentOfTruth accepted
bob: charvar Quest[6][30]Prog 5
cat: charvar Quest[6][30]Prog 4
dan: quest AhtUrhgan.MomentOfTruth completed
dan: charvar Quest[6][30]Prog 4
login
bob: login
cat: login
dan: login
trigger _1v0
bob: trigger _1v0
cat: trigger _1v0
dan: trigger _1v0
