# Atop the Highest Mountains (jeuno 129), a level 51 Warrior, the level cap alone either side of 55 (a GM's
# setLevelCap): cap 54 and cap 56: no section (no other limit break answers), MAAT_DIALOG; cap 55: 82.
lists RuludeGardens/Maat/onTrigger RuludeGardens/onEventFinish/82
char zone=RuludeGardens pos=12.4,3.1,119.5 job=WAR lvl=51
levelcap 54
login
trigger Maat                            # cap 54: no section; MAAT_DIALOG
levelcap 56                             # a GM
trigger Maat                            # cap 56: no section; MAAT_DIALOG
levelcap 55                             # a GM
trigger Maat                            # cap 55: 82
finish option=0                         # nothing
