# The Road Forks, another mission current (mission.cop.the_road_forks#other). Ancient Vows (2-5) current with 3-3's two
# statuses at 1 and 1 (GMs): Northern San d'Oria's Arnau, Windurst Waters' Ohbiru-Dohbiru and Metalworks Cid answer
# nothing for this mission.
lists NorthernSanDoria/Arnau/onTrigger WindurstWaters/Ohbiru-Dohbiru/onTrigger Metalworks/Cid/onTrigger
char zone=NorthernSanDoria pos=148,0,139 job=WAR lvl=75 nation=0
mission Cop AncientVows current
login
missionstatus Cop 1 pos=0               # a GM
missionstatus Cop 1 pos=1               # a GM
trigger Arnau                           # nothing
finish-if-event
warp 23,-5,-190 WindurstWaters
trigger Ohbiru-Dohbiru                  # nothing
finish-if-event
warp 0,0,0 Metalworks
trigger Cid                             # nothing
finish-if-event
