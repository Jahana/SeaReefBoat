# Cid's Secret with a full inventory: 509 plays, the Ram Mantle does not fit, the quest stays accepted and the letter
# is kept; once there is room the same 509 completes it.
char zone=Metalworks pos=-14,-11,0
keyitem UnfinishedLetter
quest Bastok.CidsSecret accepted
login
fill-inventory
trigger Cid                    # the letter: 509
finish                         # the inventory full: not completed, the letter kept
free-inventory
trigger Cid                    # 509 again
finish                         # completed: Ram Mantle, fame +40, the letter deleted
