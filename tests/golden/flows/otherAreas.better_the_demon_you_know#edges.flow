# Better the Demon You Know (otherAreas 105): the edges. For the Birds completed with its mustZone (a GM: 11): Better
# off: For's 19. Cleared (a GM): 20, option 1: begun. Prog 1 (a GM): Wait one second past now (1800000001): 23; Wait now
# (1800000000, the harness clock right after the login): 24 (>=), finished: Prog 2. Prog 4 and -1 (GMs): nil (13). A pen
# and a feather at Prog 2 (tradeHas: not exact): 22, finished: the pen taken (the feather kept), Prog 1 (back from 2), a
# new Wait. A feather alone: nil. The qm2 at Prog 1: nil; NMKilled 1 at Prog 1 (a GM localvar): nil. The qm2 at Prog 2
# (a GM), none up: the five spawned. The four demons killed (their deaths: no handler), their corpses gone: only the
# Marquis up: nil. The Marquis killed at Prog 1 (a GM): no NMKilled; gone: the five spawned again (NMKilled 0). Killed
# at Prog 3: no NMKilled; gone: nil at Prog 3, the five again at Prog 2. Killed at Prog 2: NMKilled 1; a warp out and
# back clears it: the five again, no earplug. Koblakiq Prog 3 with a full inventory: 26, finished: complete false: the
# earplug kept, still accepted; with room: completed.
# Only the Marquis' operand of the qm2's spawn check is shown here: his mob script's onMobDeath (and onMobDespawn)
# despawns the four demons, so no demon is ever up without him; the demons' operands are left to XI.Verify.Quests (`oa
# g8 spawns`). The char is level 99, so the demons (47-52) do not kill it over the corpse waits.
lists OldtonMovalpolos/Koblakiq/onTrigger OldtonMovalpolos/Koblakiq/onTrade OldtonMovalpolos/onEventFinish/20 OldtonMovalpolos/onEventFinish/22 OldtonMovalpolos/onEventFinish/24 OldtonMovalpolos/onEventFinish/26 CastleZvahlBaileys/qm2/onTrigger CastleZvahlBaileys/Marquis_Andrealphus/onMobDeath
char zone=OldtonMovalpolos pos=-63.4,22.8,-117.5 job=WAR lvl=99
quest OtherAreas.MissionaryMoblin completed
quest OtherAreas.ForTheBirds completed
charvar Quest[4][104]mustZone 11
item DemonPen
item ChocoboFeather x2
login
trigger Koblakiq                        # Better off (For's mustZone): For's 19
finish
charvar Quest[4][104]mustZone 0         # a GM
trigger Koblakiq                        # 20
finish option=1                         # begun
charvar Quest[4][105]Prog 1             # a GM
charvar Quest[4][105]Wait 1800000001    # a GM: one second past now
trigger Koblakiq                        # Prog 1, now < Wait: 23
finish
charvar Quest[4][105]Wait 1800000000    # a GM: now
trigger Koblakiq                        # now >= Wait: 24
finish                                  # Prog 2
charvar Quest[4][105]Prog 4             # a GM
trigger Koblakiq                        # Prog 4: nil; 13
finish
charvar Quest[4][105]Prog -1            # a GM
trigger Koblakiq                        # Prog -1: nil; 13 (not 21)
finish
charvar Quest[4][105]Prog 2             # a GM
trade Koblakiq ChocoboFeather x1        # no pen: nil; nothing
trade Koblakiq DemonPen x1 ChocoboFeather x1 # a pen and a feather, Prog 2: 22
finish                                  # the pen taken, the feather kept; Prog 1; Wait now + 60
warp 20.9,-24.1,19.2 CastleZvahlBaileys
trigger qm2                             # Prog 1: nil; YOU_FIND_NOTHING
localvar NMKilled 1                     # a GM
trigger qm2                             # NMKilled 1 but Prog 1: nil; YOU_FIND_NOTHING
localvar NMKilled 0                     # a GM
charvar Quest[4][105]Prog 2             # a GM
trigger qm2                             # Prog 2, none up: five spawned; MOBLIN_EARPLUG_ON_THE_GROUND; MARQUIS_ATTACKS
kill MARQUIS_ANDREALPUS+1               # the demons' deaths: no quest handler
kill MARQUIS_ANDREALPUS+2
kill MARQUIS_ANDREALPUS+3
kill MARQUIS_ANDREALPUS+4
tick 15000                              # the corpses despawning
tick 15000
tick 15000
trigger qm2                             # Prog 2, only the Marquis up, no NMKilled: nil; YOU_FIND_NOTHING
charvar Quest[4][105]Prog 1             # a GM
kill MARQUIS_ANDREALPUS                 # Prog 1: no NMKilled
charvar Quest[4][105]Prog 2             # a GM
tick 15000
tick 15000
tick 15000
trigger qm2                             # NMKilled 0, none up: five spawned (no earplug)
charvar Quest[4][105]Prog 3             # a GM
kill MARQUIS_ANDREALPUS                 # Prog 3: no NMKilled; the demons despawned
tick 15000
tick 15000
tick 15000
trigger qm2                             # Prog 3, none up: nil; YOU_FIND_NOTHING
charvar Quest[4][105]Prog 2             # a GM
trigger qm2                             # NMKilled 0, none up: five spawned (no earplug)
kill MARQUIS_ANDREALPUS                 # Prog 2: NMKilled 1; the demons despawned
warp -63.4,22.8,-117.5 OldtonMovalpolos # the zone change clears the local NMKilled
warp 20.9,-24.1,19.2 CastleZvahlBaileys
tick 15000
tick 15000
tick 15000
trigger qm2                             # NMKilled 0, none up: five spawned again; no earplug
charvar Quest[4][105]Prog 3             # a GM
keyitem ZeelozoksEarplug                # a GM
warp -63.4,22.8,-117.5 OldtonMovalpolos
fill-inventory
trigger Koblakiq                        # Prog 3: 26
finish                                  # no room: complete false; the earplug kept
free-inventory
trigger Koblakiq                        # 26 again
finish                                  # completed; the earplug taken
