finish option=0                         # the quest's 118 finish again: Wait = 8001
charvar Quest[3][15]Wait 0              # a GM
wait vana=12                            # 17:00
trigger Zauko                           # hour 17, the card, Wait 0: 118 (1)
finish option=0                         # Wait = 8001
wait vana=1                             # 18:00
