# Below the Arks, the arms the crag flows leave (CoP 1-2). Status 1 (a GM). With the light of Dem held (a GM): the
# Konschtat telepoint is the plain 913 (no flag); finished with 0, the Hall. With the lights of Holla and Mea (two
# lights) and Option 3 (a GM): Konschtat's 913 with the flag 0 (not the seal: two lights). Promyvion - Dem with Option 3:
# the zone-in plays nothing. In the Hall: _0e3 with Option 3 (not crag 1) and with two lights: nothing from the mission.
# Status 0 (a GM): Konschtat's telepoint: nothing from the mission (the Status guard). Last, 1-3's section
# does not apply: the Hall's zone-in (always 108). Pherimociel at Status 1 and Monberaux at Status 1: his script.
lists KonschtatHighlands/Shattered_Telepoint/onTrigger KonschtatHighlands/onEventFinish/913 HallOfTransference/_0e3/onTrigger HallOfTransference/onZoneIn/1 PromyvionDem/onZoneIn/1 UpperJeuno/Monberaux/onTrigger
char zone=KonschtatHighlands pos=135,19,220 job=WAR lvl=75 nation=0
mission Cop BelowTheArks current
charvar Mission[6][118]Status 1
login
keyitem LightOfDem                      # a GM
trigger Shattered_Telepoint             # the light of Dem held: 913, no args
finish option=0                         # setPos to the Hall of Transference
warp -267.194,-40.634,-280.019 HallOfTransference
delkeyitem LightOfDem                   # a GM
keyitem LightOfHolla                    # a GM
keyitem LightOfMea                      # a GM
charvar Mission[6][118]Option 3         # a GM
warp 135,19,220 KonschtatHighlands
trigger Shattered_Telepoint             # Option 3, two lights: 913 with the flag 0
finish option=1
warp 185.891,0,-52.331 PromyvionDem     # Option 3: no event
warp -236.3,-4.9,290 HallOfTransference
trigger _0e3                            # Option 3, crag 1, two lights: nothing from the mission
charvar Mission[6][118]Status 0         # a GM
warp 135,19,220 KonschtatHighlands
trigger Shattered_Telepoint             # Status 0: nothing from the mission
