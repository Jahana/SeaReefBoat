finish
trade Totoroon BowlOfSutlac x1 BoneChip x1   # not exactly the Sutlac: nil: nothing
finish-if-event
trade Totoroon BowlOfSutlac x1          # 304
finish                                  # the Sutlac taken; Prog 3
warp 24.2,-7.804,-45.591 AhtUrhganWhitegate
trigger Naja_Salaheem                   # a new zone-in: Prog 3: 5058
finish
trigger Naja_Salaheem                   # once per zone: nothing
finish-if-event
