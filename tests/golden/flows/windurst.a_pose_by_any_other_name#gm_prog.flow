# A Pose By Any Other Name (windurst 7): a GM's Prog that is no pose body (5: poseGear has no entry for it), in time.
# The body worn (none, 0) is not 5, so 94 with poseGear[5], nil, as its first argument.
lists WindurstWaters/Angelica/onTrigger
char zone=WindurstWaters pos=-63.1,-9.25,-8.85
quest Windurst.APoseByAnyOtherName accepted
charvar Quest[2][7]Prog 5
charvar Quest[2][7]Wait 1800003600
login
trigger Angelica                    # in time, no body: 94 (poseGear[5] = nil, harness, robe, tunic, vest, robe, kenpogi)
finish
