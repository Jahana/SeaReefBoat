# Whence Blows the Wind (jeuno 130), a level 56 Warrior at cap 60, MAX_LEVEL either side of 65: 64: no section,
# MAAT_DIALOG; 65: 85.
lists RuludeGardens/Maat/onTrigger RuludeGardens/onEventFinish/85
char zone=RuludeGardens pos=12.4,3.1,119.5 job=WAR lvl=56
levelcap 60
setting MAX_LEVEL 64
login
trigger Maat                            # MAX_LEVEL 64: no section; MAAT_DIALOG
setting MAX_LEVEL 65
trigger Maat                            # MAX_LEVEL 65: 85
finish option=0                         # nothing
