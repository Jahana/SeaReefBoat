# Hat in Hand (windurst 0): 48's finish reads no status. Available with All At Sea's Prog var 0: 48; the quest set
# accepted by a GM inside the event; option 1: player:addQuest (already current: no change) and the New Model Hat
# (npcUtil.giveKeyItem, KEYITEM_OBTAINED) all the same.
char zone=WindurstWaters pos=-65.0,-2.9,-145.7 job=WAR lvl=75
login
trigger Baren-Moren                     # available, Prog 0: 48
quest Windurst.HatInHand accepted       # a GM inside the event
finish option=1                         # the New Model Hat (no status read)
