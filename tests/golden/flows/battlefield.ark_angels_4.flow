# Ark Angels 4 (index 3), at Zilart status 1 with the Shard of Arrogance not held. qm1_4 opens the menu; option 0 is
# ignored and another fight's option not offered; this one's option enters area 1 (the framework's entry texts). Killing
# the Ark Angel wins (its group's all-death): 32001, whose finish is the mission's, giving the Shard of Arrogance.
lists LaloffAmphitheater/qm1_4/onTrigger LaloffAmphitheater/onEventUpdate/32000 LaloffAmphitheater/onEventFinish/32000 LaloffAmphitheater/onEventFinish/32001 LaloffAmphitheater/onEventFinish/32002 LaloffAmphitheater/qm2/onTrigger LaloffAmphitheater/onEventFinish/32003
char zone=LaloffAmphitheater pos=237.15,-173.572,361.266 job=WAR lvl=99 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart ArkAngels current
login
missionstatus Zilart 1                  # a GM
effect 50                               # a GM: Invincible
effect 522
effect 49
trigger qm1_4                           # the menu
update 32000 option=0                   # ignored
update 32000 option=65                  # not offered
update 32000 option=49                  # index 3, area 1: entered
finish
tick 2000
kill ARK_ANGEL_EV                     # won: 32001
finish                                  # the mission's: the ShardOfArrogance
tick 11000
tick 10000
