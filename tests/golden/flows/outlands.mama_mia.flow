finish                                  # confirmed; MamaMia_date = JstMidnight()
trigger Mamaulabion                     # before the date: 196
finish
charvar MamaMia_date 1800000001         # a GM: one second past GetSystemTime()
trigger Mamaulabion                     # still before the date: 196
finish
charvar MamaMia_date 1800000000         # a GM: GetSystemTime() itself
fill-inventory
trigger Mamaulabion                     # not before the date: 197
finish                                  # no free slot: ITEM_CANNOT_BE_OBTAINED (14625)
free-inventory
trigger Mamaulabion                     # 197
finish                                  # the Evoker's Ring; fame +40; completed; tradesMamaMia 0
