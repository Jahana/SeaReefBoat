# Riding on the Clouds (jeuno 131): MAX_LEVEL either side of 70 (a setting), a level 61 Warrior at level cap 65:
# MAX_LEVEL 69: no section; MAAT_DIALOG; MAX_LEVEL 70: 88, finished with option 1 (begun).
lists RuludeGardens/Maat/onTrigger RuludeGardens/onEventFinish/88
char zone=RuludeGardens pos=12.4,3.1,119.5 job=WAR lvl=61
levelcap 65
setting MAX_LEVEL 69
login
trigger Maat                            # MAX_LEVEL 69: no section; MAAT_DIALOG
setting MAX_LEVEL 70
trigger Maat                            # MAX_LEVEL 70: the vars drawn; 88
finish option=1                         # begun
