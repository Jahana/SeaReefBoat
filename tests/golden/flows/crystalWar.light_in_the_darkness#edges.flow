lists BastokMarketsS/Gentle_Tiger/onTrigger BastokMarketsS/Engelhart/onTrigger BastokMarketsS/Pagdako/onTrigger BastokMarketsS/Blatherix/onTrigger BastokMarketsS/Blatherix/onTrade BastokMarketsS/onEventFinish/16 BastokMarketsS/onEventFinish/23 BastokMarketsS/onEventFinish/27
char zone=BastokMarketsS pos=-202.432,-9.998,2.237 job=WAR lvl=99 gil=1000
