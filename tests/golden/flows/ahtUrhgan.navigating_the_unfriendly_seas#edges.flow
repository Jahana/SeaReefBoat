bob: quest AhtUrhgan.EquippedForAllOccasions accepted
carl: quest AhtUrhgan.LuckOfTheDraw completed
carl: quest AhtUrhgan.EquippedForAllOccasions completed
dan: quest AhtUrhgan.LuckOfTheDraw completed
dan: quest AhtUrhgan.EquippedForAllOccasions completed
login
bob: login
bob: trigger qm6                        # Equipped accepted (Prog 0: its qm6 nil): NOTHING_OUT_OF_ORDINARY
bob: finish-if-event
bob: logout
carl: login
carl: trigger qm6                       # a Warrior: NOTHING_OUT_OF_ORDINARY
carl: finish-if-event
carl: logout
dan: login
dan: trigger qm6                        # level 49: NOTHING_OUT_OF_ORDINARY
dan: finish-if-event
setting AF2_QUEST_LEVEL 49.4
dan: trigger qm6                        # 49 < 49.4 (the setting read as a number): NOTHING_OUT_OF_ORDINARY
dan: finish-if-event
setting AF2_QUEST_LEVEL 50
dan: logout
trade Leypoint Hydrogauge x1            # Prog 0: nil
charvar Quest[6][25]Prog 3              # a GM
trade Leypoint Hydrogauge x1            # Prog 3: nil
trigger Leypoint                        # Prog 3: nil: LEYPOINT
finish-if-event
charvar Quest[6][25]Prog 0              # a GM
warp -13.187,0,25.114 Nashmau
trade Leleroon Hydrogauge x1            # Prog 0, a gauge: 283
charvar Quest[6][25]Prog 2              # a GM, 283 open
finish                                  # 283 at Prog 2: nothing (Prog 2 kept)
trigger Leleroon                        # Prog 2: 292
finish
charvar Quest[6][25]Prog 3              # a GM
warp 470.267,-12.292,111.817 ArrapagoReef
charvar Quest[6][25]Prog 4              # a GM
trigger qm6                             # Prog 4: nil: NOTHING_OUT_OF_ORDINARY
finish-if-event
charvar Quest[6][25]Prog 3              # a GM
fill-inventory
trigger qm6                             # Prog 3: 233
finish                                  # the culottes do not fit: complete false (unread): nothing
free-inventory
trigger qm6                             # 233
finish                                  # completed
