# Past Perfect accepted with the orders: Evi's 131 with a full inventory (the Scale Mail does not fit: not completed, the
# orders kept), then with room (completed).
lists PortBastok/Evi/onTrigger PortBastok/onEventFinish/131
char zone=PortBastok pos=-4.6,-2.1,3.2
quest Bastok.PastPerfect accepted
keyitem TatteredMissionOrders
login
fill-inventory
trigger Evi                          # 131
finish                               # the inventory full: not completed, the orders kept
free-inventory
trigger Evi                          # 131 again
finish                               # completed
