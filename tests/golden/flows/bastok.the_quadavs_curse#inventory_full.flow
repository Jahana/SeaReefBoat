# The Quadav's Curse with a full inventory: 81 plays, the Bronze Subligar does not fit, the quest stays accepted and the
# backplate is kept; once there is room the same trade completes it.
char zone=PortBastok pos=90.9,-8.772,33.5
item QuadavBackplate
quest Bastok.TheQuadavsCurse accepted
login
fill-inventory
trade Corann QuadavBackplate x1 # 81
finish                          # the inventory full: not completed, the backplate kept
free-inventory
trade Corann QuadavBackplate x1 # 81 again
finish                          # completed: Bronze Subligar, fame +20
