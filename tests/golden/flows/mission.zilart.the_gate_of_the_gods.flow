# The Gate of the Gods (Zilart 13), current. The zone-in to Ru'Aun Gardens plays 51, whose finish completes the mission
# (Ark Angels next); the next zone-in plays nothing.
lists RuaunGardens/onZoneIn/1 RuaunGardens/onEventFinish/51
char zone=HallOfTheGods pos=0,-20,145 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart TheGateOfTheGods current
login
warp -1,-55,-637 RuaunGardens open      # 51
finish                                  # completed
warp -1,-55,-637 RuaunGardens open      # Ark Angels current: nothing
