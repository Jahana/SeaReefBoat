trigger Taillegeas                      # available: 10057 (P, a draw) against 10235 (P)
finish option=10                        # not begun; Cherukiki not learned
quest Jeuno.DucalHospitality accepted   # a GM
charvar Quest[3][68]ItemSet 2           # a GM
trigger Taillegeas                      # accepted: 10059 (P) against 10235 (P)
finish
quest Jeuno.DucalHospitality completed  # a GM
charvar Quest[3][68]ItemSet 0           # a GM
charvar Quest[3][68]mustZone 243        # a GM: the mustZone
trigger Taillegeas                      # completed, the mustZone: 10060 (P) against 10235 (P); 10235 plays (the tie goes to it), 10060 on the next trigger
finish
trigger Taillegeas                      # the mustZone again: the last event was 10235, so the tie rotates to the other container; 10060 as a progressEvent wins it, as an event it would lose
finish
charvar Quest[3][68]ItemSet 3           # a GM
trigger Taillegeas                      # ItemSet 3: 10059 (P) against 10235 (P)
finish
charvar Quest[3][68]ItemSet 0           # a GM
warp -55.5,8.2,97.5 UpperJeuno          # another zone: the mustZone cleared
warp 29.5,2,58 RuludeGardens
trigger Taillegeas                      # completed, no set, no mustZone: 10057 (P, a draw) against 10235 (P)
finish option=10                        # ItemSet 0 (the completed finish); Cherukiki not learned
