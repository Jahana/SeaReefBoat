# build output
bin/
obj/
.vs/
*.user

# oracle harness build artefacts (sources, .bat and golden files are kept)
oracle/*.obj
oracle/*.exe
oracle/*.dll
oracle/*.pdb
oracle/*.ilk
oracle/*_build.log
oracle/build.log

# agent worktrees
.claude/

# server runtime files copied from the C++ server that stay out of git: the nav / collision meshes (735 MB,
# H:\023-FFXI-server\server\navmeshes and ximeshes) and the TLS keys, which login / profile make on first start
*.key
*.cert

# published hosts (README.md: Running)
run/

# the hosts' log files (log/<server>-server.log) and crash dumps (dmp/, main.GENERATE_CORE_DUMP)
log/
dmp/

# local settings overrides (settings/default holds the defaults)
settings/*.lua
