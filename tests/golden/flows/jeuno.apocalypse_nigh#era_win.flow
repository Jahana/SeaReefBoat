# Apocalypse Nigh (jeuno 89) with its era module (xi.pre(xi.expansion.TVR): RESTRICT_CONTENT 1, ENABLE_TVR 0): the
# module's copy of state 2's Empyreal Paradox 32001 finish, whose Timer is JstMidnight() (1800025200: the next JST
# midnight after the wall clock 1800000000) where the quest has VanadielUniqueDay() + 1. Each arm a real win of the
# Apocalypse Nigh battlefield (index 1, areas 1 to 3), three level 75 Warriors by TR_Entrance, accepted at Prog 3 (GMs):
# - main, area 1: the win: Prog 4, Timer 1800025200; the set-down's zone-in at Prog 4: 7 (answered: Breaker of the
#   Chains, set down in Al'Taieu);
# - p2, area 2: battlefieldWin 1056 (a GM): nothing;
# - p3, area 3: battlefieldWin 1058: nothing;
# - p2 again (area 2, once its battlefield has closed): Prog 2 (a GM): nothing;
# - p3 again (area 3): Prog 4 (a GM): nothing (no Timer).
module modules/era/lua/quests/jeuno/apocalypse_nigh.lua
lists EmpyrealParadox/TR_Entrance/onTrigger EmpyrealParadox/onEventFinish/32001
char zone=EmpyrealParadox pos=541.5,-1.2,-597.7 job=WAR lvl=75
char p2 zone=EmpyrealParadox pos=541.5,-1.2,-597.7 job=WAR lvl=75
char p3 zone=EmpyrealParadox pos=541.5,-1.2,-597.7 job=WAR lvl=75
setting RESTRICT_CONTENT 1
setting ENABLE_TVR 0
quest Jeuno.ApocalypseNigh accepted
charvar Quest[3][89]Prog 3
p2: quest Jeuno.ApocalypseNigh accepted
p2: charvar Quest[3][89]Prog 3
p3: quest Jeuno.ApocalypseNigh accepted
p3: charvar Quest[3][89]Prog 3
login
trigger TR_Entrance                     # Prog 3: the 32000 menu
update 32000 option=17                  # index 1, area 1: registered, entered
finish
kill KAMLANAUT
kill KAMLANAUT+1                        # won: battlefieldWin 1057, 32001 opens
finish                                  # the module's 32001: Prog 4, Timer = JstMidnight(); the set-down
tick 400
login                                   # the zone-in at Prog 4: 7, answered: Breaker of the Chains, set down in Al'Taieu
tick 400
login                                   # in Al'Taieu
p2: login
p2: trigger TR_Entrance                 # Prog 3: the 32000 menu
p2: update 32000 option=18              # area 2: registered, entered
p2: finish
p2: kill KAMLANAUT+2
p2: kill KAMLANAUT+3                    # won, 32001 opens
p2: localvar battlefieldWin 1056        # a GM
p2: finish                              # the module's 32001, battlefieldWin 1056: nothing; the set-down
tick 400
p2: login
p3: login
p3: trigger TR_Entrance                 # Prog 3: the 32000 menu
p3: update 32000 option=19              # area 3: registered, entered
p3: finish
p3: kill KAMLANAUT+4
p3: kill KAMLANAUT+5                    # won, 32001 opens
p3: localvar battlefieldWin 1058        # a GM
p3: finish                              # battlefieldWin 1058: nothing; the set-down
tick 400
p3: login
tick 10000                              # the battlefields close
p2: trigger TR_Entrance                 # Prog 3: the 32000 menu
p2: update 32000 option=18              # area 2 again
p2: finish
p2: kill KAMLANAUT+2
p2: kill KAMLANAUT+3                    # won, 32001 opens
p2: charvar Quest[3][89]Prog 2          # a GM, while 32001 is open
p2: finish                              # the module's 32001, Prog 2: nothing; the set-down
tick 400
p2: login
p3: trigger TR_Entrance                 # Prog 3: the 32000 menu
p3: update 32000 option=19              # area 3 again
p3: finish
p3: kill KAMLANAUT+4
p3: kill KAMLANAUT+5                    # won, 32001 opens
p3: charvar Quest[3][89]Prog 4          # a GM, while 32001 is open
p3: finish                              # the module's 32001, Prog 4: nothing (no Timer); the set-down
tick 400
p3: login                               # the zone-in at Prog 4: 7, answered: Breaker of the Chains, set down in Al'Taieu
