# New Worlds Await (jeuno 133), the level cap alone either side of 75 (a GM's setLevelCap): a level 75 Warrior with the
# Limit Breaker, available. Cap 74 and cap 76: no section (no other limit break answers at either: Expanding Horizons
# wants New Worlds Await completed), the default 10045 (0, 0, 2, 0); cap 75: 10045 (75, 1, 1, 0).
lists RuludeGardens/Nomad_Moogle/onTrigger RuludeGardens/onEventFinish/10045
char zone=RuludeGardens pos=10.0,1.5,119.9 job=WAR lvl=75
keyitem LimitBreaker
levelcap 74
login
trigger Nomad_Moogle                    # cap 74: no section; the default 10045 (0, 0, 2, 0)
finish
levelcap 76                             # a GM
trigger Nomad_Moogle                    # cap 76: no section; the default 10045 (0, 0, 2, 0)
finish
levelcap 75                             # a GM
trigger Nomad_Moogle                    # cap 75: 10045 (75, 1, 1, 0)
finish option=0                         # nothing
