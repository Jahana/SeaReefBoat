# Beyond Infinity (jeuno 137): the 32001 handler's other sides, in Horlais Peak (by BC_Entrance), three level 91 Warriors
# at level cap 95 with the Soul Gem Clasp, MAX_LEVEL 99, one per area (the fights of one zone run side by side):
# - main, accepted (a GM): area 1 won (battlefieldWin 20), then a GM sets battlefieldWin 85 (Waughroon Shrine's fight):
#   the 32001 finish: nothing (no scroll, Prog 0): only the fight id differs;
# - p1, accepted with Prog 1 (a GM): area 2 won (battlefieldWin 20, this arena's: the char is accepted): state 3 wants
#   Prog 0: nothing (no scroll, Prog 1): only Prog differs;
# - done, completed (a GM; the battlefield lets status >= accepted in, the cutscene skippable): area 3 won
#   (battlefieldWin not set while completed), then a GM sets battlefieldWin 20 (this arena's): state 3 wants the quest
#   accepted: nothing (no scroll): only the status differs.
lists HorlaisPeak/BC_Entrance/onTrigger HorlaisPeak/onEventFinish/32001
char zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=91
char p1 zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=91
char done zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=91
levelcap 95
quest Jeuno.BeyondInfinity accepted
keyitem SoulGemClasp
p1: levelcap 95
p1: quest Jeuno.BeyondInfinity accepted
p1: charvar Quest[3][137]Prog 1
p1: keyitem SoulGemClasp
done: levelcap 95
done: quest Jeuno.BeyondInfinity completed
done: keyitem SoulGemClasp
login
trigger BC_Entrance                     # accepted, the clasp: the 32000 menu
update 32000 option=321                 # Beyond Infinity, index 20, area 1: registered, entered; the clasp worn
finish                                  # in the arena
kill ATORI_TUTORI                       # area 1: won, battlefieldWin 20, 32001 opens
localvar battlefieldWin 85              # a GM: Waughroon Shrine's fight, not this arena's 20
finish                                  # 32001, battlefieldWin 85: nothing (no scroll, Prog 0)
p1: login
p1: trigger BC_Entrance                 # accepted (Prog 1), the clasp: the 32000 menu
p1: update 32000 option=322             # area 2: registered, entered; the clasp worn
p1: finish                              # in the arena
p1: kill ATORI_TUTORI+1                 # area 2: won, battlefieldWin 20 (accepted), 32001 opens
p1: finish                              # 32001, Prog 1: state 3 wants Prog 0: nothing (no scroll)
done: login
done: trigger BC_Entrance               # completed (status >= accepted), the clasp: the 32000 menu
done: update 32000 option=323           # area 3: registered, entered; the clasp worn
done: finish                            # in the arena
done: kill ATORI_TUTORI+2               # area 3: won; completed: battlefieldWin not set, 32001 opens (skippable)
done: localvar battlefieldWin 20        # a GM: this arena's fight
done: finish                            # 32001, completed: state 3 wants accepted: nothing (no scroll)
