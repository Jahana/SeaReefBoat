# The Secrets of Worship (CoP 4-3), the statuses the main flow skips (a GM sets them): Tavnazian Safehold's _0qa at
# Status 1 (no 4-3 reply), Justinius at Status 0 (131, 4-3's important event) and Parelbriaux at Status 0 (no 4-3
# reply). Misareaux Coast's _0p8 at Status 0 (no 4-3 reply), at Status 2: 502, finished with option 1: no 4-3 action;
# the gate's script sets the char down in the Sacrarium. There the Wooden Gate west of x 45 (Status 2):
# CANNOT_OPEN_SIDE; east of it at Status 0 and 1: no 4-3 reply; at Status 3 without the key: none. The qm qm_prof_0
# at Status 3 without the professor's var (no 4-3 reply; the qm's script: DRAWER_OPEN, DRAWER_EMPTY) and at Status 2
# (the same).
lists TavnazianSafehold/_0qa/onTrigger TavnazianSafehold/Justinius/onTrigger TavnazianSafehold/Parelbriaux/onTrigger MisareauxCoast/_0p8/onTrigger MisareauxCoast/onEventFinish/502 Sacrarium/_0s8/onTrigger Sacrarium/qm_prof_0/onTrigger
char zone=TavnazianSafehold pos=116,-42,41 job=WAR lvl=75 nation=0
mission Cop TheSecretsOfWorship current
login
charvar Mission[6][428]Status 1         # a GM
trigger _0qa                            # Status 1: no 4-3 reply
finish-if-event
charvar Mission[6][428]Status 0         # a GM
trigger Justinius                       # Status 0: 131
finish-if-event
trigger Parelbriaux                     # Status 0: no 4-3 reply
finish-if-event
warp 57,-25.5,739 MisareauxCoast
trigger _0p8                            # Status 0: no 4-3 reply
finish-if-event
charvar Mission[6][428]Status 2         # a GM
trigger _0p8                            # Status 2: 502
finish option=1                         # not option 0: no 4-3 action
tick 10000                              # the zone change
warp 41,-1.5,10 Sacrarium
trigger _0s8 here                       # west of x 45: CANNOT_OPEN_SIDE
finish-if-event
warp 47,-1.5,10 Sacrarium
charvar Mission[6][428]Status 0         # a GM
trigger _0s8                            # east, Status 0: no 4-3 reply
finish-if-event
charvar Mission[6][428]Status 1         # a GM
trigger _0s8                            # east, Status 1: no 4-3 reply
finish-if-event
charvar Mission[6][428]Status 3         # a GM
trigger _0s8                            # east, Status 3 without the key: no 4-3 reply
finish-if-event
trigger qm_prof_0                       # Status 3, no professor's var: DRAWER_OPEN, DRAWER_EMPTY
finish-if-event
charvar Mission[6][428]Status 2         # a GM
trigger qm_prof_0                       # Status 2: DRAWER_OPEN, DRAWER_EMPTY
finish-if-event
