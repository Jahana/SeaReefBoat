# The Sweetest Things (sandoria 8): available at fame level 2 with Prog 3 (GM): none of 0, 1, 2: nil (no script, no
# default: nothing).
lists SouthernSanDoria/Raimbroy/onTrigger
char zone=SouthernSanDoria pos=-139.4,-3.0,34.7 job=WAR lvl=30
fame Sandoria 50
charvar Quest[0][8]Prog 3
login
trigger Raimbroy                          # Prog 3: nil; nothing
finish-if-event
