trigger Rycharde                        # 76 again
finish option=0
trigger Take                            # 68 (a tie with 65: the first container's)
finish
trigger Take                            # 65
finish
charvar Quest[4][0]DayCompleted 7993    # a GM: not due
trigger Rycharde                        # 75 (a tie with 85)
finish
trigger Rycharde                        # 85
finish
charvar Quest[4][0]DayCompleted 7992
trigger Rycharde                        # 76
finish option=74                        # begun, EndTime 790199568
trigger Rycharde                        # accepted: 78 (72) (a tie with 85; the cycle starts over)
finish
trigger Rycharde                        # 85
finish
charvar Quest[4][1]EndTime 790189200    # a GM: no time left
