trigger Kalupa-Tawalupa                 # accepted, var 1: 72
finish
trigger Rutango-Botango                 # accepted, var 1: 71
finish
trigger Zayhi-Bauhi                     # var 1: 69
finish                                  # var 1 (tradeComplete with no trade)
trade Zayhi-Bauhi PotOfHoney x1         # var 1: 70
finish                                  # var 2
trigger Zayhi-Bauhi                     # var 2: 70
finish
trade Zayhi-Bauhi PotOfHoney x1         # var 2: 73
finish                                  # var 3
trigger Zayhi-Bauhi                     # var 3: 73
finish
