# Coming of Age (San d'Oria 8-1, mission.sandoria.coming_of_age) played through: a level 75 San d'Orian Warrior at rank
# 8 with the ASA, ACP, RoV and SoA logs current (their zone-ins quiet) and the nation's missions before it completed.
# Endracion's 1009, option 20: begun (no message). The Chateau zone-in plays 116 (status 1); Halver 58 (status 2); _6h0
# 64, _6h1 75; the Quicksand Caves' Fountain of Kings with neither up spawns Valor and Honor and says
# SENSE_SOMETHING_EVIL; Valor's death reads its own name (kept: the swapped mobHonor / mobValor), so one kill sets
# status 3; the Fountain gives the Drops of Amnio; Halver 102: completed (800 rank points), Progress a minute on, the
# drops taken. Section 3: Ambrotien, Endracion and Grilau say ORIGINAL_MISSION_OFFSET + 127; the Northern San d'Oria
# zone-in plays nothing before Progress, a JST day on 16 (Progress 0); then Grilau's own 1009, whose finish (option 0)
# begins 1-1.
char zone=SouthernSanDoria pos=-108,1,-34 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Sandoria SmashTheOrcishScouts completed
mission Sandoria BatHunt completed
mission Sandoria SaveTheChildren completed
mission Sandoria TheRescueDrill completed
mission Sandoria TheDavoiReport completed
mission Sandoria JourneyAbroad completed
mission Sandoria InfiltrateDavoi completed
mission Sandoria TheCrystalSpring completed
mission Sandoria AppointmentToJeuno completed
mission Sandoria Magicite completed
mission Sandoria TheRuinsOfFeiYin completed
mission Sandoria TheShadowLord completed
mission Sandoria LeautesLastWishes completed
mission Sandoria RanperresFinalRest completed
mission Sandoria PrestigeOfThePapsque completed
mission Sandoria TheSecretWeapon completed
rank 8
login
trigger Endracion                       # no mission current: the guard's own mission list
finish option=24                        # no mission's option (this mission takes 20): not begun
trigger Endracion                       # the list again
finish option=20                        # begun
warp 0,0,0 ChateauDoraguille open       # status 0: the zone-in 116
finish                                  # status 1
trigger _6h0                            # status 1: nothing from the mission
finish-if-event
trigger Halver                          # status 1: 58
finish                                  # status 2
trigger _6h0                            # status 2: 64
finish
trigger _6h1                            # status 2: 75
finish
trigger Halver                          # status 2: nothing from the mission
finish-if-event
warp 567,18,-937 QuicksandCaves
trigger Fountain_of_Kings               # status 2, neither up: Valor and Honor spawned, SENSE_SOMETHING_EVIL
trigger Fountain_of_Kings               # both up: nothing from the mission
finish-if-event
effect 49                               # a GM: Perfect Dodge
effect 50                               # a GM: Invincible
effect 522                              # a GM: Elemental Sforzo
kill VALOR                              # its death reads Valor: status 3
kill HONOR                              # status 3: nothing
trigger Fountain_of_Kings               # status 3, no Drops of Amnio: the key item
trigger Fountain_of_Kings               # the drops held: nothing from the mission
finish-if-event
warp 0,0,0 ChateauDoraguille            # status 3: no zone-in event
trigger Halver                          # status 3, the drops: 102
finish                                  # completed: 800 rank points, Progress, the drops taken
trigger Halver                          # completed: nothing from the mission
finish-if-event
warp 93.4,0,-55.3 SouthernSanDoria
trigger Ambrotien                       # section 3: ORIGINAL_MISSION_OFFSET + 127
finish-if-event
trigger Endracion                       # section 3: ORIGINAL_MISSION_OFFSET + 127
finish-if-event
warp -240,7,57.9 NorthernSanDoria       # Progress not yet past: no zone-in event
trigger Grilau                          # section 3: ORIGINAL_MISSION_OFFSET + 127
finish-if-event
wait jst=1                              # the wall clock a day on
warp 93.4,0,-55.3 SouthernSanDoria
warp -240,7,57.9 NorthernSanDoria open  # Progress past: 16
finish                                  # Progress 0; Northern San d'Oria's Zone.lua 16 finish: Mission8-1Completed 1
trigger Grilau                          # section 3 no longer holds: his own 1009 (the mission list)
finish-if-event                         # option 0: Smash the Orcish Scouts (1-1, its option 0) begun
