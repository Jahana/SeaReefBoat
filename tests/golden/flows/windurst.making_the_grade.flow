finish
trigger Paku-Nakku                            # 452
finish
trigger Pechiru-Mashiru                       # 445
finish
trigger Rukuku                                # 450
finish
trigger Tauwawa                               # 446
finish
trigger Moreno-Toeno                          # the quest's turn, the first Event line: this quest's 444
finish
trigger Moreno-Toeno                          # his script's turn: 469
finish
trigger Moreno-Toeno                          # the quest's turn, the next Event line: Teacher's Pet's 439
finish
trigger Fuepepe                               # 443 (stands beside him)
finish
trade Fuepepe BoneChip x1                     # not the sheets: nil
trade Fuepepe PileOfAnswerSheets x1 BoneChip x1   # with an extra: nil
trade Fuepepe PileOfAnswerSheets x1           # Prog 0, the sheets alone: 455
finish                                        # Prog 1; no confirmTrade: the sheets kept
trade Fuepepe PileOfAnswerSheets x1           # Prog 1: nil
trigger Fuepepe                               # Prog 1: 456
finish
trigger Chomoro-Kyotoro                       # Prog 1: 457
finish
warp -119.7,-5.5,122.4 WindurstWalls
trigger Koru-Moru                             # Prog 1: nil; his script (nothing); 193
finish
trade Koru-Moru PileOfAnswerSheets x1 BoneChip x1  # with an extra: nil
trade Koru-Moru PileOfAnswerSheets x1         # Prog 1: 285
finish                                        # the sheets taken; the Tattered Test Sheet; Prog 2
trigger Koru-Moru                             # Prog 2: 286
finish
warp 165.5,-1.25,161.1 WindurstWaters
trigger Chomoro-Kyotoro                       # Prog 2: 460
finish                                        # the test sheet taken; Prog 3
trigger Chomoro-Kyotoro                       # Prog 3: 461
finish
trigger Fuepepe                               # Prog 3 (>= 2): 458
