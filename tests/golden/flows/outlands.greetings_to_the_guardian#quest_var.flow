# Greetings to the Guardian (outlands 2), the quest's own var at the completion: accepted, PamamaVar 1 and
# Quest[5][2]Prog 1 (GMs). Hari Pakhroib (the second talk of a pair: his default 84 first): 71; finished: 5000 gil, the
# raw player:completeQuest, Windurst fame +16, the Kazham Caller title, PamamaVar 0, needToZone. The raw completeQuest
# does no cleanup: Quest[5][2]Prog stays 1 (quest:complete's cleanup would clear it).
char zone=Kazham pos=58,-12,-176.7 job=WAR lvl=75
quest Outlands.GreetingsToTheGuardian accepted
charvar PamamaVar 1
charvar Quest[5][2]Prog 1               # a GM: the quest's own var
login
trigger Hari_Pakhroib                   # default turn: 84
finish
trigger Hari_Pakhroib                   # script, PamamaVar 1: 71
finish                                  # 5000 gil; completed, Prog kept; fame +16; the title; PamamaVar 0; needToZone
