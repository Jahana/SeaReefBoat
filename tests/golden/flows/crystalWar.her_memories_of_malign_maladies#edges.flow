warp 5.479,-1.999,44.456 SouthernSanDoriaS
trigger Raustigne                       # no Fey Stone: nil (606)
finish-if-event
charvar Quest[7][72]Prog 3              # a GM
keyitem FeyStone                        # a GM
warp -139.812,-6.75,564.417 GraubergS
trigger Fey_Blossoms                    # Prog 3, the Fey Stone held: nil
