# To the Forsaken Mines in Gusgen Mines, a level 99 Warrior with three Slices of Hare Meat, a Glocolite and a Pickaxe:
# qm2 says FRESH_MONSTER_TRACKS; a Pickaxe traded: NOTHING_SEEMS_HAPPENING; the meat with the Glocolite held:
# NOTHING_SEEMS_HAPPENING (no pop).
lists BastokMarkets/Cleades/onTrigger BastokMarkets/Cleades/onTrade BastokMarkets/onEventFinish/1001 BastokMarkets/onEventFinish/1006 BastokMarkets/onEventFinish/1010 BastokMines/Davyad/onTrigger BastokMines/Rashid/onTrigger BastokMines/Rashid/onTrade BastokMines/onEventFinish/1001 BastokMines/onEventFinish/1006 BastokMines/onEventFinish/1010 Metalworks/Malduc/onTrigger Metalworks/Malduc/onTrade Metalworks/onEventFinish/1001 Metalworks/onEventFinish/1006 Metalworks/onEventFinish/1010 PortBastok/Argus/onTrigger PortBastok/Argus/onTrade PortBastok/onEventFinish/1001 PortBastok/onEventFinish/1006 PortBastok/onEventFinish/1010 GusgenMines/qm2/onTrigger GusgenMines/qm2/onTrade
char zone=GusgenMines pos=208,-60,-101 job=WAR lvl=99 nation=1
mission Rov Resonance current
mission Bastok ToTheForsakenMines current
item SliceOfHareMeat x3
item Glocolite
item Pickaxe
login
trigger qm2                             # FRESH_MONSTER_TRACKS
walk 209,-59,-101
trade qm2 Pickaxe x1                    # not the meat: NOTHING_SEEMS_HAPPENING
trade qm2 SliceOfHareMeat x1            # the Glocolite held: NOTHING_SEEMS_HAPPENING
