trigger _4t1                            # Option 6; FILL_FLASK; STILL_LIGHT
trigger _4t2                            # Option 14; FILL_FLASK; STILL_LIGHT
trigger _4t3                            # Option 30: FILL_FLASK; the flask taken; FLASK_FULL; the Flask of Clam Water; Prog 4
trigger _4t3                            # Prog 4: no section, no default: nothing
