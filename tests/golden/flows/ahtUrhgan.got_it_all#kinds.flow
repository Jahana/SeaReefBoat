# Got It All's replies at Tehf Kimasnahya 520 / 525 / 534 / 527 / 539 / 528, Ekhu Pesshyadha 532 / 522 / 536 / 524 /
# 537 / 531 and Zabahf 533 / 523 / 538 / 540 / 535, every state triggered twice with the quest state reset between
# the two when its finish moves it. These NPCs have no script of theirs: a Progress event and an Event both repeat,
# so no kind shows here; the kinds are proven against rivals in got_it_all#kinds2. This flow pins the event ids
# and the finishes. 524's finish with the vial already held still sets Prog 4 (npcUtil.giveKeyItem is true for a
# held key item).
lists AhtUrhganWhitegate/Tehf_Kimasnahya/onTrigger AhtUrhganWhitegate/Ekhu_Pesshyadha/onTrigger AhtUrhganWhitegate/Zabahf/onTrigger
char zone=AhtUrhganWhitegate pos=-89.897,0,6.199 job=WAR lvl=75
login
trigger Tehf_Kimasnahya                 # available: 520 (Progress)
finish                                  # begun
quest AhtUrhgan.GotItAll available
trigger Tehf_Kimasnahya                 # 520 again
finish
quest AhtUrhgan.GotItAll available
trigger Ekhu_Pesshyadha                 # available: 532 (Event)
finish
trigger Ekhu_Pesshyadha                 # the same Event again
finish
trigger Zabahf                          # available: 533 (Event)
finish
trigger Zabahf                          # the same Event again
finish
quest AhtUrhgan.GotItAll accepted
charvar Quest[6][3]Prog 1
trigger Ekhu_Pesshyadha                 # Prog 1: 522 (Progress)
finish                                  # Prog 2
charvar Quest[6][3]Prog 1
trigger Ekhu_Pesshyadha                 # 522 again
finish
charvar Quest[6][3]Prog 1
trigger Zabahf                          # Prog 1: 533 (Event)
finish
trigger Zabahf                          # the same Event again
finish
charvar Quest[6][3]Prog 2
trigger Ekhu_Pesshyadha                 # Prog 2: 536 (Event)
finish
trigger Ekhu_Pesshyadha                 # the same Event again
finish
trigger Zabahf                          # Prog 2: 523 (Progress)
finish                                  # Prog 3
charvar Quest[6][3]Prog 2
trigger Zabahf                          # 523 again
finish
charvar Quest[6][3]Prog 3
trigger Zabahf                          # Prog 3: 523
finish
trigger Zabahf                          # 523 again
finish
trigger Ekhu_Pesshyadha                 # Prog 3: 524 (Progress)
finish                                  # the Vial of Luminous Water; Prog 4
charvar Quest[6][3]Prog 3
trigger Ekhu_Pesshyadha                 # 524 again
finish                                  # the vial held: npcUtil gives true again: Prog 4
trigger Ekhu_Pesshyadha                 # Prog 4: 537 (Event)
finish
charvar Quest[6][3]Prog 4
trigger Ekhu_Pesshyadha                 # Prog 4: 537 (Event)
finish
trigger Ekhu_Pesshyadha                 # the same Event again
finish
trigger Zabahf                          # Prog 4: 533 (Event)
finish
trigger Zabahf                          # the same Event again
finish
trigger Tehf_Kimasnahya                 # Prog 4: 525 (Progress)
finish option=1                         # not option 0: nothing
trigger Tehf_Kimasnahya                 # 525 again
finish option=1
charvar Quest[6][3]Prog 5
trigger Tehf_Kimasnahya                 # Prog 5: 534 (Event)
finish
trigger Tehf_Kimasnahya                 # the same Event again
finish
trigger Zabahf                          # Prog 5: 538 (Event)
finish
trigger Zabahf                          # the same Event again
finish
charvar Quest[6][3]Prog 6
trigger Zabahf                          # Prog 6: 540 (Event)
finish
trigger Zabahf                          # the same Event again
finish
trigger Tehf_Kimasnahya                 # Prog 6: 527 (Progress)
finish                                  # Prog 7; needToZone
charvar Quest[6][3]Prog 6
trigger Tehf_Kimasnahya                 # 527 again
finish
trigger Tehf_Kimasnahya                 # Prog 7, the zoning flag: 539 (Event)
finish
trigger Tehf_Kimasnahya                 # the same Event again
finish
trigger Zabahf                          # Prog 7: 535 (Event)
finish
trigger Zabahf                          # the same Event again
finish
warp -64,-7,38 AlZahbi                  # the zoning flag cleared
warp -89.897,0,6.199 AhtUrhganWhitegate
trigger Tehf_Kimasnahya                 # Prog 7: 528 (Progress)
finish                                  # completed
trigger Ekhu_Pesshyadha                 # completed, Three Men and a Closet not completed: 531 (Event)
finish
trigger Ekhu_Pesshyadha                 # the same Event again
finish
quest AhtUrhgan.GotItAll available
quest AhtUrhgan.GotItAll accepted
charvar Quest[6][3]Prog 7
trigger Tehf_Kimasnahya                 # 528 again
finish                                  # completed
