# Headstone Pilgrimage: Cape Teriggan's headstone (Wind Fragment), five of the others held. Without its
# fragment it first plays 200 (Wind); option 0 does nothing; 3 yalms off option 1 says
# MUST_MOVE_CLOSER (7708: 0, the fragment); close by, option 1 shows COLD_WIND_CHILLS_YOU (7709, a 0x036 message)
# and spawns Axesarion the Wanderer. While it is up the headstone says SOMETHING_BETTER (7687).
# Its kill gives 160 XP. Once it is dead the headstone plays 201 instead; option 0
# does nothing, 3 yalms off MUST_MOVE_CLOSER, close by option 1 adds Wandering Souls and gives the fragment
# (KEYITEM_OBTAINED 6398). Held, with Wandering Souls not completed, the mission answers nothing: the
# quest's MUST_BE_A_WAY_TO_SOOTHE (7702) plays. A GM adds the last fragment and takes this one: 201's
# option 1 says FOUND_ALL_FRAGS (7693) and completes the mission (the Bearer of the Eight Prayers title,
# Through the Quicksand Caves current). Completed, the quest (still accepted) answers again with 7702;
# section 2's ZILART_MONUMENT does not show.
lists CapeTeriggan/Cermet_Headstone/onTrigger CapeTeriggan/onEventFinish/200 CapeTeriggan/onEventFinish/201
char zone=CapeTeriggan pos=-107,-8,452 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart HeadstonePilgrimage current
keyitem FireFragment
keyitem IceFragment
keyitem LightningFragment
keyitem WaterFragment
keyitem LightFragment
login
trigger Cermet_Headstone                # no fragment, no NM up: 200
finish option=0                         # not 1: nothing
trigger Cermet_Headstone at=3           # 200
finish option=1                         # 3 yalms off: MUST_MOVE_CLOSER
trigger Cermet_Headstone                # 200
finish option=1                         # COLD_WIND_CHILLS_YOU, the NM spawned
trigger Cermet_Headstone                # an NM up: SOMETHING_BETTER
kill AXESARION_THE_WANDERER             # the last dead: 201 next
trigger Cermet_Headstone                # the NM dead: 201
finish option=0                         # not 1: nothing
trigger Cermet_Headstone at=3           # 201
finish option=1                         # 3 yalms off: MUST_MOVE_CLOSER
trigger Cermet_Headstone                # 201
finish option=1                         # the quest added, the fragment
trigger Cermet_Headstone                # held, the quest not completed: its 7702
finish-if-event
keyitem EarthFragment                   # a GM
delkeyitem WindFragment                 # a GM
trigger Cermet_Headstone                # 201
finish option=1                         # the last fragment: FOUND_ALL_FRAGS, completed
trigger Cermet_Headstone                # completed: the quest's 7702
finish-if-event
