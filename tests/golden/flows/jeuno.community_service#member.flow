trigger _l06                            # 126 (1, 6)
finish option=1                         # Count 5
trigger _l07                            # 127 (1, 7)
finish option=1                         # Count 4
trigger _l08                            # 128 (1, 8)
finish option=1                         # Count 3
trigger _l09                            # 129 (1, 9)
finish option=1                         # Count 2
trigger _l10                            # 130 (1, 10)
finish option=1                         # Count 1
trigger _l11                            # 131 (1, 11)
finish option=1                         # Count 0: LAMP_MSG_OFFSET, Prog 2, allLightsLit 1
trigger Zauko                           # Prog 2: 117 (1, 1)
finish option=0                         # completed: Torchbearer, fame +7 x3; option 0: no card
wait vana=11                            # day 8002, 5:00
tick 1000                               # onGameHour 5: communityServiceCleanup (lamps closed, zone vars 0)
trigger Zauko                           # 5:00, the card, Wait 0 (cleared at completion): 118 (1)
finish option=1                         # Wait = 8002, the card returned, YOU_RETURN_THE
trigger Zauko                           # no card: nil; his default 118
