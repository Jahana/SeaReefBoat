effect 30                               # Bane
effect 31                               # Plague
trigger Ohruru                          # 246
finish option=0                         # Mute taken (the first), 1000 gil; fame 10
trigger Ohruru                          # Bane and Plague: 246
finish option=0                         # Bane taken, 1200 gil; fame 10
trigger Ohruru                          # Plague alone: 246
finish option=0                         # Plague taken, 1500 gil; fame 10
