# 'daily': record 1 done by a claim (so it is in the completed set), 4082 (daily) taken at 7 of 30. Logged out two
# days and back in: the daily reset zeroes 4082's progress but keeps it on the log, and 1 stays complete.
char zone=WestRonfaure pos=0,0,0 job=WAR lvl=5
login
record take 1
record progress 1 1
record claim 1
record take 4082
record progress 4082 7
logout
wait jst=2
login
