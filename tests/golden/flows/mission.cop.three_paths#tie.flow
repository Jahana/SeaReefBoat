# Three Paths (mission.cop.three_paths#tie). A level 75 Warrior with 5-3 current (a GM) in Metalworks; a GM sets
# Louverance 12, Tenzen 12, Ulmia 9, so Cid has three progress events at once (853, 854, 855). Cid and its finish three
# times: each finish sets that path's 14; the third completes the mission.
lists Metalworks/Cid/onTrigger Metalworks/onEventFinish/851 Metalworks/onEventFinish/852 Metalworks/onEventFinish/853 Metalworks/onEventFinish/854 Metalworks/onEventFinish/855
char zone=Metalworks pos=-12,-12,1 job=WAR lvl=75 nation=1
mission Cop ThreePaths current
login
missionstatus Cop 12 pos=2              # a GM
missionstatus Cop 12 pos=3              # a GM
missionstatus Cop 9 pos=4               # a GM
trigger Cid
finish
trigger Cid
finish
trigger Cid
finish
