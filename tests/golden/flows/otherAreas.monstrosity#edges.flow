trade Suspicious_Galka RabbitHide x1    # MONSTROSITY_UNLOCK 1; 419 (856)
localvar MONSTROSITY_UNLOCK 0           # a GM, before the finish
finish                                  # species 0: nothing (the hide kept, no ring)
trade Suspicious_Galka RabbitHide x1    # 419 (856)
finish                                  # the hide taken; the ring; setMonstrosityData(1, 1)
trade Suspicious_Galka RabbitHide x1    # the ring held: nil; nothing
trigger Suspicious_Galka                # the ring: 420 (HAS_RING)
finish
warp 222.8,-12,225.3 PortWindurst
trigger Suspicious_Tarutaru             # the ring: 882 (HAS_RING)
finish
