# Ark Angels 2: the entry requirements. At Zilart status 0 or 2, with the Shard of Cowardice held (entryRequirement), or
# with Ark Angels not current, qm1_2 opens no menu (LaLoff has no NO_BATTLEFIELD_qm1_2 text); at status 1 without the
# shard it opens.
warning: lua: addMission: overwriting current mission 26 of log 3 with 27 -- the GM's mission line: The Sealed Shrine over Ark Angels (not current)
lists LaloffAmphitheater/qm1_2/onTrigger LaloffAmphitheater/onEventUpdate/32000 LaloffAmphitheater/onEventFinish/32000 LaloffAmphitheater/onEventFinish/32001 LaloffAmphitheater/onEventFinish/32002 LaloffAmphitheater/qm2/onTrigger LaloffAmphitheater/onEventFinish/32003
char zone=LaloffAmphitheater pos=-263.282,-137.313,374.516 job=WAR lvl=99 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart ArkAngels current
login
trigger qm1_2                           # status 0: no menu
missionstatus Zilart 2                  # a GM
trigger qm1_2                           # status 2: no menu
missionstatus Zilart 1                  # a GM
keyitem ShardOfCowardice                  # a GM
trigger qm1_2                           # the shard held: no menu
delkeyitem ShardOfCowardice               # a GM
trigger qm1_2                           # the menu
finish
mission Zilart TheSealedShrine current  # a GM
trigger qm1_2                           # not current: no menu
