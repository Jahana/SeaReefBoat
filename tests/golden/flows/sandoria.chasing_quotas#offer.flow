# Chasing Quotas (sandoria 95): 18's other option (neither 0 nor a cancel) begins it; then the nil arms at Prog 0:
# Miaux (his script's 11), Ardea (her default 260), Esca (her default 119), and the qm2 (SOMEONE_DUG, speakerless).
char zone=PortSanDoria pos=0.626,-8,-120.914 job=DRG lvl=50
quest Sandoria.TheHolyCrest completed
quest Sandoria.ACraftsmansWork completed
login
trigger Ceraulian                         # 18
finish option=2                           # not 0, not cancelled: begun
warp -167.627,3.999,158.677 NorthernSanDoria
trigger Miaux                             # Prog 0: nil; his script's 11
finish
warp -196.463,-6,-69.026 BastokMarkets
trigger Ardea                             # Prog 0: nil; her default 260
finish
warp -622.731,-51.499,278.369 WestRonfaure
trigger Esca                              # Prog 0: nil; her default 119
finish
warp 146.873,16.462,-548.56 BatalliaDowns
trigger qm2                               # Prog 0: SOMEONE_DUG; noAction
