# The Horutoto Ruins Experiment (Windurst 1-1): Windurst Walls. A level 10 Warrior of Windurst (Resonance current).
# Section 1: Zokima-Rokima plays 96; its finish with option 1 begins the mission (the Walls title). Section 2 (1-1
# current): Keo-Koruo, Pakke-Pokke and Zokima-Rokima play 100, 101 and 99. Completed (a GM): section 7: Keo-Koruo plays
# 105 and Pakke-Pokke 104.
lists WindurstWalls/Zokima-Rokima/onTrigger WindurstWalls/Keo-Koruo/onTrigger WindurstWalls/Pakke-Pokke/onTrigger WindurstWalls/onEventFinish/96
char zone=WindurstWalls pos=1,-16,127 job=WAR lvl=10 nation=2
mission Rov Resonance current
login
trigger Zokima-Rokima                   # section 1: 96
finish option=1                         # begun (the Walls title, status 1)
trigger Keo-Koruo                       # section 2: 100
finish
trigger Pakke-Pokke                     # 101
finish
trigger Zokima-Rokima                   # 99
finish
mission Windurst TheHorutotoRuinsExperiment completed   # a GM
trigger Keo-Koruo                       # section 7: 105
finish
trigger Pakke-Pokke                     # 104
finish
