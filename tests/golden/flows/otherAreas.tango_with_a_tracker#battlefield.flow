trigger Despachiaire                    # the wait = the tally: nil; 317
finish
charvar ShikareeBattleWait 1800197999   # a GM
trigger Despachiaire                    # the wait below the tally, no letter: 577
finish                                  # the letter; the wait 1800198000
trigger Despachiaire                    # the letter held: 317
finish
wait jst=3                              # Monday: the tally 1800802800
delkeyitem LetterFromShikareeX          # a GM
trigger Despachiaire                    # 577
finish                                  # the letter; the wait 1800802800
keyitem LetterFromShikareeY             # a GM
warp -617.9,-1.5,505.7 BoneyardGully
trigger _081                            # the letters: the 32000 menu
update 32000 option=97                  # index 6, area 1: Requiem of Sin (678)
finish                                  # in 678 (Tango's accepted section has no 32000)
localvar battlefieldWin 678             # a GM
bfwin                                   # a GM: won; 32001
