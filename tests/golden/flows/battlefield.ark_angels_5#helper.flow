# Ark Angels 5: area 2 with a helper (eve, Ark Angels completed). The win plays 32001 to both; eve's finish does nothing
# (the mission not current); main's gives the Shard of Rage.
lists LaloffAmphitheater/qm1_5/onTrigger LaloffAmphitheater/onEventUpdate/32000 LaloffAmphitheater/onEventFinish/32000 LaloffAmphitheater/onEventFinish/32001 LaloffAmphitheater/onEventFinish/32002 LaloffAmphitheater/qm2/onTrigger LaloffAmphitheater/onEventFinish/32003
char zone=LaloffAmphitheater pos=557.498,-38.205,520.627 job=WAR lvl=99 nation=0
char eve zone=LaloffAmphitheater pos=557.498,-38.205,520.627 job=WAR lvl=99 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart ArkAngels current
eve: mission Asa BurgeoningDread current
eve: mission Acp ACrystallineProphecyFin current
eve: mission Rov ARhapsodyForTheAges current
eve: mission Soa Abomination current
eve: mission Zilart ArkAngels completed
eve: mission Zilart TheSealedShrine current
login
missionstatus Zilart 1                  # a GM
eve: login
invite eve
eve: accept
effect 50                               # a GM: Invincible
effect 522
effect 49
eve: effect 50
trigger qm1_5
update 32000 option=66                  # index 4, area 2: entered
finish
eve: trigger qm1_5
eve: update 32000 option=66
eve: finish
tick 2000
kill ARK_ANGEL_GK+1                   # won: 32001 to both
eve: finish                             # eve: nothing
finish                                  # main: the ShardOfRage
