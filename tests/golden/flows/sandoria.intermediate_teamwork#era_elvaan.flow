# Intermediate Teamwork (sandoria 64) with its era module (quest rework B3b, Task 9): six Elvaans in a party, the
# Elvaans race arm. The module (xi.pre(xi.expansion.ROV): RESTRICT_CONTENT 1, ENABLE_ROV 0) needs six of the kind
# of the char who talks (same-race count >= 6). Introduction completed and Intermediate accepted by GM, for main and
# for bob. main, carl and eve are Elvaan males (race 3), bob, dave and fay Elvaan females (race 4); main leads. main talks:
# six of the kind, the local Prog 1, updateEvent(15, 2); then bob talks: six, bob's local Prog 1, updateEvent(15, 2);
# finish option 1 each: nothing.
module modules/era/lua/quests/sandoria/intermediate_teamwork.lua
lists WestRonfaure/Vilatroire/onTrigger WestRonfaure/onEventUpdate/129 WestRonfaure/onEventFinish/129
char zone=WestRonfaure pos=-258.861,-70.999,423.42 job=WAR race=3 lvl=10
char bob zone=WestRonfaure pos=-258.861,-70.999,428 job=WAR race=4 lvl=10
char carl zone=WestRonfaure pos=-256,-70.999,426 job=WAR race=3 lvl=10
char dave zone=WestRonfaure pos=-256,-70.999,421 job=WAR race=4 lvl=10
char eve zone=WestRonfaure pos=-261.5,-70.999,426 job=WAR race=3 lvl=10
char fay zone=WestRonfaure pos=-261.5,-70.999,421 job=WAR race=4 lvl=10
setting RESTRICT_CONTENT 1
setting ENABLE_ROV 0
quest Sandoria.IntroductionToTeamwork completed
quest Sandoria.IntermediateTeamwork accepted
bob: quest Sandoria.IntroductionToTeamwork completed
bob: quest Sandoria.IntermediateTeamwork accepted
login
bob: login
carl: login
dave: login
eve: login
fay: login
invite bob
bob: accept
invite carl
carl: accept
invite dave
dave: accept
invite eve
eve: accept
invite fay
fay: accept                               # six Elvaans
trigger Vilatroire                        # 129 { [1] = 2 }
update 129 option=0                       # main race 3: six of the kind (>= 6), the local Prog 1, updateEvent(15, 2)
finish option=1                           # option 1: nothing
bob: trigger Vilatroire                   # bob talks: 129 { [1] = 2 }
bob: update 129 option=0                  # bob race 4: six, bob's local Prog 1, updateEvent(15, 2)
bob: finish option=1                      # option 1: nothing
