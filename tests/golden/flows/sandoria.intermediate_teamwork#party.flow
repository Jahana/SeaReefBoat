# Intermediate Teamwork (sandoria 64): 129 in a party, formed by the engine's own invite and accept. Introduction
# completed and Intermediate accepted by GM. Main (a Hume male, race 1) leads; bob is an Elvaan male (3), carl a Hume
# female (2), dave a Hume male (1). Vilatroire's trigger moves main to (-258.861, -70.999, 423.42). The update counts
# the members (main among them) of main's race kind (Hume male or female alike), after each member's zone and distance:
# - main and bob: one of the kind, updateEvent(4, 2); finish option 0 with the local Prog 0: nothing;
# - bob exactly 15 yalms off: in range, updateEvent(4, 2); 15.01 yalms: updateEvent(1);
# - bob in East Ronfaure, 2.58 yalms from main's coordinates: updateEvent(1);
# - bob logs out while 129 is open: #party below 2: updateEvent(1); alone, the next talk is his default 136;
# - main and carl (a Hume female): two of the kind, the local Prog 1, updateEvent(15, 2); finish option 1: nothing;
# - main, carl and dave: three (>= 2), updateEvent(15, 2); finish option 0 with a full bag: not completed;
# - dave 16.58 yalms off: updateEvent(1), the local Prog still 1: finish option 0 completes it (Scroll of Mage's Ballad,
#   fame +30, Second-Rate Organizer): the kept quirk.
# The other race kinds: #race_<kind> (each pair of genders, Galka, Mithra).
lists WestRonfaure/Vilatroire/onTrigger WestRonfaure/onEventUpdate/129 WestRonfaure/onEventFinish/129
char zone=WestRonfaure pos=-258.861,-70.999,423.42 job=WAR lvl=10 race=1
char bob zone=WestRonfaure pos=-258.861,-70.999,428 job=WAR lvl=10 race=3
char carl zone=WestRonfaure pos=-256,-70.999,426 job=WAR lvl=10 race=2
char dave zone=WestRonfaure pos=-256,-70.999,421 job=WAR lvl=10 race=1
quest Sandoria.IntroductionToTeamwork completed
quest Sandoria.IntermediateTeamwork accepted
login
bob: login
carl: login
dave: login
invite bob
bob: accept                               # main leads, bob joins
trigger Vilatroire                        # a party of two: 129 { [1] = 2 }
update 129 option=0                       # main Hume, bob Elvaan: one, updateEvent(4, 2)
finish                                    # option 0, the local Prog 0: nothing
bob: walk -258.861,-70.999,438.42         # exactly 15 yalms from main's spot at Vilatroire
trigger Vilatroire                        # 129
update 129 option=0                       # checkDistance 15, not > 15: in range; one: updateEvent(4, 2)
finish option=1
bob: walk -258.861,-70.999,438.43         # 15.01 yalms
trigger Vilatroire                        # 129
update 129 option=0                       # bob out of range: updateEvent(1)
finish option=1
bob: warp -258.861,-70.999,426 EastRonfaure   # another zone, 2.58 yalms from main's coordinates
tick 400                                  # bob's zone-in reload: in main's party, in another zone
trigger Vilatroire                        # #party 2: 129
update 129 option=0                       # bob's zone is not main's: updateEvent(1)
finish option=1
trigger Vilatroire                        # 129
bob: logout                               # bob leaves the process: main alone
tick 400
update 129 option=0                       # #party 1, below 2: updateEvent(1)
finish option=1
trigger Vilatroire                        # alone now (#party 1): the trigger's nil, his default 136
finish
invite carl
carl: accept                              # main (Hume male) and carl (Hume female)
trigger Vilatroire                        # 129
update 129 option=0                       # two of the kind: the local Prog 1, updateEvent(15, 2)
finish option=1                           # option 1: nothing (the local Prog stays 1)
invite dave
dave: accept                              # main, carl and dave: three Humes
fill-inventory
trigger Vilatroire                        # 129
update 129 option=0                       # three (>= 2): the local Prog 1, updateEvent(15, 2)
finish                                    # option 0, Prog 1, a full bag: complete fails, not completed
free-inventory
dave: walk -258.861,-70.999,440           # dave 16.58 yalms off
trigger Vilatroire                        # 129
update 129 option=0                       # dave out of range: updateEvent(1), the local Prog left at 1
finish                                    # option 0, the stale Prog 1: completed (Scroll of Mage's Ballad, fame +30, Second-Rate Organizer)
