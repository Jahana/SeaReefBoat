# Keeping Notes adds 0x10 to the Mog House flag (task 7 mutants): completed (flag 0x10), then undone and accepted
# again (a GM) and completed again: 0x20 (an or would leave 0x10).
lists AhtUrhganWhitegate/Ahkk_Jharcham/onTrade AhtUrhganWhitegate/onEventFinish/11
char zone=AhtUrhganWhitegate pos=0.142,0,-76.332 job=WAR lvl=75
item SheetOfParchment x2
item JarOfBlackInk x2
quest AhtUrhgan.KeepingNotes accepted
login
trade Ahkk_Jharcham SheetOfParchment x1 JarOfBlackInk x1   # 11
finish                                  # completed; the two taken; mhflag 16
quest AhtUrhgan.KeepingNotes available  # a GM: undone
quest AhtUrhgan.KeepingNotes accepted   # a GM: again
trade Ahkk_Jharcham SheetOfParchment x1 JarOfBlackInk x1   # 11
finish                                  # completed; mhflag 32
