# Beyond Infinity, Horlais Peak (battlefield.beyond_infinity_horlais_peak): the registrant's requirements. main has the quest
# accepted but no clasp, bob has the clasp but the quest only available: each gets the requirements message and a
# release, no menu. cat and dan are declared and never log in or trigger.
lists HorlaisPeak/BC_Entrance/onTrigger
char zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=75
char bob zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=75
char cat zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=75
char dan zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=75
quest Jeuno.BeyondInfinity accepted
bob: keyitem SoulGemClasp
login
bob: login
trigger BC_Entrance
bob: trigger BC_Entrance
