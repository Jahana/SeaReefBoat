# Return to the Depths (battlefield.return_to_the_depths, Mine Shaft #2716): main (accepted, Prog 9) registers and
# invites bob, cat, dan and eve. A helper passes by having the quest completed (bob) or accepted at the var or higher
# (dan, Prog 10: the menu, option 17); cat (accepted, Prog 7: below) and eve (no quest) get the message 32767 and a
# release, no menu. The win for the party, each finish.
lists MineShaft2716/_0d0/onTrigger MineShaft2716/onEventUpdate/32000 MineShaft2716/onEventFinish/32000 MineShaft2716/onEventFinish/32001
char zone=MineShaft2716 pos=-93.657,-120,-583.561 job=WAR lvl=75
char bob zone=MineShaft2716 pos=-93.657,-120,-583.561 job=WAR lvl=75
char cat zone=MineShaft2716 pos=-93.657,-120,-583.561 job=WAR lvl=75
char dan zone=MineShaft2716 pos=-93.657,-120,-583.561 job=WAR lvl=75
char eve zone=MineShaft2716 pos=-93.657,-120,-583.561 job=WAR lvl=75
quest Bastok.ReturnToTheDepths accepted
charvar Quest[1][78]Prog 9
bob: quest Bastok.ReturnToTheDepths completed
cat: quest Bastok.ReturnToTheDepths accepted
cat: charvar Quest[1][78]Prog 7
dan: quest Bastok.ReturnToTheDepths accepted
dan: charvar Quest[1][78]Prog 10
login
bob: login
invite bob
bob: accept
cat: login
invite cat
cat: accept
dan: login
invite dan
dan: accept
eve: login
invite eve
eve: accept
trigger _0d0
update 32000 option=17
finish
bob: trigger _0d0
bob: update 32000 option=17
bob: finish
cat: trigger _0d0
cat: update 32000 option=17
cat: finish
dan: trigger _0d0
dan: update 32000 option=17
dan: finish
eve: trigger _0d0
eve: update 32000 option=17
eve: finish
kill TWILOTAK
finish
bob: finish
cat: finish
dan: finish
eve: finish
tick 11000
