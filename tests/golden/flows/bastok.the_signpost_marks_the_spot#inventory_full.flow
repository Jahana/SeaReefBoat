# The Signpost Marks the Spot with a full inventory: 96 plays, the Linen Robe does not fit, the quest stays accepted and
# the painting is kept; once there is room the same talk completes it.
char zone=BastokMines pos=-11.8,6.999,-8.2
keyitem PaintingOfAWindmill
quest Bastok.TheSignpostMarksTheSpot accepted
login
fill-inventory
trigger Roh_Latteh              # the painting held: 96
finish                          # the inventory full: not completed, the painting kept
free-inventory
trigger Roh_Latteh              # 96 again
finish                          # completed: Linen Robe, fame +20, Treasure Scavenger, the painting gone
