# Delivering the Goods with its era module, modules/era/lua/quests/ahturhgan/delivering_the_goods.lua, enabled by
# xi.pre(SOA) (RESTRICT_CONTENT 1, ENABLE_SOA 0): Vanishing Act opens at JST midnight. A level 75 Warrior, the quest
# accepted at Prog 1 (GMs). Fochacha 41, finished: the module's copy: completed, three bronze pieces, the zoning flag,
# Vanishing Act's Stage = JstMidnight() (1800025200; the quest alone sets 1800000060: the trace's char var shows which).
# Out of Whitegate and back: now < Stage: Qutiba 52, Ulamaal 53; Stage 1800000000 (a GM, now): Qutiba 42, finished with
# option 1: still available.
module modules/era/lua/quests/ahturhgan/delivering_the_goods.lua
lists AhtUrhganWhitegate/Fochacha/onTrigger AhtUrhganWhitegate/Qutiba/onTrigger AhtUrhganWhitegate/Ulamaal/onTrigger AhtUrhganWhitegate/onEventFinish/41
char zone=AhtUrhganWhitegate pos=2.897,0,-10.781 job=WAR lvl=75
setting RESTRICT_CONTENT 1
setting ENABLE_SOA 0
quest AhtUrhgan.DeliveringTheGoods accepted
charvar Quest[6][61]Prog 1
login
trigger Fochacha                        # Prog 1: 41
finish                                  # the module's copy: completed; bronze pieces; Stage = JstMidnight(); needToZone
warp -64,-7,38 AlZahbi                  # the zoning flag cleared
warp 92.341,-6.5,-127.5 AhtUrhganWhitegate
trigger Qutiba                          # now < Stage (JST midnight): 52
finish
trigger Ulamaal                         # 53
finish
charvar Quest[6][62]Stage 1800000000    # a GM: now
trigger Qutiba                          # Stage not later than now: 42
finish option=1                         # not option 0: still available
