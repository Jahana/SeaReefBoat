update 321 option=0                     # richEnough 0 (99999): (0, 128, 0)
update 321 option=18                    # the Galka's pose: (1, 128, 18, 0)
finish option=10                        # 200 taken: race 8 (floored %), pose 0; 99799
trigger Fyi_Chalmwoh                    # 321
finish option=82                        # 200 taken: race 8, pose 2; 99599
trigger Fyi_Chalmwoh                    # 321
update 321 option=18                    # the Galka's pose: (1, 128, 18, 2)
finish option=0                         # nothing
