# The Prince and the Hopper's box: a level 75 Warrior in Al Zahbi, the quest accepted at Prog 0 (GMs). Wajaom's zone-in
# plays 513 inside the box 680 -19 218 .. 691 -14 221, edges included: at the lower corner 680 -19 218: 513, finished:
# Prog 1; Prog 0 again (a GM): the upper corner 691 -14 221: 513, finished.
lists WajaomWoodlands/onZoneIn/1 WajaomWoodlands/onEventFinish/513
char zone=AlZahbi pos=-64,-7,38 job=WAR lvl=75
quest AhtUrhgan.ThePrinceAndTheHopper accepted
charvar Quest[6][67]Prog 0
login
warp 680,-19,218 WajaomWoodlands open   # the lower corner: 513
finish                                  # Prog 1
charvar Quest[6][67]Prog 0              # a GM
warp -64,-7,38 AlZahbi
warp 691,-14,221 WajaomWoodlands open   # the upper corner: 513
finish                                  # Prog 1
