# Class Reunion (battlefield.class_reunion, CloisterOfFrost, a BattlefieldQuest of Windurst.ClassReunion, a C# quest;
# index 1, 30 minutes, 6 players, no experience lost, the IcePendulum required and kept, ClassReunionProgress 5
# required, Ice_Protocrystal the exit). A level 75 Warrior with the quest accepted, the var 5 and the pendulum. The
# trade to IP_Entrance: the menu 32000 (index 1). Updates: 0: ignored; 4 (index 0, not in the menu): REQS_NOT_MET; 16
# (index 1, area 0) and 20 (area 4, past the zone's arenas): REQS_NOT_MET; 17 (area 1): registered, entered, the
# pendulum kept. Area 1's group killed (DRYAD and the 5 ids after it): WON; the win: battlefieldWin 481, 32001; its
# finish: onEventFinishWin: the var 5 -> 6. After the cleanup, out.
lists CloisterOfFrost/IP_Entrance/onTrade CloisterOfFrost/onEventUpdate/32000 CloisterOfFrost/onEventFinish/32000 CloisterOfFrost/onEventFinish/32001
char zone=CloisterOfFrost pos=561.5,-0.8,600.0 job=WAR lvl=75
quest Windurst.ClassReunion accepted
charvar ClassReunionProgress 5
item IcePendulum
login
trade IP_Entrance IcePendulum x1      # the pendulum, the var: the menu 32000
update 32000 option=0                   # 0: ignored
update 32000 option=4                   # index 0, not in the menu: REQS_NOT_MET
update 32000 option=16                  # index 1, area 0: REQS_NOT_MET
update 32000 option=20                  # index 1, area 4: REQS_NOT_MET
update 32000 option=17                  # index 1, area 1: registered, entered, the pendulum kept
finish                                  # in the arena
kill DRYAD
kill DRYAD+1
kill DRYAD+2
kill DRYAD+3
kill DRYAD+4
kill DRYAD+5
finish                                  # the battlefield's finish: onEventFinishWin: the var 5 -> 6
tick 11000                              # the won arena's cleanup
tick 10000                              # out of the battlefield
