mission Windurst TheShadowAwaits current
login
trigger _6q2                            # neither key item: nothing from the mission
finish-if-event
trigger Zubaba                          # neither: Zubaba's default 56
finish-if-event
missionstatus Windurst 4
keyitem ShadowFragment
charvar Mission[2][15]ReturnCS 1
warp 0,-16,126 WindurstWalls
warp 2,0.1,30 HeavensTower              # ReturnCS 1: no zone-in event
charvar Mission[2][15]ReturnCS 0
missionstatus Windurst 3
warp 0,-16,126 WindurstWalls
warp 2,0.1,30 HeavensTower              # status 3: no zone-in event
missionstatus Windurst 4
delkeyitem ShadowFragment
warp 0,-16,126 WindurstWalls
warp 2,0.1,30 HeavensTower              # no fragment: no zone-in event
missionstatus Windurst 3
warp -108,-6,0 ThroneRoom
trigger _4l1                            # status 3: the 32000 menu
update 32000 option=1                   # entered
finish
tick 2000
bfwin                                   # a GM: WON, battlefieldWin 160, 32001
localvar battlefieldWin 0               # a GM, inside the event
finish                                  # 32001 with battlefieldWin 0: the title; the mission does nothing
tick 11000
tick 10000
warp -108,-6,0 ThroneRoom
trigger _4l1                            # status 3: the 32000 menu
update 32000 option=1                   # entered
finish
tick 2000
bfwin                                   # a GM: WON, battlefieldWin 160, 32001
missionstatus Windurst 2                # a GM, inside the event
finish                                  # 32001 at status 2: the title; the mission does nothing
tick 11000
tick 10000
