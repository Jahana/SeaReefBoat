# The Secrets of Worship (CoP 4-3), the other five qm_prof qms (qm_prof_0, 2, 3, 4, 5) at Status 3 without the key and
# without the professor's var (a GM): each reaches its handler and has no 4-3 reply; the trace shows each qm's script,
# DRAWER_OPEN and DRAWER_EMPTY.
lists Sacrarium/qm_prof_0/onTrigger Sacrarium/qm_prof_2/onTrigger Sacrarium/qm_prof_3/onTrigger Sacrarium/qm_prof_4/onTrigger Sacrarium/qm_prof_5/onTrigger
char zone=Sacrarium pos=62,-3,100 job=WAR lvl=75 nation=0
mission Cop TheSecretsOfWorship current
charvar Mission[6][428]Status 3
login
trigger qm_prof_0
finish-if-event
trigger qm_prof_2
finish-if-event
trigger qm_prof_3
finish-if-event
trigger qm_prof_4
finish-if-event
trigger qm_prof_5
finish-if-event
