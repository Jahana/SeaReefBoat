trigger Door_Acolyte_Hostel_down        # 152 (an Event)
finish
trigger Door_Acolyte_Hostel_down        # the script's turn: its message, then 152
finish-if-event
trigger Door_Acolyte_Hostel_down        # 152 again
finish
warp -445.674,-1.831,342.417 SauromugueChampaignS
trigger Bulwark_Gate                    # Prog 0: 105
