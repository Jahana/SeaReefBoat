finish
trigger Koru-Moru                             # Prog 2: 286
finish
warp 165.5,-1.25,161.1 WindurstWaters
trigger Fuepepe                               # Prog 2: 458
finish                                        # completed: fame 30, the scroll; the mustZone; the test sheet kept
quest Windurst.MakingTheGrade available        # GM: a GM accept over a completed quest keeps it completed
quest Windurst.MakingTheGrade accepted
charvar Quest[2][4]Prog -1
