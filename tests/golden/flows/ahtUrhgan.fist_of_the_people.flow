trade Leypoint FrayedArrow x1           # not the medal: nil
finish-if-event
trade Leypoint RustyMedal x1 FrayedArrow x1   # the medal and more: nil
finish-if-event
charvar Quest[6][46]Prog 2              # a GM: Prog 2
