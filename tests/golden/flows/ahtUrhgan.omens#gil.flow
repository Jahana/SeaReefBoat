# Omens at exactly 1000 gil (711's and 713's `getGil() >= 1000`; the main flow holds 5000, #edges' main 500). Main (a
# level 50 Blue Mage, 1000 gil, Omens accepted at Prog 0): Waoud 711 (1000), option 1: the 1000 gil taken
# (PAY_DIVINATION). bob (the same at Prog 2, a GM's): 713 (1000), option 0: nothing; 713, option 1: the 1000 gil taken.
lists AhtUrhganWhitegate/Waoud/onTrigger AhtUrhganWhitegate/onEventFinish/711 AhtUrhganWhitegate/onEventFinish/713
char zone=AhtUrhganWhitegate pos=67.116,-6,-78.222 job=BLU lvl=50 gil=1000
char bob zone=AhtUrhganWhitegate pos=67.116,-6,-78.222 job=BLU lvl=50 gil=1000
quest AhtUrhgan.AnEmptyVessel completed
quest AhtUrhgan.Beginnings completed
quest AhtUrhgan.Omens accepted
bob: quest AhtUrhgan.AnEmptyVessel completed
bob: quest AhtUrhgan.Beginnings completed
bob: quest AhtUrhgan.Omens accepted
bob: charvar Quest[6][22]Prog 2
login
trigger Waoud                           # Prog 0: 711 (1000)
finish option=1                         # 1000 >= 1000: the 1000 gil taken, PAY_DIVINATION
trigger Waoud                           # 711 (0)
finish option=0
bob: login
bob: trigger Waoud                      # Prog 2: 713 (1000)
bob: finish option=0                    # not 1: nothing at 1000 gil
bob: trigger Waoud                      # 713 (1000)
bob: finish option=1                    # 1000 >= 1000: the 1000 gil taken, PAY_DIVINATION
bob: trigger Waoud                      # 713 (0)
bob: finish option=0
