# New Worlds Await (jeuno 133), MAX_LEVEL either side of 75 (xi.settings.main.MAX_LEVEL > 75): a level 75 Warrior with
# the Limit Breaker at cap 75. MAX_LEVEL 75: 10045 (75, 1, 0, 0) (quest number 0: no limit break offered); 76: 10045
# (75, 1, 1, 0).
lists RuludeGardens/Nomad_Moogle/onTrigger RuludeGardens/onEventFinish/10045
char zone=RuludeGardens pos=10.0,1.5,119.9 job=WAR lvl=75
keyitem LimitBreaker
levelcap 75
setting MAX_LEVEL 75
login
trigger Nomad_Moogle                    # MAX_LEVEL 75: 10045 (75, 1, 0, 0)
finish option=0
setting MAX_LEVEL 76
trigger Nomad_Moogle                    # MAX_LEVEL 76: 10045 (75, 1, 1, 0)
finish option=0
