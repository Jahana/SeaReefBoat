trigger Zauko                           # completed before: 116 (1)
update 116 option=0                     # begun again: Prog 1, Count 12, Timer 8001; updateEvent(1, 1)
finish
trigger _l00                            # 120 (1, 0)
finish option=1                         # Count 11
