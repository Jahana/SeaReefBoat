# In Defiant Challenge (jeuno 128), a level 50 Warrior, the level cap alone either side of 50 (a GM's setLevelCap):
# cap 49 and cap 51: no section (no other limit break answers at either), MAAT_DIALOG; cap 50: 79.
lists RuludeGardens/Maat/onTrigger RuludeGardens/onEventFinish/79
char zone=RuludeGardens pos=12.4,3.1,119.5 job=WAR lvl=50
levelcap 49
login
trigger Maat                            # cap 49: no section; MAAT_DIALOG
levelcap 51                             # a GM
trigger Maat                            # cap 51: no section; MAAT_DIALOG
levelcap 50                             # a GM
trigger Maat                            # cap 50: 79
finish option=0                         # nothing
