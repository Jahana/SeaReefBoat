finish                                  # begun
trigger Despachiaire                    # accepted: 144 (Event, importantOnce)
finish                                  # no accepted 144 handler: nothing
trigger Despachiaire                    # 144 down to Default: CoP 2-2's 106
finish
warp 86.3,-34.25,-71.1 TavnazianSafehold
trigger Odeya                           # Prog 0: nil; 150
finish
warp 116.8,-41.2,43.2 TavnazianSafehold
trigger Parelbriaux                     # Prog 0: 145
finish                                  # Prog 1
trigger Parelbriaux                     # Prog 1: 145
finish                                  # Prog 1
warp 86.3,-34.25,-71.1 TavnazianSafehold
trigger Odeya                           # Prog 1: 141
finish                                  # Prog 2
warp 116.8,-41.2,43.2 TavnazianSafehold
trigger Parelbriaux                     # Prog 2: nil; 294
finish
warp 86.3,-34.25,-71.1 TavnazianSafehold
trigger Odeya                           # Prog 2: 146
finish
trade Odeya TavnazianLiver x1           # Prog 2, the liver: 142
finish                                  # the liver taken; Prog 3
trigger Odeya                           # Prog 3: 147
finish
warp 140.5,-25.5,60 PhomiunaAqueducts
trigger _0r9                            # Prog 3: 37
finish                                  # Prog 4
trigger _0r9                            # Prog 4: nil; DOOR_FIRMLY_SHUT
warp 112.7,-40,-85.5 TavnazianSafehold
trigger Despachiaire                    # a new zone: 144 again
finish
warp 86.3,-34.25,-71.1 TavnazianSafehold
trigger Odeya                           # Prog 4: 143
finish                                  # completed; 4000 gil; Post 1
trigger Odeya                           # Post 1: 148
finish                                  # Post 2
trigger Odeya                           # Post 2: 148
finish                                  # Post 2
warp 140.5,-25.5,60 PhomiunaAqueducts   # onZoneOut at Post 2: quest:cleanup; Post 0
warp 86.3,-34.25,-71.1 TavnazianSafehold
trigger Odeya                           # Post 0: nil; 150
