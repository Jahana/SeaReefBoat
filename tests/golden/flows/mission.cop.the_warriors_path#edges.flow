# The Warrior's Path (CoP 7-5): the zone-ins and the Iron Gate at the statuses they do not answer (GMs set the vars).
# Login in Sealion's Den at Status 3: nothing. _0w0 at Status 2: IRON_GATE_LOCKED (7110, the zone's default; no 7-5
# reply, no menu). Al'Taieu's zone-in at Status 2 and 4: nothing. Sealion's Den's zone-in with Option 1 while 7-5 is
# current (Status 4): nothing.
lists SealionsDen/_0w0/onTrigger SealionsDen/onZoneIn/1 Altaieu/onZoneIn/1 SealionsDen/Sueleen/onTrigger
char zone=SealionsDen pos=612,132,774 job=WAR lvl=75 nation=0
mission Cop TheWarriorsPath current
charvar Mission[6][748]Status 3
login                                   # Status 3: nothing
charvar Mission[6][748]Status 2         # a GM
trigger _0w0                            # Status 2: 7110 (the default)
finish-if-event
warp -422,0,-532 Altaieu                # Status 2: nothing
charvar Mission[6][748]Status 4         # a GM
warp -422,0,-532 Altaieu                # Status 4: nothing
charvar Mission[6][748]Option 1         # a GM
warp 612,132,776 SealionsDen            # 7-5 current: nothing
