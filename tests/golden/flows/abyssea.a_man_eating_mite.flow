quest Abyssea.AManEatingMite available  # a GM
trigger Cavernous_Maw                   # 58 again (the kind)
finish option=2                         # begun (any option)
trigger Cavernous_Maw                   # accepted: no maw handler: 204
finish                                  # option 0: no warp
rezone                                  # accepted, no title: nothing
title ReshephEradicator                 # a GM
rezone open                             # the title: 59, left open
update 59 option=0                      # option 0: nothing
update 59 option=2                      # option 2: nothing
update 59 option=1                      # option 1: updateEvent(Ivory Abyssite of Prosperity)
finish                                  # Ivory Abyssite of Prosperity given; completed
rezone                                  # completed: nothing
trigger Cavernous_Maw                   # completed: no section: 204
finish                                  # option 0: no warp
