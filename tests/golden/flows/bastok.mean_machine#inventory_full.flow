# Mean Machine with a full inventory: 557 plays, the Scroll of Warp is refused with the message, the quest stays
# accepted and the oil is kept; once there is room the same trade completes it.
char zone=Metalworks pos=-58,2,30
item VialOfSlimeOil
quest Bastok.MeanMachine accepted
login
fill-inventory
trade Unlucky_Rat VialOfSlimeOil x1  # 557
finish                          # the inventory full: not completed, the oil kept
free-inventory
trade Unlucky_Rat VialOfSlimeOil x1  # 557 again
finish                          # completed: the Scroll of Warp, fame 20
