trigger Leepe-Hoppe                     # default 345
finish
trigger Leepe-Hoppe                     # accepted, progress 1: 889
finish
charvar TuningOut_Progress 8
trigger Leepe-Hoppe                     # default 345
finish
trigger Leepe-Hoppe                     # progress 8: 897
fill-inventory
finish                                  # the Cache-Nez does not fit: nothing; progress 8
free-inventory
trigger Leepe-Hoppe                     # default 345
finish
trigger Leepe-Hoppe                     # 897
finish                                  # the Cache-Nez; Friend of the Helmed; fame 40; completed; progress 0
trigger Leepe-Hoppe                     # default 345
finish
trigger Leepe-Hoppe                     # completed: nothing from his script, so 345 again
finish
