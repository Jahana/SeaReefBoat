tick 1000
tick 1000
wait jst=1                              # again
tick 1000
tick 1000
kill ARCHLICH_TABERQUOAN                # allDeath: Sorcerers, Warriors +3 to +6 told despawned; WON
tick 2000
tick 2000
tick 2000
tick 2000
tick 2000
tick 2000
finish                                  # 32001: Archmage Assassin; Darkness Rising: the Burnt Seal, status 12
