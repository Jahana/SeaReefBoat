trigger Gentle_Tiger                            # 47 first
finish
trigger Gentle_Tiger                            # the offer
finish
quest CrystalWar.FiresOfDiscontent completed # a GM: LightInTheDarkness available
trigger Gentle_Tiger                            # 47 first
finish
trigger Gentle_Tiger                            # the offer
finish
quest CrystalWar.LightInTheDarkness completed # a GM: BurdenOfSuspicion available
trigger Gentle_Tiger                            # 47 first
finish
trigger Gentle_Tiger                            # the offer
