finish-if-event option=4
trigger Mashuu-Ajuu                     # his default 429
finish
trigger Mashuu-Ajuu                     # the roll: 463 (option 4: nothing) or nothing
finish-if-event option=4
free-inventory
quest Windurst.ReapWhatYouSow completed
rezone
fill-inventory
trigger Mashuu-Ajuu                     # his default 429
finish
trigger Mashuu-Ajuu                     # his script: completed, var 0: the roll: 479 (option 0: nothing) or nothing
