# Mog House Exposition, section 1 in the Windurst Mog Houses: a char of nation 2 (a GM's notSeen 1 before each
# entry: charCreate writes it): in the home nation's Mog House the zone-in 30000 (the zoneline finishes it with 0):
# quest:complete (the vars cleared), oNation 1. `zoneline <Zone>` is the zone's line to its own Mog House.
lists WindurstWaters/onZoneIn/1 WindurstWaters/onEventFinish/30000 WindurstWalls/onZoneIn/1 WindurstWalls/onEventFinish/30000 PortWindurst/onZoneIn/1 PortWindurst/onEventFinish/30000 WindurstWoods/onZoneIn/1 WindurstWoods/onEventFinish/30000
char zone=WindurstWaters pos=-50.9,-6.25,109.3 job=WAR lvl=1 nation=2
login
warp -50.9,-6.25,109.3 WindurstWaters
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline WindurstWaters          # the home Mog House: 30000 (finished with 0): complete; oNation 1
warp -120.188,-5.5,122.428 WindurstWalls
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline WindurstWalls           # the home Mog House: 30000 (finished with 0): complete; oNation 1
warp 0.201,-6,186.699 PortWindurst
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline PortWindurst            # the home Mog House: 30000 (finished with 0): complete; oNation 1
warp -23.8,2.5,-44.6 WindurstWoods
charvar HQuest[moghouseExpo]notSeen 1  # a GM
zoneline WindurstWoods           # the home Mog House: 30000 (finished with 0): complete; oNation 1
