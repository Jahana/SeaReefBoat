# Twinstone Bonding (windurst 62) with a full inventory (accepted, GiohAijhriSpokenTo 1 by a GM): the earring: 490; its
# finish confirms the trade before npcUtil.completeQuest, so the Wrapped Bow has the earring's slot: completed.
char zone=WindurstWoods pos=106.2,-4.75,173.9 job=WAR lvl=75
item TwinstoneEarring
charvar GiohAijhriSpokenTo 1
login
quest Windurst.TwinstoneBonding accepted
trigger Gioh_Ajihri                     # accepted: 488 (beside him)
finish                                  # var 1
fill-inventory
trade Gioh_Ajihri TwinstoneEarring x1   # 490
finish                                  # the earring taken first; the Wrapped Bow; fame 16; Bond Fixer; completed
