<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Phase-0 spike builds/verifies offline on the installed net10 runtime.
         The product library will target net8.0 in Phase 1; TFM does not affect
         protocol parity, so we pick the one that needs no network restore here. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>XI.Crypto</AssemblyName>
    <RootNamespace>XI.Crypto</RootNamespace>
  </PropertyGroup>
</Project>
