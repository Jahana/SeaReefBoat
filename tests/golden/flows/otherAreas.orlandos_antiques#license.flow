# Orlando's Antiques (otherAreas 7): the fame and license edges. Windurst fame level 2 (50) without the Chocobo License:
# 100; the license with fame 49 (level 1, one point short): 100.
char zone=Mhaura pos=-36.5,-8.0,59.3 job=WAR lvl=20
fame Windurst 50
login
trigger Orlando                         # fame level 2, no license: 100
finish
fame Windurst 49                        # a GM: level 1
keyitem ChocoboLicense                  # a GM
trigger Orlando                         # the license, fame level 1: 100
finish
