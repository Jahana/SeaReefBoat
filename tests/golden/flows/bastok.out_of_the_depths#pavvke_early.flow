# Out of the Depths accepted below Prog 4: Pavvke's handler is nil (his default 75, Fallen Comrades completed).
lists BastokMines/Pavvke/onTrigger
char zone=BastokMines pos=16.6,7,-13.3
quest Bastok.FallenComrades completed
quest Bastok.OutOfTheDepths accepted
charvar Quest[1][75]Prog 2
login
trigger Pavvke                       # Prog 2: nil, 75
finish-if-event
