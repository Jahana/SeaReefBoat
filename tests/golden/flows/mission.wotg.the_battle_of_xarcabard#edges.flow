# The Battle of Xarcabard (WotG 30) at Status 1 (a GM): the login plays no zone-in event. At Status 0 (a GM) Rally
# Point: Red plays nothing: an event release only (the NPC has no default reply).
lists XarcabardS/onZoneIn/1 XarcabardS/Rally_Point_Red/onTrigger XarcabardS/onEventFinish/17 XarcabardS/onEventFinish/18
char zone=XarcabardS pos=-106.071,-25.5,-50 job=WAR lvl=99
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Wotg TheBattleOfXarcabard current
charvar Mission[5][29]Status 1
login                                      # Status 1: no zone-in event
charvar Mission[5][29]Status 0
trigger Rally_Point_Red                    # Status 0: not the mission's
finish-if-event
