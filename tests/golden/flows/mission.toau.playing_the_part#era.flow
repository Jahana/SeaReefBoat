# Playing the Part (ToAU 25) with the RoV era module: the Timer 1: Naja; the must-zone var set with the Timer 0:
# Naja; a rezone (it clears the var), the Timer 0: Naja 3110, finished: completed.
module modules/era/lua/missions/mission_adjustments.lua
lists AhtUrhganWhitegate/Naja_Salaheem/onTrigger AhtUrhganWhitegate/onEventFinish/3110
char zone=AhtUrhganWhitegate pos=40,-6,-30 job=WAR lvl=75 nation=1
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Toau PlayingThePart current
setting RESTRICT_CONTENT 1
setting ENABLE_ROV 0
login
tick 1000
tick 1000
tick 1000
charvar Mission[4][24]Timer 1
trigger Naja_Salaheem
finish-if-event
charvar Mission[4][24]mustZone 1
charvar Mission[4][24]Timer 0
trigger Naja_Salaheem
finish-if-event
rezone
tick 1000
tick 1000
tick 1000
charvar Mission[4][24]Timer 0
trigger Naja_Salaheem
finish
