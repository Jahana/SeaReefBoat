# The Doorman (bastok 54): a MNK 40 is not offered it (Phara's default 150); the hide flap while available does nothing.
char zone=BastokMines pos=75,0,-80 job=MNK lvl=40
login
trigger Phara                   # not WAR: nil, 150
finish
warp 263,4,-249 Davoi
trigger Hide_Flap_1 at=0.5      # available: no quest handler; the default FIND_ORC_TENT
finish-if-event
