trigger Joachim                         # Prog 1, all six still: 344 again (the kind)
finish                                  # held: npcUtil gives nothing, no message; Prog 1
wait vana=18                            # 12:00 (the next day)
warp -0.011,-1.848,-176.133 HallOfTheGods # Prog 1 at 12:00: nothing
warp -51.344,0,-9.978 PortJeuno
wait vana=5                             # 17:00
warp -0.011,-1.848,-176.133 HallOfTheGods # Prog 1 at 17:00: nothing (not >= 18, not < 5)
warp -51.344,0,-9.978 PortJeuno
wait vana=1                             # 18:00
warp -0.011,-1.848,-176.133 HallOfTheGods open # Prog 1 at 18:00 (>= 18): 8, left open
finish                                  # completed; Beneath a Blood Red Sky accepted
quest Abyssea.BeneathABloodRedSky available # a GM
quest Abyssea.EmissariesOfGod available # a GM
quest Abyssea.EmissariesOfGod accepted  # a GM
