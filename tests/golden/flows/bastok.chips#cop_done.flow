# Chips's guard, the completed side: CoP One to be Feared done (Chains and Bonds current: hasCompletedMission counts a CoP
# mission below the current one) plays 169 with no Status var.
lists LowerJeuno/Ghebi_Damomohe/onTrigger
char zone=LowerJeuno pos=15.5,-0.1,-6.1
mission Cop ChainsAndBonds current
login
trigger Ghebi_Damomohe               # One to be Feared completed: 169
finish option=1                      # the mustZone set
