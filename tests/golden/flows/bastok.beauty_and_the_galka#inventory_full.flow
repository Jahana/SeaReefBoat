# Beauty and the Galka with a full inventory: 10 plays, the Bronze Knife does not fit, the quest stays accepted and the
# logs are kept; once there is room 10 again completes it.
char zone=BastokMines pos=-14.4,6.999,56
keyitem PalboroughMinesLogs
quest Bastok.BeautyAndTheGalka accepted
login
fill-inventory
trigger Parraggoh               # the logs: 10
finish                          # the inventory full: not completed, the logs kept
free-inventory
trigger Parraggoh               # 10 again
finish                          # completed: Bronze Knife, Norg fame +30, the logs gone
