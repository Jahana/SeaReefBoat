# Mog House Exposition's zone-in (section 1) against Moon Reading, which has no Mog House guard (239), in Windurst
# Walls' home Mog House: a char of nation 2, ROV off, both notSeen 1 (a GM). Moon Reading at status 4.
char zone=WindurstWalls pos=0,-16.75,130 job=WAR lvl=75 nation=2
setting ENABLE_ROV 0
login
mission Windurst MoonReading current    # a GM
missionstatus Windurst 4                # a GM
charvar HQuest[moghouseExpo]notSeen 1   # a GM
charvar HQuest[newCharacterCS]notSeen 1 # a GM
warp 0,-16.75,130 WindurstWalls
zoneline WindurstWalls                  # the home Mog House
finish
