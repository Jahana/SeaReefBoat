# The Mothercrystals, the telepoints' other arms (CoP 1-3). 1-3 current. One light (Holla's, a GM) and Option 3 (a GM):
# Konschtat: not its crag, not 0, one light: the seal 918 (2), finished with 1: nothing; with 0: Option 0 and
# MEMORIES_SEALED_OFF. La Theine with the light of Dem and Option 3: the seal 212 (2), finished with 0. Tahrongi with the
# light of Holla and Option 1: the seal 918 (0), finished with 0 (Tahrongi's text). Two lights (Holla's and Mea's) and
# Option 2: Konschtat's entry 913 (two lights), finished with 1: nothing; with 0: the Hall. La Theine (the light of
# Holla held): the plain 202, finished with 0. Tahrongi (the light of Mea held): the plain 913, finished with 0.
lists KonschtatHighlands/onEventFinish/913 KonschtatHighlands/onEventFinish/918 LaTheinePlateau/onEventFinish/202 LaTheinePlateau/onEventFinish/212 TahrongiCanyon/onEventFinish/913 TahrongiCanyon/onEventFinish/918
char zone=KonschtatHighlands pos=135,19,220 job=WAR lvl=75 nation=0
mission Cop TheMothercrystals current
keyitem LightOfHolla
charvar Mission[6][128]Option 3
login
trigger Shattered_Telepoint             # Option 3, one light: the seal 918
finish option=1                         # not 0: nothing
trigger Shattered_Telepoint
finish option=0                         # Option 0, MEMORIES_SEALED_OFF
delkeyitem LightOfHolla                 # a GM
keyitem LightOfDem                      # a GM
charvar Mission[6][128]Option 3         # a GM
warp 334,19,-60 LaTheinePlateau
trigger Shattered_Telepoint             # Option 3, no light of Holla: the seal 212
finish option=0
delkeyitem LightOfDem                   # a GM
keyitem LightOfHolla                    # a GM
charvar Mission[6][128]Option 1         # a GM
warp 179,35,255 TahrongiCanyon
trigger Shattered_Telepoint             # Option 1, light of Holla: the seal 918
finish option=0 expect-error "bad argument #2 (number expected, got nil)"   # Tahrongi's text has no MEMORIES_SEALED_OFF
keyitem LightOfMea                      # a GM: two lights
charvar Mission[6][128]Option 2         # a GM
warp 135,19,220 KonschtatHighlands
trigger Shattered_Telepoint             # two lights: 913
finish option=1                         # not 0: nothing
trigger Shattered_Telepoint
finish option=0                         # the Hall
warp -267.194,-40.634,-280.019 HallOfTransference
                                        # the zone-in 155 (two lights, none of Dem, Status 0), answered: Promyvion - Dem
warp 185.891,0,-52.331 PromyvionDem
warp 334,19,-60 LaTheinePlateau
trigger Shattered_Telepoint             # the light of Holla held: the plain 202
finish option=0
warp -266.76,-0.635,280.058 HallOfTransference
warp 179,35,255 TahrongiCanyon
trigger Shattered_Telepoint             # the light of Mea held: the plain 913
finish option=0
