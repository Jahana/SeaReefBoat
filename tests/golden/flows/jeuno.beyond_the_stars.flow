# Beyond the Stars (jeuno 135, limit break 8): the Nomad Moogle in Ru'Lude Gardens (default 10045 (0, 0, 2, 0)). A level
# 81 Warrior with the Limit Breaker at level cap 85, New Worlds Await and Expanding Horizons completed (a GM, before
# login), MAX_LEVEL 99, 5 merit points. Available: ten Kindred's Crests (no trade handler while available: nothing);
# 10045 (81, 1, 3, 0), finish options 0, 8 and 10 (nothing), then 9 (begun). Accepted, Prog 0: event 10045 (81, 1, 3, 1),
# (81, 2, 3, 1) once the Limit Breaker is gone (a GM); Prog 2 (a GM): the same reminder (not 1). The trade: ten crests
# with 4 merit points (nil); with 5: nine, eleven, ten and a stone, ten Kindred's Seals (nil each); ten crests: 10137,
# finished with 7 merit points (a GM, 10137 open): the crests taken (confirmTrade), 7 - 5 = 2 merit points, Prog 1.
# Prog 1: progressEvent 10161 (81, 0), the rock-paper-scissors game: each update's option picks Maat's move (21 red 0,
# 22 blue 1, 23 green 2, any other 0), Degenhard's is math.randomInt(0, 2) (the seeded RNG), and the reply is
# maatMove + degenhardMove * 4 + outcome * 16 (outcome 2 a draw, 0 Maat wins, 1 Degenhard wins). Finish options 0, 253
# and 255: nothing; 254 with a full bag (no item reward): completed, level cap 90, YOUR_LEVEL_LIMIT_IS_NOW_90.
# Completed: Dormant Powers Dislodged answers at cap 90 (81, 1, 3, 2, 0, its draw); at cap 85 again (a GM): the default;
# ten crests: nothing.
lists RuludeGardens/Nomad_Moogle/onTrigger RuludeGardens/Nomad_Moogle/onTrade RuludeGardens/onEventUpdate/10161 RuludeGardens/onEventFinish/10045 RuludeGardens/onEventFinish/10137 RuludeGardens/onEventFinish/10161
char zone=RuludeGardens pos=10.0,1.5,119.9 job=WAR lvl=81
keyitem LimitBreaker
levelcap 85
merits 5
quest Jeuno.NewWorldsAwait completed
quest Jeuno.ExpandingHorizons completed
item KindredsCrest x21
item KindredsSeal x10
item FlintStone
login
trade Nomad_Moogle KindredsCrest x10    # available, 5 merit points: no trade handler, nothing
trigger Nomad_Moogle                    # cap 85, EH completed, level 81: 10045 (81, 1, 3, 0)
finish option=0                         # not 9: nothing
trigger Nomad_Moogle                    # 10045 (81, 1, 3, 0)
finish option=8                         # not 9: nothing
trigger Nomad_Moogle                    # 10045 (81, 1, 3, 0)
finish option=10                        # not 9: nothing
trigger Nomad_Moogle                    # 10045 (81, 1, 3, 0)
finish option=9                         # begun
trigger Nomad_Moogle                    # accepted, Prog 0: event 10045 (81, 1, 3, 1)
finish
delkeyitem LimitBreaker                 # a GM
trigger Nomad_Moogle                    # no Limit Breaker: event 10045 (81, 2, 3, 1)
finish
keyitem LimitBreaker                    # a GM
charvar Quest[3][135]Prog 2             # a GM
trigger Nomad_Moogle                    # Prog 2 (not 1): event 10045 (81, 1, 3, 1)
finish
charvar Quest[3][135]Prog 0             # a GM
merits 4                                # a GM
trade Nomad_Moogle KindredsCrest x10    # ten crests, 4 merit points: nil
merits 5                                # a GM
trade Nomad_Moogle KindredsCrest x9     # nine: nil
trade Nomad_Moogle KindredsCrest x11    # eleven: nil
trade Nomad_Moogle KindredsCrest x10 FlintStone x1  # ten and a stone: nil
trade Nomad_Moogle KindredsSeal x10     # ten seals, not crests: nil
trade Nomad_Moogle KindredsCrest x10    # ten crests, 5 merit points: 10137
merits 7                                # a GM, 10137 open
finish                                  # the crests taken, merits 2, Prog 1
trigger Nomad_Moogle                    # Prog 1: progressEvent 10161 (81, 0)
update 10161 option=21                  # Maat red (0), Degenhard drawn
update 10161 option=22                  # Maat blue (1)
update 10161 option=23                  # Maat green (2)
update 10161 option=21
update 10161 option=22
update 10161 option=23
update 10161 option=21
update 10161 option=22
update 10161 option=23
update 10161 option=20                  # not 21-23: Maat red (0)
update 10161 option=24                  # not 21-23: Maat red (0)
update 10161 option=23
update 10161 option=21
update 10161 option=23
update 10161 option=21
update 10161 option=23
update 10161 option=21
update 10161 option=23
update 10161 option=21
finish option=0                         # not 254: nothing
trigger Nomad_Moogle                    # 10161 (81, 0)
finish option=253                       # nothing
trigger Nomad_Moogle                    # 10161 (81, 0)
finish option=255                       # nothing
trigger Nomad_Moogle                    # 10161 (81, 0)
fill-inventory
finish option=254                       # completed: level cap 90, the message
free-inventory
trigger Nomad_Moogle                    # completed; Dormant Powers Dislodged (BtS completed, cap 90), level 81: 10045 (81, 1, 3, 2, 0, drawn)
finish option=0
levelcap 85                             # a GM
trigger Nomad_Moogle                    # completed, cap 85: no section; the default 10045 (0, 0, 2, 0)
finish
trade Nomad_Moogle KindredsCrest x10    # completed: no trade handler answers: nothing
