finish                                  # Biggorf 1; Paul 0: Prog 1
trigger Paul                            # Paul 0: 193
finish                                  # Paul 1; all three: Prog 2
charvar Quest[7][42]Prog 1              # a GM
trigger Biggorf                         # Prog 1, Biggorf 1: 197
