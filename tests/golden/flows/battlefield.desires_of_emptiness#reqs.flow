# Desires of Emptiness, the requirements. A level 75 Warrior of San d'Oria with 5-2 current at Status 1 (below
# requiredValue 2): _0n0: no options. Status 3 (past it): no options. Status 2 (a GM): the menu 32000; area 1: entered;
# the win's 32001 finished after a GM took the Status back to 1: the mission's handler does nothing.
lists SpireOfVahzl/_0n0/onTrigger SpireOfVahzl/onEventUpdate/32000 SpireOfVahzl/onEventFinish/32000 SpireOfVahzl/onEventFinish/32001
char zone=SpireOfVahzl pos=0,0,0 job=WAR lvl=75 nation=0
mission Cop DesiresOfEmptiness current
charvar Mission[6][518]Status 2
login
charvar Mission[6][518]Status 1         # a GM
trigger _0n0                            # Status 1: no options
finish-if-event
charvar Mission[6][518]Status 3
trigger _0n0                            # Status 3: no options
finish-if-event
charvar Mission[6][518]Status 2
trigger _0n0                            # the menu 32000
update 32000 option=1                   # entered
finish                                  # in the arena
tick 2000
kill AGONIZER
kill AGONIZER+1
kill AGONIZER+6                         # WON: 32001
charvar Mission[6][518]Status 1         # a GM: the Status goes back
finish                                  # 32001: nothing
tick 11000
tick 10000
