warp -301.5,-9.2,95 SouthernSanDoria
trigger Hinaree
finish-if-event
charvar Mission[6][840]Option 31
charvar Mission[6][840]LProg 1
trigger Hinaree
finish-if-event
tick 3000
walk -275,-9,97
finish-if-event
walk -301.5,-9.2,95
charvar Mission[6][840]LProg 0
warp -298.3,-51.9,-18.9 UleguerandRange
charvar Mission[6][840]LProg 2
warp -298.3,-51.9,-18.9 UleguerandRange
charvar Mission[6][840]Option 0
charvar Mission[6][840]Status 3
warp 0,3,100 RuludeGardens
tick 3000
walk 0,3,60
walk 0,3,100
