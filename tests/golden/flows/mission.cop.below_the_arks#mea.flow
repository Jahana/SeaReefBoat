# Below the Arks, the Mea crag (CoP 1-2). Status 1 (a GM). The Tahrongi telepoint (Option 0): 913 with the first-entry
# flag, finished with 0: the Hall of Transference. _0e7 (Option 0): 160 sends the char to Promyvion - Mea (crag 3:
# ceil(7 / 3)); its zone-in: 50, finished: Option 3. In the Hall: _0e2 (location 3 = Option 3): no message. _0e7 (Option
# 3, no light of Mea): 128, finished with 0: Option 0 and out to Tahrongi. Tahrongi with Option 1 (a GM): the seal 918,
# finished with 0: Option 0 and MEMORIES_SEALED_OFF (Tahrongi's text). The Spire of Mea: _0l0, the fight won (the
# Delver): 32001 (newPromy 1, the light of Mea, one light at 1-2: complete).
lists TahrongiCanyon/Shattered_Telepoint/onTrigger TahrongiCanyon/onEventFinish/913 TahrongiCanyon/onEventFinish/918 HallOfTransference/_0e2/onTrigger HallOfTransference/_0e7/onTrigger HallOfTransference/onEventFinish/128 HallOfTransference/onEventFinish/160 PromyvionMea/onZoneIn/1 PromyvionMea/onEventFinish/50 SpireOfMea/onEventFinish/32001
char zone=TahrongiCanyon pos=179,35,255 job=WAR lvl=75 nation=0
mission Cop BelowTheArks current
charvar Mission[6][118]Status 1
login
trigger Shattered_Telepoint             # Option 0: 913, the first-entry flag
finish option=0                         # setPos to the Hall of Transference
warp 280.066,-80.635,-67.096 HallOfTransference
trigger _0e7                            # Option 0, 1-2: 160
finish                                  # the Mea promyvion
warp -93.268,0,170.749 PromyvionMea     # 50
finish                                  # Option 3
warp 270,-84.9,-36.299 HallOfTransference
trigger _0e2                            # location 3 = Option 3: no message, the door's own event 150
finish
trigger _0e7                            # Option 3 = crag 3, no light: 128
finish option=0                         # Option 0; out to Tahrongi
charvar Mission[6][118]Option 1         # a GM
warp 179,35,255 TahrongiCanyon
trigger Shattered_Telepoint             # Option 1: the seal 918 (0)
finish option=0 expect-error "bad argument #2 (number expected, got nil)"   # Option 0; Tahrongi's text has no MEMORIES_SEALED_OFF: the Lua raises
warp 0,-3.8,240 SpireOfMea
trigger _0l0
update 32000 option=1
finish
tick 2000
kill DELVER
finish                                  # 32001: the light of Mea, the mission complete
