# Beyond Infinity, Waughroon Shrine (battlefield.beyond_infinity_waughroon_shrine): the registrant's requirements. main has the quest
# accepted but no clasp, bob has the clasp but the quest only available: each gets the requirements message and a
# release, no menu. cat and dan are declared and never log in or trigger.
lists WaughroonShrine/BC_Entrance/onTrigger
char zone=WaughroonShrine pos=-338.1,104.3,-260.3 job=WAR lvl=75
char bob zone=WaughroonShrine pos=-338.1,104.3,-260.3 job=WAR lvl=75
char cat zone=WaughroonShrine pos=-338.1,104.3,-260.3 job=WAR lvl=75
char dan zone=WaughroonShrine pos=-338.1,104.3,-260.3 job=WAR lvl=75
quest Jeuno.BeyondInfinity accepted
bob: keyitem SoulGemClasp
login
bob: login
trigger BC_Entrance
bob: trigger BC_Entrance
