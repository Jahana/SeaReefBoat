# Ark Angels 3 (index 2), at Zilart status 1 with the Shard of Envy not held. qm1_3 opens the menu; option 0 is ignored
# and another fight's option not offered; this one's option enters area 1 (the framework's entry texts). Killing the Ark
# Angel wins (its group's all-death): 32001, whose finish is the mission's, giving the Shard of Envy.
lists LaloffAmphitheater/qm1_3/onTrigger LaloffAmphitheater/onEventUpdate/32000 LaloffAmphitheater/onEventFinish/32000 LaloffAmphitheater/onEventFinish/32001 LaloffAmphitheater/onEventFinish/32002 LaloffAmphitheater/qm2/onTrigger LaloffAmphitheater/onEventFinish/32003
char zone=LaloffAmphitheater pos=15.648,-224.334,488.125 job=WAR lvl=99 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart ArkAngels current
login
missionstatus Zilart 1                  # a GM
effect 50                               # a GM: Invincible
effect 522
effect 49
trigger qm1_3                           # the menu
update 32000 option=0                   # ignored
update 32000 option=49                  # not offered
update 32000 option=33                  # index 2, area 1: entered
finish
tick 2000
kill ARK_ANGEL_MR                     # won: 32001
finish                                  # the mission's: the ShardOfEnvy
tick 11000
tick 10000
