# Making Headlines (windurst 37): the 665 finish with a non-zero option. Naiko-Paneiko's finish begins the quest on any
# option (the Lua's addQuest ignores it), so option 1 begins it as option 0 does (the main flow).
char zone=WindurstWaters pos=-245.4,-5.3,-308.0 job=WAR lvl=75
login
trigger Naiko-Paneiko                   # available: 665
finish option=1                         # begun (any option)
trigger Naiko-Paneiko                   # accepted, the scoops not all: 666 or 671 (the roll)
finish
