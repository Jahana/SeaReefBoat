# One to be Feared, area 2. A level 75 Warrior of San d'Oria with 6-4 current at Status 3 (a GM): the menu 32000; area 2
# (option 2): entered; its three phases (five Mammets, Omega, Ultima) fought through the airship door as in area 1; the
# win: 32001, finished: Status 4.
lists SealionsDen/_0w0/onTrigger SealionsDen/Airship_Door/onTrigger SealionsDen/onEventUpdate/32000 SealionsDen/onEventUpdate/1 SealionsDen/onEventUpdate/2 SealionsDen/onEventFinish/32000 SealionsDen/onEventFinish/32001 SealionsDen/onEventFinish/32003 SealionsDen/onEventFinish/10 SealionsDen/onEventFinish/11
char zone=SealionsDen pos=0,0,0 job=WAR lvl=75 nation=0
mission Cop OneToBeFeared current
charvar Mission[6][638]Status 3
login
trigger _0w0                            # the menu 32000
update 32000 option=2                  # index 0, area 2: entered
finish                                  # in the arena
tick 2000
kill MAMMET_22_ZETA+7
kill MAMMET_22_ZETA+8
kill MAMMET_22_ZETA+9
kill MAMMET_22_ZETA+10
kill MAMMET_22_ZETA+11
finish                                  # event 10
trigger Airship_Door
finish option=100                       # event 1
update 1 option=0                       # Omega spawns
finish
kill MAMMET_22_ZETA+12                   # event 11
finish
trigger Airship_Door
finish option=101                       # event 2
update 2 option=0                       # Ultima spawns
finish
kill MAMMET_22_ZETA+13                   # WON: 32001
finish                                  # Status 4
tick 11000
tick 10000
