# Trial-Size Trial by Water (outlands 148): a SMN of level 19 at Norg fame level 2 is not offered: the default 114 on
# both talks (the script's quest nil on the second). The fork's trade while available: nothing (her onTrade wants the
# quest accepted).
char zone=Norg pos=-12.5,1.1,-22.5 job=SMN lvl=19
fame Norg 50
item MiniTuningForkOfWater
login
trade Verctissa MiniTuningForkOfWater x1  # available: nothing
trigger Verctissa                         # UseFallback 0: the default 114
finish
trigger Verctissa                         # the script: level 19: the quest's nil; the default 114
finish
