# Expanding Horizons (jeuno 134), the level cap alone either side of 80: a level 76 Warrior with the Limit Breaker, New
# Worlds Await completed. Cap 79 and 81: no section (Beyond the Stars wants Expanding Horizons completed), the default
# 10045 (0, 0, 2, 0); cap 80: 10045 (76, 1, 2, 0).
lists RuludeGardens/Nomad_Moogle/onTrigger RuludeGardens/onEventFinish/10045
char zone=RuludeGardens pos=10.0,1.5,119.9 job=WAR lvl=76
keyitem LimitBreaker
levelcap 79
quest Jeuno.NewWorldsAwait completed
login
trigger Nomad_Moogle                    # cap 79: no section; the default 10045 (0, 0, 2, 0)
finish
levelcap 81                             # a GM
trigger Nomad_Moogle                    # cap 81: no section; the default 10045 (0, 0, 2, 0)
finish
levelcap 80                             # a GM
trigger Nomad_Moogle                    # cap 80: 10045 (76, 1, 2, 0)
finish option=0
