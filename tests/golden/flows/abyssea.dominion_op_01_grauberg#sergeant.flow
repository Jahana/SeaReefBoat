finish                                  # type 0: nothing
kill IRONCLAD_SUNDERER-33               # Prog 1 (17818008)
kill IRONCLAD_SUNDERER-32               # Prog 2 (17818009)
kill IRONCLAD_SUNDERER-31               # Prog 3 (17818010)
kill IRONCLAD_SUNDERER-30               # Prog 4 (17818011)
kill IRONCLAD_SUNDERER-29               # Prog 5 (17818012)
trigger DSgt_Wolfgang                   # 5 of 5: 500 (status 2)
finish option=8                         # type 8: completed; exp, cruor, notes; vars cleared
kill IRONCLAD_SUNDERER-28               # completed: nothing (17818013)
trigger DSgt_Wolfgang                   # no active op: 500
finish option=18                        # type 2: addQuest on the completed op
kill IRONCLAD_SUNDERER-27               # still completed: nothing (17818014)
trigger DSgt_Wolfgang                   # the op on: 500 (0 of 5, status 1)
finish option=3                         # type 3: cancelled (delQuest), vars cleared
kill IRONCLAD_SUNDERER-26               # cancelled: nothing (17818015)
trigger DSgt_Wolfgang                   # no active op: 500
finish option=34                        # type 2, op 2: op #02 added
kill IRONCLAD_SUNDERER-65               # Monitor: Quest[8][116]Prog 1 (17817976)
