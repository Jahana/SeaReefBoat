# Class Reunion (windurst 82): the rewards already held, an SMN 75 with The Puppet Master completed.
# Carbuncle's Tear held (GM) at the door: 413; npcUtil.giveKeyItem gives nothing (no message). Var 1 without the tear
# (GM): 412 all the same. Evoker's Spats held (rare) at 410 (var 6 by GM, both students talked to): the free-slot test
# passes, addItem fails, ITEM_OBTAINED is still sent and the quest completes (the vars 0, needToZone, fame 20).
char zone=WindurstWalls pos=-24.5,-14.5,263.0 job=SMN lvl=75
quest Windurst.ThePuppetMaster completed
keyitem CarbunclesTear
item EvokersSpats
login
trigger _6n2                            # the default's turn: DOORS_SEALED_SHUT
trigger _6n2                            # 413
finish                                  # begun; the tear held: no key item message; var 1
delkeyitem CarbunclesTear
warp -120.2,-5.5,122.4 WindurstWalls
trigger Koru-Moru                       # the default's turn: 193
finish
trigger Koru-Moru                       # var 1, no tear: 412
finish                                  # delKeyItem of a tear not held; var 2
charvar ClassReunionProgress 6
charvar ClassReunion_TalkedToFupepe 1
charvar ClassReunion_TalkedToFurakku 1
trigger Koru-Moru                       # the default's turn: 193
finish
trigger Koru-Moru                       # var 6, both talked to: 410
finish                                  # the spats held: addItem fails; ITEM_OBTAINED; completed; vars 0; needToZone
