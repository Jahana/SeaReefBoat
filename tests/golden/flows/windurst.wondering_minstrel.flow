# Wondering Minstrel (windurst 6): Jatan-Paratan, Yuli Yaam, Yung Yaam, Aramu-Paramu (Windurst Waters), Ruslan (Lower
# Jeuno). A level-10 WAR at Windurst fame 325 (level 5). Jatan-Paratan's script always answers (611 by night, else a
# random 610 / 615) and Yuli Yaam's (a random 612 / 613): the quest's Events take turns with them (talked to twice);
# Yung Yaam's script has no onTrigger (his default 609), Aramu-Paramu and Ruslan have none (607, 10008).
# Available: Jatan-Paratan 633 option 1 (nothing), option 3 (Prog 1); 634 option 1 (nothing), option 0 (begun); Yuli Yaam
# 637, Yung Yaam 636. Accepted: Jatan-Paratan 635; the lumber at Prog 1: nil; Aramu-Paramu 683; Ruslan 10009 (0,
# lumber) option 1 (nothing), option 0 (Prog 2); 10010 at Prog 2; Jatan-Paratan's trade at Prog 2 (tradeMatches: one
# lumber and nothing else): two lumber nil, the lumber and a chip nil, one lumber 638 with a full bag (complete fails:
# nothing), 638 (completed: fame 50, the Faerie Piccolo, Down Piper Pipe-upperer; the lumber taken; needToZone).
# Completed while needToZone holds: Aramu-Paramu 684, Jatan-Paratan 639, Yuli Yaam 641, Yung Yaam 643; after a zone
# change: all nil (their scripts / defaults). Ruslan: math.randomInt(1, 3) == 1: 10011, else nil (10008): three talks,
# check the draws with show. #guard takes the offer's fame operand and Prog's other values; #gm the accepted Prog's.
lists WindurstWaters/Jatan-Paratan/onTrigger WindurstWaters/Jatan-Paratan/onTrade WindurstWaters/Yuli_Yaam/onTrigger WindurstWaters/Yung_Yaam/onTrigger WindurstWaters/Aramu-Paramu/onTrigger WindurstWaters/onEventFinish/633 WindurstWaters/onEventFinish/634 WindurstWaters/onEventFinish/638 LowerJeuno/Ruslan/onTrigger LowerJeuno/onEventFinish/10009
char zone=WindurstWaters pos=-61,-4,21.5 job=WAR lvl=10
fame Windurst 325
item PieceOfRosewoodLumber x2
item BoneChip
login
trade Jatan-Paratan PieceOfRosewoodLumber x1  # available: no trade handler either way (his script has no onTrade): nothing
trigger Jatan-Paratan                         # fame level 5, Prog 0: 633
finish option=1                               # not 3: nothing
trigger Jatan-Paratan                         # 633
finish option=3                               # Prog 1
trigger Jatan-Paratan                         # Prog 1: 634
finish option=1                               # not 0: nothing
trigger Yuli_Yaam                             # 637 / his script's turn
finish
trigger Yuli_Yaam                             # the other turn
finish
trigger Yung_Yaam                             # 636
finish
trigger Jatan-Paratan                         # 634
finish option=0                               # begun
trigger Jatan-Paratan                         # accepted: 635 / his script's turn
finish
trigger Jatan-Paratan                         # the other turn
finish
trade Jatan-Paratan PieceOfRosewoodLumber x1  # Prog 1: nil
trigger Aramu-Paramu                          # 683
finish
trigger Yuli_Yaam                             # 637 / his script's turn
finish
trigger Yuli_Yaam                             # the other turn
finish
trigger Yung_Yaam                             # 636
finish
warp -19.3,0,-54.6 LowerJeuno
trigger Ruslan                                # Prog 1: 10009 (0, Piece of Rosewood Lumber)
finish option=1                               # not 0: nothing
trigger Ruslan                                # 10009
finish option=0                               # Prog 2
trigger Ruslan                                # Prog 2: 10010 (0, Piece of Rosewood Lumber)
finish
warp -61,-4,21.5 WindurstWaters
trade Jatan-Paratan PieceOfRosewoodLumber x2  # two: tradeMatches false: nil
trade Jatan-Paratan PieceOfRosewoodLumber x1 BoneChip x1  # the lumber and a chip: nil
trade Jatan-Paratan PieceOfRosewoodLumber x1  # Prog 2, one lumber: 638
fill-inventory
finish                                        # the piccolo does not fit: complete fails: nothing; the lumber kept
free-inventory
trade Jatan-Paratan PieceOfRosewoodLumber x1  # 638
finish                                        # completed: fame 50, the Faerie Piccolo, Down Piper Pipe-upperer; the lumber taken; needToZone
trigger Aramu-Paramu                          # needToZone: 684
finish
trigger Jatan-Paratan                         # 639 / his script's turn
finish
trigger Jatan-Paratan                         # the other turn
finish
trigger Yuli_Yaam                             # 641 / his script's turn
finish
trigger Yuli_Yaam                             # the other turn
finish
trigger Yung_Yaam                             # 643
finish
warp -19.3,0,-54.6 LowerJeuno                 # needToZone cleared by the zone change
trigger Ruslan                                # completed: RandomInt(1, 3) == 1: 10011, else nil (10008)
finish
trigger Ruslan                                # again
finish
trigger Ruslan                                # again
finish
warp -61,-4,21.5 WindurstWaters
trigger Aramu-Paramu                          # no needToZone: nil; 607
finish
trigger Jatan-Paratan                         # nil; his script's line
finish
trigger Yuli_Yaam                             # nil; his script's line
finish
trigger Yung_Yaam                             # nil; 609
finish
