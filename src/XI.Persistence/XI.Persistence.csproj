<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Mirrors the C++ engine's DB contract (db::preparedStmt / ResultSet). Product build
         targets net8.0; spike/verify targets net10.0 so it compiles against the SDK on this box. -->
    <AssemblyName>XI.Persistence</AssemblyName>
    <RootNamespace>XI.Persistence</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- MariaDB-compatible driver, present in the local NuGet cache so this restores offline. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

</Project>
