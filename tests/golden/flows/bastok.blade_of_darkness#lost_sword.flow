# Blade of Darkness at Prog 1 without the Chaosbringer (a GM Prog): the Zeruhn zone-in from Palborough plays 131, whose
# finish gives it again (an unchecked give).
lists ZeruhnMines/onZoneIn/1 ZeruhnMines/onEventFinish/131
char zone=PalboroughMines pos=250.037,-32.069,174.156 lvl=30
quest Bastok.BladeOfDarkness accepted
charvar Quest[1][28]Prog 1
login
warp 1,0,3 ZeruhnMines               # Prog 1, no sword: 131, option 0: Chaosbringer
