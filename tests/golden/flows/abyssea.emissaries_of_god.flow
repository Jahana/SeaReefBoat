wait vana=1                             # 05:00
warp -0.011,-1.848,-176.133 HallOfTheGods # Prog 1 at 05:00: nothing (not < 5, not >= 18)
warp -51.344,0,-9.978 PortJeuno
quest Abyssea.EmissariesOfGod completed # a GM
