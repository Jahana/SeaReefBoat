# The Eleventh's Hour at Prog 1 with the toolbox: Babenn's 45 with a full inventory (the Small Sword does not fit: not
# completed, the toolbox kept), then with room (completed).
lists BastokMines/Babenn/onTrigger BastokMines/onEventFinish/45
char zone=BastokMines pos=73.4,0,36.2
quest Bastok.TheEleventhsHour accepted
charvar Quest[1][7]Prog 1
keyitem OldToolbox
login
fill-inventory
trigger Babenn                       # Prog 1: 45
finish                               # the inventory full: not completed, the toolbox kept
free-inventory
trigger Babenn                       # 45 again
finish                               # completed
