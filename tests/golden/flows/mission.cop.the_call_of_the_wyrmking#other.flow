# The Call of the Wyrmking, another mission current (mission.cop.the_call_of_the_wyrmking#other). Ancient Vows (2-5)
# current with 3-1's Status at 1 (a GM): South Gustaberg's zone-in, Port Bastok's area 1 and Metalworks Cid answer
# nothing for this mission.
lists SouthGustaberg/onZoneIn/1 PortBastok/onTriggerAreaEnter/1 Metalworks/Cid/onTrigger
char zone=SouthGustaberg pos=100,-20,100 job=WAR lvl=75 nation=0
mission Cop AncientVows current
charvar Mission[6][258]Status 1         # a GM
login                                   # nothing
warp -90,0,-10 PortBastok
tick 1000
tick 1000
tick 1000
walk -104,0,-10                         # nothing
warp 0,0,0 Metalworks
trigger Cid                             # nothing
finish-if-event
