# The Kuftal Tour (outlands 195) with its module (as #era): a party of 6 by the qm, fay at level 41: the module's level
# test: nil: the default.
module modules/era/lua/quests/outlands/the_kuftal_tour.lua
lists KuftalTunnel/qm5/onTrigger
char zone=KuftalTunnel pos=-27.695,-22.159,-183.716 job=WAR lvl=30
char bob zone=KuftalTunnel pos=-27.695,-22.159,-182.716 job=WAR lvl=30
char cid zone=KuftalTunnel pos=-27.695,-22.159,-184.716 job=WAR lvl=30
char dan zone=KuftalTunnel pos=-26.695,-22.159,-183.716 job=WAR lvl=30
char eve zone=KuftalTunnel pos=-28.695,-22.159,-183.716 job=WAR lvl=30
char fay zone=KuftalTunnel pos=-26.695,-22.159,-182.716 job=WAR lvl=41
setting RESTRICT_CONTENT 1
setting ENABLE_ROV 0
quest Outlands.TheKuftalTour accepted
login
bob: login
invite bob
bob: accept
cid: login
invite cid
cid: accept
dan: login
invite dan
dan: accept
eve: login
invite eve
eve: accept
fay: login
invite fay
fay: accept
trigger qm5                             # 6, fay at 41: nil: the default
