trigger blank_divine_might              # Prog 0, no ore: 58
finish
warp 1.748,-27.402,67.751 Romaeve
trade QuHau_Spring ChunkOfLightOre x1   # day 8000, 12:00: not the full moon: nothing
wait vana=516                           # day 8022, 00:00 (FULL_MOON), hour 0
trade QuHau_Spring ChunkOfLightOre x1   # no ore: 8
finish                                  # the Moonlight Ore; the light ore taken
trade QuHau_Spring ChunkOfLightOre x1   # the ore held: nothing
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # 7 (917, 1408)
finish                                  # the Ark Pentasphere; the pair taken
trade QuHau_Spring SheetOfParchment x1 BottleOfIlluminink x1   # 7
finish                                  # the pentasphere held (rare): giveItem false: nothing taken
warp -38.533,-1.648,-148.199 TheShrineOfRuavitau
trigger blank_divine_might              # Prog 0, the ore: 56
finish
warp -603.563,-22.681,483.937 LaloffAmphitheater
effect 50                               # a GM: Invincible
trade qm1_1 ArkPentasphere x1           # 32000 (the repeat accepted: the entry requirement)
update 32000 option=81                  # index 5, arena 1: entered, the pentasphere worn
finish
kill ARK_ANGEL_HM+24
kill ARK_ANGEL_MR+22
kill ARK_ANGEL_EV+16
kill ARK_ANGEL_TT+14
kill ARK_ANGEL_GK+12                    # won: 32001
finish                                  # battlefieldWin 293, the ore: Prog 1
warp -38.533,-1.648,-148.199 TheShrineOfRuavitau
trigger blank_divine_might              # Prog 1, the ore: 59
update 59 option=2                      # the earrings (updateEvent)
finish option=0                         # nil: nothing
trigger blank_divine_might              # 59
update 59 option=1                      # not 2: nothing
fill-inventory
finish option=2                         # giveItem false: nothing
free-inventory
trigger blank_divine_might              # 59
finish option=2                         # the Knight's Earring: completed; DM_Earring 14740
trigger blank_divine_might              # completed, one earring held: nil: the default
