# Storm's Crescendo (WotG 32) at Status 1 with the Alchemical Signal Flare and Timer 1000000000 (GMs): Rally Point: Blue
# shows HELP_REPUBLIC_PREPARE (8275), whatever the Timer.
lists XarcabardS/Rally_Point_Green/onTrigger XarcabardS/Rally_Point_Blue/onTrigger XarcabardS/Rally_Point_Red/onTrigger XarcabardS/onZoneIn/1 XarcabardS/onEventFinish/19 XarcabardS/onEventFinish/20 XarcabardS/onEventFinish/23 XarcabardS/onEventFinish/26 XarcabardS/onEventFinish/39
char zone=XarcabardS pos=-106.071,-25.5,-50 job=WAR lvl=99
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Wotg StormsCrescendo current
charvar Mission[5][31]Status 1
charvar Mission[5][31]Timer 1000000000
keyitem AlchemicalSignalFlare
login
trigger Rally_Point_Blue                   # the flare held, Timer ahead: HELP_REPUBLIC_PREPARE
