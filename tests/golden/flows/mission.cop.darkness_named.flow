# Darkness Named (CoP 3-5, mission.cop.darkness_named). A level 75 Warrior of San d'Oria with 3-5 current (a GM; Status
# 0). Lower Jeuno: Aldo: 7; Harnek: 13; Sattal-Mansal: 11; Ghebi Damomohe: nothing; the Carmine Chip traded: nothing.
# Upper Jeuno, Monberaux (Status 0, the Mysterious Amulet held, a GM): 82; finished: the amulet taken,
# LEND_PRISHE_AMULET, Status 1; again (1): 3, once. Lower Jeuno, Ghebi Damomohe (1): 54; finished: 2; again (2): 53;
# the Carmine Chip traded: 52; finished: the gil, the Psoxja Pass, Status 3. The Shrouded Maw: the zone-in (3): 2;
# finished: Status 4. Upper Jeuno, Monberaux (4): nothing; Status 5 (a GM): 75; finished: the mission completes (3-5's
# section 2 holds). A Crystalline Prophecy is not current (the default char has its own Lower Jeuno zone-in).
lists LowerJeuno/Aldo/onTrigger LowerJeuno/Ghebi_Damomohe/onTrade LowerJeuno/Ghebi_Damomohe/onTrigger LowerJeuno/Harnek/onTrigger LowerJeuno/Sattal-Mansal/onTrigger LowerJeuno/onEventFinish/52 LowerJeuno/onEventFinish/54 UpperJeuno/Monberaux/onTrigger UpperJeuno/onEventFinish/75 UpperJeuno/onEventFinish/82 TheShroudedMaw/onZoneIn/1 TheShroudedMaw/onEventFinish/2
char zone=LowerJeuno pos=15.5,-0.1,-6.1 job=WAR lvl=75 nation=0
mission Acp TheEchoAwakens current       # A Crystalline Prophecy's own Lower Jeuno zone-in is off
mission Cop DarknessNamed current
item CarmineChip x2
login
trigger Aldo                            # Status 0: 7
finish-if-event
trigger Harnek                          # Status 0: 13
finish-if-event
trigger Sattal-Mansal                   # Status 0: 11
finish-if-event
trigger Ghebi_Damomohe                  # Status 0: nothing
finish-if-event
trade Ghebi_Damomohe CarmineChip x1     # Status 0: nothing
finish-if-event
warp -40.881,-0.499,-1.913 UpperJeuno
keyitem MysteriousAmulet                # a GM
trigger Monberaux                       # Status 0: 82
finish                                  # Status 1
trigger Monberaux                       # Status 1: 3
finish-if-event
trigger Monberaux                       # Status 1, again: once only
finish-if-event
warp 15.5,-0.1,-6.1 LowerJeuno
trigger Ghebi_Damomohe                  # Status 1: 54
finish                                  # Status 2
trigger Ghebi_Damomohe                  # Status 2: 53
finish-if-event
delkeyitem PsoxjaPass                   # a GM
trade Ghebi_Damomohe CarmineChip x1     # 52
finish                                  # the gil, the Psoxja Pass, Status 3
warp 0,0,0 TheShroudedMaw               # Status 3: 2; Status 4
warp -40.881,-0.499,-1.913 UpperJeuno
trigger Monberaux                       # Status 4: nothing
finish-if-event
charvar Mission[6][358]Status 5         # a GM
trigger Monberaux                       # Status 5: 75
finish                                  # the mission completes
