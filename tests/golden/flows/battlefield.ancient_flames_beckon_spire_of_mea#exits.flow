# Ancient Flames Beckon, Mea's exits (battlefield.ancient_flames_beckon_spire_of_mea#exits): the leave NPCs _0l1 to _0l3, one
# per arena. A level 75 Warrior of San d'Oria with Below the Arks current (a GM) enters arena 1, 2 and 3 in turn (option
# 1, 2, 3 of the menu 32000) and leaves each by its exit NPC: 32003, finished with 4: leaveBattlefield(1).
lists SpireOfMea/_0l0/onTrigger SpireOfMea/onEventUpdate/32000 SpireOfMea/_0l1/onTrigger SpireOfMea/_0l2/onTrigger SpireOfMea/_0l3/onTrigger SpireOfMea/onEventFinish/32000 SpireOfMea/onEventFinish/32003
char zone=SpireOfMea pos=0,-3.8,240 job=WAR lvl=75 nation=0
mission Cop BelowTheArks current        # a GM
login
trigger _0l0                            # the menu 32000
update 32000 option=1                   # arena 1: entered
finish                                  # in the arena
trigger _0l1                            # arena 1's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 179,35,255 TahrongiCanyon
warp 0,-3.8,240 SpireOfMea
trigger _0l0                            # the menu 32000
update 32000 option=2                   # arena 2: entered
finish                                  # in the arena
trigger _0l2                            # arena 2's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 179,35,255 TahrongiCanyon
warp 0,-3.8,240 SpireOfMea
trigger _0l0                            # the menu 32000
update 32000 option=3                   # arena 3: entered
finish                                  # in the arena
trigger _0l3                            # arena 3's exit: 32003
finish option=4                         # leaveBattlefield(1)
tick 10000                              # out of the battlefield
warp 179,35,255 TahrongiCanyon
warp 0,-3.8,240 SpireOfMea
