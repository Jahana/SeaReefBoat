lists AlZahbi/Talhaal/onTrigger AhtUrhganWhitegate/Fari-Wari/onTrigger WajaomWoodlands/Leypoint/onTrade WajaomWoodlands/onEventFinish/511
char zone=AlZahbi pos=-34.4,-6,107.16 job=WAR lvl=75
quest AhtUrhgan.SagaOfTheSkyserpent completed
item RustyMedal
item FrayedArrow
login
trigger Talhaal                         # Fist not available (Ode not accepted): 256
finish
quest AhtUrhgan.OdeToTheSerpents completed  # a GM
