# Darkness Named, another mission current (mission.cop.darkness_named#other). Ancient Vows (2-5) current with 3-5's
# Status at 0, 1, 2 and 3 (GMs): Lower Jeuno, Aldo, Harnek, Sattal-Mansal and Ghebi Damomohe, the chip traded, Upper
# Jeuno Monberaux and the Shrouded Maw's zone-in answer nothing for this mission. A Crystalline Prophecy is not current
# (the default char has its own Lower Jeuno zone-in).
lists LowerJeuno/Aldo/onTrigger LowerJeuno/Ghebi_Damomohe/onTrade LowerJeuno/Ghebi_Damomohe/onTrigger LowerJeuno/Harnek/onTrigger LowerJeuno/Sattal-Mansal/onTrigger UpperJeuno/Monberaux/onTrigger TheShroudedMaw/onZoneIn/1
char zone=LowerJeuno pos=15.5,-0.1,-6.1 job=WAR lvl=75 nation=0
mission Acp TheEchoAwakens current       # A Crystalline Prophecy's own Lower Jeuno zone-in is off
mission Cop AncientVows current
charvar Mission[6][358]Status 0         # a GM
item CarmineChip
login
trigger Aldo                            # nothing
finish-if-event
trigger Harnek                          # nothing
finish-if-event
trigger Sattal-Mansal                   # nothing
finish-if-event
charvar Mission[6][358]Status 1         # a GM
trigger Ghebi_Damomohe                  # nothing
finish-if-event
charvar Mission[6][358]Status 2         # a GM
trigger Ghebi_Damomohe                  # nothing
finish-if-event
trade Ghebi_Damomohe CarmineChip x1     # nothing
finish-if-event
warp -40.881,-0.499,-1.913 UpperJeuno
finish-if-event
charvar Mission[6][358]Status 0         # a GM
finish-if-event
trigger Monberaux                       # nothing
finish-if-event
charvar Mission[6][358]Status 1         # a GM
finish-if-event
trigger Monberaux                       # nothing
finish-if-event
charvar Mission[6][358]Status 5         # a GM
finish-if-event
trigger Monberaux                       # nothing
finish-if-event
charvar Mission[6][358]Status 3         # a GM
finish-if-event
warp 0,0,0 TheShroudedMaw               # nothing
