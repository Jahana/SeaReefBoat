finish-if-event
charvar Quest[7][51]Timer 8000          # a GM: today (the harness's day)
charvar Quest[7][51]mustZone 80         # a GM: the mustZone (Bonds' 650 sets it in Southern San d'Oria [S])
trigger Rholont                         # the mustZone set: nil (32)
finish-if-event
warp 62.849,-6.078,137.438 GarlaigeCitadelS # another zone: the mustZone cleared (a rezone keeps it)
warp -167.043,-2,55.484 SouthernSanDoriaS
trigger Rholont                         # Prog 0: 113
finish                                  # Prog 1
trigger Rholont                         # Prog 1, Option 0: 655
finish                                  # Option 1
trigger Rholont                         # Prog 1, Option 1: 49
finish
trigger Daigraffeaux                    # Prog 1: 114
finish                                  # begun
trigger Rholont                         # accepted: 656
finish
warp 82.144,-19.038,139.249 BeaucedineGlacierS open # Prog 1 (any zone): 1, left open
update 1 option=0                       # not 11: no update
update 1 option=11                      # (0, 23, 1756, 0, 0, 5832718, 0, 1)
finish                                  # Prog 2
trigger Colossal_Footprint              # Prog 2, no key items: 2
finish                                  # Prog 3
trigger Colossal_Footprint              # Prog 3, no key items: nil (NOTHING_OUT_OF_ORDINARY)
finish-if-event
trigger Rocky_Perch                     # Prog 3: NONDESCRIPT_MASS, a Goliath Worm, no event
finish-if-event
keyitem LanceFish                       # a GM: fished in the zone
keyitem PaladinLobster                  # a GM
keyitem ScutumCrab                      # a GM
trigger Colossal_Footprint              # the three: 3 (136)
finish                                  # Prog 4
walk 84.796,-58.472,175.2               # beside the Charred Firewood (a trade does not walk)
trade Charred_Firewood FlintStone x1    # Prog 4, the flint alone: 4
finish                                  # Prog 5 (the flint kept)
trigger Compressed_Snow                 # Prog 5: 5
finish                                  # Prog 6
trigger Compressed_Snow                 # Prog 6, the NM not up: 27
finish                                  # the Orcish Bloodletter spawned, claimed
trigger Compressed_Snow                 # the NM up: nil (NOTHING_OUT_OF_ORDINARY)
finish-if-event
kill ORCISH_BLOODLETTER                 # Prog 6: Prog 7
trigger Compressed_Snow                 # Prog 7: 6
finish                                  # completed (an Icarus Wing)
warp -167.043,-2,55.484 SouthernSanDoriaS
trigger Rholont                         # Blood of Heroes' available: 656
