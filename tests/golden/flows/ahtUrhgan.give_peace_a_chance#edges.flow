# finished: completed (the Silver Piece), the zoning flag, Quest[6][30]Stage.
lists AhtUrhganWhitegate/Mishhar/onTrigger WajaomWoodlands/qm8/onTrigger Mamook/qm4/onTrigger AhtUrhganWhitegate/onEventFinish/576 AhtUrhganWhitegate/onEventFinish/589
char zone=Mamook pos=348.6,-12.1,-256.4 job=WAR lvl=75
quest AhtUrhgan.GivePeaceAChance accepted
login
trigger qm4                             # Prog 0: nil: nothing
finish-if-event
charvar Quest[6][9]Prog 2               # a GM
warp 418.2,-24,220.8 WajaomWoodlands
