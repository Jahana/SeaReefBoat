walk 80,0,60
walk 80,0,40                            # status 4: nothing
walk 80,-6,-117
walk 80,-6,-130                         # area 5, status 4: 3026
update 3026 option=10                   # topic bit 3
update 3026 option=1                    # bit 0
update 3026 option=2                    # bit 1
update 3026 option=3                    # bit 2
update 3026 option=0                    # clamped: bit 0
update 3026 option=5                    # clamped: bit 3
