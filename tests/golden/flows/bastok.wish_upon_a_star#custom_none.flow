# Wish Upon a Star with the custom module (see #custom): 12:00 (DAY) with NONE (`weather 0`): 334 whatever the time (the
# quest's own plays 337 by day), completed.
module modules/custom/lua/quest_workarounds.lua
lists BastokMarkets/Enu/onTrade BastokMarkets/onEventFinish/334
char zone=BastokMarkets pos=-253.7,-13,-92.3 lvl=30
quest Bastok.WishUponAStar accepted
item FallenStar
item BoneChip
login
weather 0                      # GM: NONE
trade Enu FallenStar x1        # DAY, NONE: 334
finish                         # completed: four Bags of Cactus Stems, fame +50, the star taken
