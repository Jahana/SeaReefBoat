# The Gobbiebag Part VIII (jeuno 94): Lower Jeuno's Bluffnix (no script; default 43 with 81), the template
# GobbiebagQuest. A level 75 Warrior at Jeuno fame level 4 ((450 + 0 + 0) / 2 = 225), the inventory at 65 (storage; a
# fresh char has 30), Parts I-VII completed (the chain's earlier parts, by a GM), the four items, a Bowl of Goblin Stew
# (880) and a Chocobo Feather. Available: a trade: no trade handler; 43 (66, 0, 1), option 1: nothing; option 0: begun.
# Accepted: 43 (66, 1, 1), its finish: no handler; three items, the four and the feather, the stew and an item: 43 (66,
# 1, 1); the stew alone: 73 (71), the quest completed by a GM while it is open: no 73 finish (the stew kept); accepted
# again (a GM): the four items: 73 (71), finished: completed, the inventory 70, INVENTORY_INCREASED, the items taken (no
# satchel: unchanged). Completed: no section; Bluffnix's default 43 (81) (Part IX wants fame level 5). Set accepted by a
# GM at 70: the accepted check fails: no section (43 (81)), a trade: nothing; set available by a GM at 70: no section. A
# GM sets a part available before accepted (accepted over completed keeps it completed).
lists LowerJeuno/Bluffnix/onTrigger LowerJeuno/Bluffnix/onTrade LowerJeuno/onEventFinish/43 LowerJeuno/onEventFinish/73
char zone=LowerJeuno pos=-41.7,5.9,-113 job=WAR lvl=75
storage inventory 65                    # the part's start size (char_storage.inventory; a fresh char has 30)
fame Sandoria 450
quest Jeuno.TheGobbiebagPartI completed
quest Jeuno.TheGobbiebagPartIi completed
quest Jeuno.TheGobbiebagPartIii completed
quest Jeuno.TheGobbiebagPartIv completed
quest Jeuno.TheGobbiebagPartV completed
quest Jeuno.TheGobbiebagPartVi completed
quest Jeuno.TheGobbiebagPartVii completed
item SquareOfSmilodonLeather
item ElectrumIngot
item SquareOfCilice
item Angelstone
item BowlOfGoblinStew880
item ChocoboFeather
login
trade Bluffnix ChocoboFeather x1        # available: no trade handler; nothing
trigger Bluffnix                        # reqsMet: 43 (66, 0, 1)
finish option=1                         # not 0: nothing
trigger Bluffnix                        # 43 (66, 0, 1)
finish option=0                         # begun
trigger Bluffnix                        # accepted: 43 (66, 1, 1)
finish option=0                         # no 43 finish while accepted: nothing
trade Bluffnix SquareOfSmilodonLeather x1 ElectrumIngot x1 SquareOfCilice x1 # three of the four: 43 (66, 1, 1)
finish
trade Bluffnix SquareOfSmilodonLeather x1 ElectrumIngot x1 SquareOfCilice x1 Angelstone x1 ChocoboFeather x1 # an extra item: 43 (66, 1, 1)
finish
trade Bluffnix BowlOfGoblinStew880 x1 SquareOfSmilodonLeather x1 # the stew and an item: 43 (66, 1, 1)
finish
trade Bluffnix BowlOfGoblinStew880 x1   # the stew alone: 73 (71)
quest Jeuno.TheGobbiebagPartViii completed # a GM, while 73 is open
finish                                  # no 73 finish while completed: nothing (the stew kept)
quest Jeuno.TheGobbiebagPartViii available # a GM: accepted over completed keeps it completed
quest Jeuno.TheGobbiebagPartViii accepted # a GM
trade Bluffnix SquareOfSmilodonLeather x1 ElectrumIngot x1 SquareOfCilice x1 Angelstone x1 # the four items: 73 (71)
finish                                  # completed; inventory 70; INVENTORY_INCREASED; the items taken
trigger Bluffnix                        # completed: no section; 43 (81)
finish option=1                         # declined: nothing
quest Jeuno.TheGobbiebagPartViii available # a GM: accepted over completed keeps it completed
quest Jeuno.TheGobbiebagPartViii accepted # a GM, at 70
trigger Bluffnix                        # accepted, the inventory 70: no section; 43 (81)
finish
trade Bluffnix BowlOfGoblinStew880 x1   # no section: nothing
quest Jeuno.TheGobbiebagPartViii available # a GM, at 70
trigger Bluffnix                        # available, the inventory 70: no section; 43 (81)
finish option=0                         # no section: not begun
