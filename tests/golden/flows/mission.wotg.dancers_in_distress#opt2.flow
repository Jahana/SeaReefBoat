# Dancers in Distress (WotG 9) at status 2 with the quiz choice 2 (a GM's Option var), mustZone clear: the trigger plays
# LILISETTE_IS_PREPARING with the choice's item; the trade of the choice's item plays 3; finished: the mission
# completes.
lists SouthernSanDoriaS/Lion_Springs/onTrigger SouthernSanDoriaS/Raustigne/onTrigger SouthernSanDoriaS/onEventFinish/86 JugnerForestS/Elegant_Footprints/onTrigger JugnerForestS/Elegant_Footprints/onTrade JugnerForestS/onEventUpdate/2 JugnerForestS/onEventFinish/2 JugnerForestS/onEventFinish/3
char zone=SouthernSanDoriaS pos=96,0,106 job=WAR lvl=99
item LynxMeat
item GoldBeastcoin
item NyumomoDoll
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Wotg DancersInDistress current
login
missionstatus Wotg 2
charvar Mission[5][8]Option 2          # a GM
warp 46.387,0.117,318.21 JugnerForestS
trigger Elegant_Footprints              # LILISETTE_IS_PREPARING
trade Elegant_Footprints GoldBeastcoin x1     # the choice's item: 3
finish                                  # completed
