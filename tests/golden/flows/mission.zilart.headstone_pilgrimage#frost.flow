# Headstone Pilgrimage: the Cloister of Frost's headstone (Ice Fragment), five of the others held. Without
# its fragment the headstone plays 200 (Ice); option 0 does nothing; 3 yalms off option 1 says
# MUST_MOVE_CLOSER (7706: 0, the fragment); close by, option 1 gives the fragment (KEYITEM_OBTAINED 6398).
# Held, the headstone says ALREADY_OBTAINED_FRAG (7689); with all seven (a GM adds the Wind Fragment)
# ALREADY_HAVE_ALL_FRAGS (7690). Its fragment taken by a GM, 200 again: the last fragment says
# FOUND_ALL_FRAGS (7691) and completes the mission (the Bearer of the Eight Prayers title, Through the
# Quicksand Caves current). Completed, it says ALREADY_HAVE_ALL_FRAGS (section 2).
lists CloisterOfFrost/Cermet_Headstone/onTrigger CloisterOfFrost/onEventFinish/200 CloisterOfFrost/onEventFinish/201
char zone=CloisterOfFrost pos=566,0,606 job=WAR lvl=75 nation=0
mission Asa BurgeoningDread current
mission Acp ACrystallineProphecyFin current
mission Rov ARhapsodyForTheAges current
mission Soa Abomination current
mission Zilart HeadstonePilgrimage current
keyitem FireFragment
keyitem EarthFragment
keyitem LightningFragment
keyitem WaterFragment
keyitem LightFragment
login
trigger Cermet_Headstone                # no fragment: 200
finish option=0                         # not 1: nothing
trigger Cermet_Headstone at=3           # 200
finish option=1                         # 3 yalms off: MUST_MOVE_CLOSER
trigger Cermet_Headstone                # 200
finish option=1                         # the fragment: KEYITEM_OBTAINED (one still missing)
trigger Cermet_Headstone                # the fragment held, not all: ALREADY_OBTAINED_FRAG
keyitem WindFragment                    # a GM: all seven held
trigger Cermet_Headstone                # all held: ALREADY_HAVE_ALL_FRAGS
delkeyitem IceFragment                  # a GM
trigger Cermet_Headstone                # 200
finish option=1                         # the last fragment: FOUND_ALL_FRAGS, completed
trigger Cermet_Headstone                # completed: ALREADY_HAVE_ALL_FRAGS (section 2)
finish-if-event
