finish option=1                           # Prog 1, option 1: nothing
charvar Quest[0][2]Stage 0              # a GM
trigger Rosel                             # draw 5: 2, Stage 2; 524 (0, 0, 0, 0, 1)
finish option=1                           # Prog 1, option 1: nothing
charvar Quest[0][2]Stage 0              # a GM
