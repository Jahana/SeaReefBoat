# Beyond Infinity, Horlais Peak (battlefield.beyond_infinity_horlais_peak): enter area 1 (321), trigger
# Burning_Circle: event 32003, its update, finish option 4 leaves. Back at the entrance the trigger shows the menu
# again.
lists HorlaisPeak/BC_Entrance/onTrigger HorlaisPeak/Burning_Circle/onTrigger HorlaisPeak/onEventUpdate/32000 HorlaisPeak/onEventFinish/32000 HorlaisPeak/onEventUpdate/32003 HorlaisPeak/onEventFinish/32003
char zone=HorlaisPeak pos=-501.5,158.3,-212.6 job=WAR lvl=75
quest Jeuno.BeyondInfinity accepted
keyitem SoulGemClasp
login
trigger BC_Entrance
update 32000 option=321
finish
trigger Burning_Circle
update 32003 option=1
finish option=4
warp -501.5,158.3,-212.6 HorlaisPeak
trigger BC_Entrance
