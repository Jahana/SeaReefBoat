ed: login
ed: trigger Waoud                       # Omens' mustZone: nil: 78
ed: finish option=0
ed: warp -64,-7,38 AlZahbi              # the mustZone cleared
ed: charvar Quest[6][22]Timer 1800000001   # a GM: now + 1
ed: warp 67.116,-6,-78.222 AhtUrhganWhitegate
ed: trigger Waoud                       # now < Timer: nil: 78
ed: finish option=0
ed: charvar Quest[6][22]Timer 1800000000   # a GM: now
ed: trigger Waoud                       # 710
ed: finish                              # begun
ed: logout
trigger Waoud                           # Prog 0: 711 (500)
finish option=1                         # under 1000 gil: nothing
charvar Quest[6][22]Prog 1              # a GM
trigger Lathuya                         # Prog 1: nil: 770
finish
charvar Quest[6][22]Prog 2              # a GM
trigger Waoud                           # Prog 2: 713 (500)
finish option=1                         # under 1000 gil: nothing
warp 343.629,36.509,-24.856 AydeewaSubterrane
trigger blank_omens                     # Prog 2: nil: NOTHING_OUT_OF_ORDINARY
finish-if-event
warp 67.116,-6,-78.222 AhtUrhganWhitegate
