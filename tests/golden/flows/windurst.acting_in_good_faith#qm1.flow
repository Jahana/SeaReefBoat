# Acting in Good Faith (windurst 64): the qm1's move on 50's finish, npc:setPos(QM1_POS[math.randomInt(1, 4)]) (the
# script RNG, pinned by the seed), drawn twelve times: the incense given again by GM before each talk, and each trigger
# walks to wherever the qm1 went. Check the draws and the places with show.
lists TheEldiemeNecropolis/qm1/onTrigger TheEldiemeNecropolis/onEventFinish/50
char zone=TheEldiemeNecropolis pos=-19.6,-1.63,58.4 job=WAR lvl=10
quest Windurst.ActingInGoodFaith accepted
keyitem SpiritIncense
login
trigger qm1                                   # the incense: 50
finish                                        # the incense taken; the qm1 moved (draw 1)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 2)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 3)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 4)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 5)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 6)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 7)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 8)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 9)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 10)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 11)
keyitem SpiritIncense
trigger qm1                                   # 50
finish                                        # moved (draw 12)
trigger qm1                                   # no incense: nil; NOTHING_OUT_OF_ORDINARY
finish-if-event
