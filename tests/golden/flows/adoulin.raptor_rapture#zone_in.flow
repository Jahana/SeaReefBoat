# Raptor Rapture (adoulin, call-only), begun at the zone-in: a level 99 Warrior logging into Western Adoulin at
# Raptor_Rapture_Status 2 (a GM). The login's zone-in: 5056, left open (login open), finished on 1: status 3, then added
# and status 4. Pagnelle: 5033.
lists WesternAdoulin/onZoneIn/1 WesternAdoulin/onEventFinish/5056 WesternAdoulin/Pagnelle/onTrigger
char zone=WesternAdoulin pos=-6.5,0,-100 job=WAR lvl=99
charvar Raptor_Rapture_Status 2
login open                              # the zone-in at status 2: 5056, left open
finish option=1                         # status 3, then added and status 4
trigger Pagnelle                        # accepted, status 4: 5033
finish
