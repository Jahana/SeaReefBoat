# Qu'Bia Arena's Rank 5 Mission (battlefield 512) with helpers: the leader on Darkness Rising at 11; eve with it
# completed (entryRequirement: the nation's mission 14 completed) enters; fay on it at status 12 without the seal:
# refused. The kill: 32001 to both; the leader's finish: the title and the mission's (the Burnt Seal, status 12, the
# New Fei'Yin Seal taken); eve's (canSkipCS 1): the title only.
lists QubiaArena/BC_Entrance/onTrigger QubiaArena/Burning_Circle/onTrigger QubiaArena/onEventUpdate/32000 QubiaArena/onEventFinish/32000 QubiaArena/onEventFinish/32003 QubiaArena/onEventFinish/32001 QubiaArena/onEventFinish/32002
char zone=QubiaArena pos=-212.2,-24.6,20.1 job=WAR lvl=75 nation=1
char eve zone=QubiaArena pos=-212.2,-24.6,20.1 job=WAR lvl=75 nation=1
char fay zone=QubiaArena pos=-212.2,-24.6,20.1 job=WAR lvl=75 nation=1
mission Rov ARhapsodyForTheAges current
mission Acp ACrystallineProphecyFin current
mission Bastok TheZeruhnReport completed
mission Bastok GeologicalSurvey completed
mission Bastok Fetichism completed
mission Bastok TheCrystalLine completed
mission Bastok WadingBeasts completed
mission Bastok TheEmissary completed
mission Bastok TheFourMusketeers completed
mission Bastok ToTheForsakenMines completed
mission Bastok Jeuno completed
mission Bastok Magicite completed
mission Bastok DarknessRising current
keyitem NewFeiyinSeal
eve: mission Bastok DarknessRising completed
fay: mission Bastok DarknessRising current
login
missionstatus Bastok 11
eve: login
fay: login
fay: missionstatus Bastok 12
invite eve
eve: accept
invite fay
fay: accept
trigger BC_Entrance                     # the leader: the 32000 menu
update 32000 option=1                   # area 1: registered, entered
finish
eve: trigger BC_Entrance                # eve (completed, no seal): the menu
eve: update 32000 option=1              # entered
eve: finish
fay: trigger BC_Entrance                # fay (current at status 12, no seal): nothing
fay: finish-if-event
tick 2000                               # the first tick: the groups spawn
kill ARCHLICH_TABERQUOAN                # allDeath, WON
tick 2000
tick 2000
tick 2000
tick 2000
tick 2000
tick 2000
finish                                  # 32001: the leader: the title, the Burnt Seal, status 12
eve: finish                             # 32001: eve: the title; the mission does nothing (completed)
tick 11000
tick 10000
