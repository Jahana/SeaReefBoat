lists AhtUrhganWhitegate/Lathuya/onTrigger AhtUrhganWhitegate/Lathuya/onTrade AhtUrhganWhitegate/onEventUpdate/738 AhtUrhganWhitegate/onEventFinish/740 AhtUrhganWhitegate/onEventFinish/742 AhtUrhganWhitegate/onEventFinish/744
char zone=AhtUrhganWhitegate pos=-95.1,-6,33.1 job=WAR lvl=99
quest AhtUrhgan.Transformations accepted
charvar [BLUAF]Remaining 6
item GoldChain
item SquareOfVelvetCloth
item ChunkOfFlanMeat
item SquareOfImperialSilkCloth
item ImperialMythrilPiece x4
login
trigger Lathuya                         # one made, none ordered: 738 (1)
update 738 option=10                    # above 9: nothing
update 738 option=1                     # below 2: nothing
update 738 option=2                     # piece 1, already made: nothing
update 738 option=5                     # piece 2: Current 2, updateEvent(0, the materials)
update 738 option=6                     # the fee: updateEvent(0, coin, 2)
update 738 option=7                     # the fee again
update 738 option=5                     # piece 2 again
update 738 option=10                    # above 9, an order held: nothing
update 738 option=1                     # below 2, an order held: nothing
finish option=5
trigger Lathuya                         # stage 0: 739 (0, coin, 2)
finish
trade Lathuya ImperialMythrilPiece x2   # stage 0, not the materials: nothing
trade Lathuya GoldChain x1 SquareOfVelvetCloth x1 ChunkOfFlanMeat x1 SquareOfImperialSilkCloth x1   # 740
finish                                  # stage 1, taken
trigger Lathuya                         # stage 1: 741
finish
trade Lathuya ImperialMythrilPiece x4   # stage 1, not the two coins: nothing
trade Lathuya ImperialMythrilPiece x2   # 742 (0, coin, 2)
finish                                  # taken, stage 2, PaymentDay today, mustZone, the slip
trigger Lathuya                         # not yet: 743
finish
charvar [BLUAF]PaymentDay 0             # a GM: the day past
trigger Lathuya                         # not zoned: 743
finish
charvar [BLUAF]PaymentDay 8000          # a GM: PaymentDay is today
rezone
trigger Lathuya                         # zoned, PaymentDay is today (not past): 743
finish
charvar [BLUAF]PaymentDay 0             # a GM: the day past
trigger Lathuya                         # 744 (the shalwar)
finish                                  # given; Remaining 4; RestingDay today; mustZone; the slip taken
trigger Lathuya                         # two made, resting: 745
finish
charvar [BLUAF]Current 4                # a GM: no such piece
trade Lathuya ImperialMythrilPiece x2   # nothing
