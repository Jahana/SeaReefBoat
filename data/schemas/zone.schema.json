{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "zone.schema.json",
   "title": "Zone",
   "description": "Zone classification, music, permitted systems, and outbound transitions.",
   "type": "object",
   "properties": {
      "level_restriction": {
         "anyOf": [
            {
               "$ref": "#/$defs/uint8_t"
            },
            {
               "type": "null"
            }
         ],
         "description": "Level cap enforced on entry. Defaults to 0, meaning uncapped.",
         "minimum": 0,
         "maximum": 99
      },
      "misc": {
         "anyOf": [
            {
               "type": "array",
               "items": {
                  "type": "string",
                  "title": "ZoneMisc",
                  "enum": [
                     "none",
                     "escape",
                     "fellow",
                     "mount",
                     "mazurka",
                     "tractor",
                     "mogmenu",
                     "costume",
                     "pet",
                     "treasure",
                     "auction_house",
                     "yell",
                     "trust",
                     "los_player_block",
                     "los_off",
                     "assist"
                  ]
               }
            },
            {
               "type": "null"
            }
         ],
         "description": "Abilities and systems permitted in this zone. Defaults to an empty list.",
         "uniqueItems": true
      },
      "music": {
         "anyOf": [
            {
               "type": "object",
               "properties": {
                  "battle_party": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/uint16_t"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Battle music when fighting in a party. Defaults to 0."
                  },
                  "battle_solo": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/uint16_t"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Battle music when fighting alone. Defaults to 0."
                  },
                  "day": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/uint16_t"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Background music by day. Defaults to 0 (silence)."
                  },
                  "night": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/uint16_t"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Background music by night. Defaults to 0 (silence)."
                  }
               },
               "additionalProperties": false
            },
            {
               "type": "null"
            }
         ],
         "description": "Background and battle music. Omitted slots default to 0."
      },
      "navmesh": {
         "anyOf": [
            {
               "type": "object",
               "properties": {
                  "agent_max_climb": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/float"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Tallest step that still connects two surfaces. Defaults to 1."
                  },
                  "off_mesh_links": {
                     "type": [
                        "boolean",
                        "null"
                     ],
                     "description": "Whether drop links across ledges are generated. Defaults to true."
                  },
                  "off_mesh_max_drop": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/float"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Largest vertical drop a link may bridge. Defaults to 5."
                  },
                  "off_mesh_reach": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/float"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Largest horizontal offset from a ledge to its landing. Defaults to 3."
                  },
                  "skip_planes": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/std::vector<float>"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "World Y of flat planes to drop from the bake. A triangle is dropped when all three vertices lie on one of them."
                  },
                  "skip_spheres": {
                     "anyOf": [
                        {
                           "type": "array",
                           "items": {
                              "type": "object",
                              "properties": {
                                 "center": {
                                    "$ref": "#/$defs/std::array<float,3>"
                                 },
                                 "radius": {
                                    "$ref": "#/$defs/float"
                                 }
                              },
                              "additionalProperties": false,
                              "required": [
                                 "center",
                                 "radius"
                              ]
                           }
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Spheres to drop from the bake, as center x, y, z and radius. A triangle is dropped when all three vertices lie inside one of them."
                  },
                  "walkable_slope_angle": {
                     "anyOf": [
                        {
                           "$ref": "#/$defs/float"
                        },
                        {
                           "type": "null"
                        }
                     ],
                     "description": "Slopes steeper than this, in degrees, are not walkable. Defaults to 46."
                  }
               },
               "additionalProperties": false
            },
            {
               "type": "null"
            }
         ],
         "description": "Per-zone navmesh bake settings: geometry to leave out and the bake knobs this zone overrides."
      },
      "tax": {
         "anyOf": [
            {
               "$ref": "#/$defs/float"
            },
            {
               "type": "null"
            }
         ],
         "description": "Percent added to bazaar purchases in this zone. Defaults to 0, and every zone reads 0 today.",
         "minimum": 0,
         "maximum": 100
      },
      "transport": {
         "anyOf": [
            {
               "type": "object",
               "properties": {
                  "runs": {
                     "type": "object",
                     "additionalProperties": {
                        "type": "object",
                        "properties": {
                           "boundary": {
                              "anyOf": [
                                 {
                                    "$ref": "#/$defs/uint16_t"
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Boarding area passengers stand in. They ride along when the ship departs."
                           },
                           "disembark": {
                              "anyOf": [
                                 {
                                    "$ref": "#/$defs/uint32_t"
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Seconds into the cycle when riders in the voyage zone are put ashore."
                           },
                           "dock": {
                              "anyOf": [
                                 {
                                    "$ref": "#/$defs/std::vector<float>"
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Where the ship sits while docked, as x, y, z and optionally a facing of 0-255. Omitted leaves it wherever the zone put it."
                           },
                           "door": {
                              "type": [
                                 "string",
                                 "null"
                              ],
                              "description": "Client name of the boarding door, as it appears in npcs.yaml. Omitted means the run has none."
                           },
                           "every": {
                              "anyOf": [
                                 {
                                    "$ref": "#/$defs/uint32_t"
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Cycle length in seconds. Omitted on a single open-ended phase means it never repeats."
                           },
                           "offset": {
                              "anyOf": [
                                 {
                                    "$ref": "#/$defs/uint32_t"
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Seconds the cycle is shifted by, so runs sharing a ship take their turn. Defaults to 0."
                           },
                           "phases": {
                              "type": "array",
                              "items": {
                                 "type": "object",
                                 "properties": {
                                    "animation": {
                                       "anyOf": [
                                          {
                                             "type": "string",
                                             "title": "Animation",
                                             "enum": [
                                                "none",
                                                "attack",
                                                "despawn",
                                                "death",
                                                "event",
                                                "chocobo",
                                                "fishing",
                                                "open_door",
                                                "close_door",
                                                "elevator_up",
                                                "elevator_down",
                                                "animation_18",
                                                "animation_19",
                                                "animation_20",
                                                "animation_21",
                                                "animation_22",
                                                "animation_23",
                                                "animation_24",
                                                "animation_25",
                                                "animation_27",
                                                "animation_29",
                                                "fishing_npc",
                                                "healing",
                                                "animation_34",
                                                "fishing_fish",
                                                "fishing_caught",
                                                "fishing_rod_break",
                                                "fishing_line_break",
                                                "fishing_monster",
                                                "fishing_stop",
                                                "synth",
                                                "sit",
                                                "ranged",
                                                "fishing_start",
                                                "fishing_fight_1",
                                                "fishing_fight_2",
                                                "fishing_fight_3",
                                                "animation_55",
                                                "new_fishing_start",
                                                "new_fishing_fish",
                                                "new_fishing_caught",
                                                "new_fishing_rod_break",
                                                "new_fishing_line_break",
                                                "new_fishing_monster",
                                                "new_fishing_stop",
                                                "sitchair_0",
                                                "sitchair_1",
                                                "sitchair_2",
                                                "sitchair_3",
                                                "sitchair_4",
                                                "sitchair_5",
                                                "sitchair_6",
                                                "sitchair_7",
                                                "sitchair_8",
                                                "sitchair_9",
                                                "sitchair_10",
                                                "mount",
                                                "trust"
                                             ]
                                          },
                                          {
                                             "type": "null"
                                          }
                                       ],
                                       "description": "Animation the client plays, timed from the moment this phase began. Omitted leaves the previous one running."
                                    },
                                    "hide": {
                                       "anyOf": [
                                          {
                                             "$ref": "#/$defs/uint32_t"
                                          },
                                          {
                                             "type": "null"
                                          }
                                       ],
                                       "description": "Seconds into the phase after which the client stops drawing the ship, once the animation has carried it out of sight. Omitted leaves it visible throughout."
                                    },
                                    "moves": {
                                       "anyOf": [
                                          {
                                             "type": "array",
                                             "items": {
                                                "type": "object",
                                                "properties": {
                                                   "after": {
                                                      "anyOf": [
                                                         {
                                                            "$ref": "#/$defs/uint32_t"
                                                         },
                                                         {
                                                            "type": "null"
                                                         }
                                                      ],
                                                      "description": "Seconds into the phase before the ship is put there. Defaults to the start of the phase."
                                                   },
                                                   "to": {
                                                      "type": "string",
                                                      "description": "'dock', or a name from the run's places."
                                                   }
                                                },
                                                "additionalProperties": false,
                                                "required": [
                                                   "to"
                                                ]
                                             }
                                          },
                                          {
                                             "type": "null"
                                          }
                                       ],
                                       "description": "Where the ship is put during this phase, in order. Omitted leaves it wherever the last move left it."
                                    },
                                    "seconds": {
                                       "anyOf": [
                                          {
                                             "$ref": "#/$defs/uint32_t"
                                          },
                                          {
                                             "type": "null"
                                          }
                                       ],
                                       "description": "How long this phase lasts. Omit on one phase to give it whatever is left of the cycle."
                                    },
                                    "state": {
                                       "type": "string",
                                       "title": "TransportState",
                                       "description": "What the ship is doing for this stretch.",
                                       "enum": [
                                          "arriving",
                                          "docked",
                                          "departing",
                                          "cycling",
                                          "holding",
                                          "closing"
                                       ]
                                    }
                                 },
                                 "additionalProperties": false,
                                 "required": [
                                    "state"
                                 ]
                              },
                              "description": "The cycle in order, starting at the offset."
                           },
                           "places": {
                              "anyOf": [
                                 {
                                    "type": "object",
                                    "additionalProperties": {
                                       "$ref": "#/$defs/std::array<float,3>"
                                    }
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Named spots the run's moves refer to, as x, y, z. The dock is always available under that name."
                           },
                           "voyage": {
                              "anyOf": [
                                 {
                                    "type": "array",
                                    "items": {
                                       "$ref": "#/$defs/ZoneId"
                                    }
                                 },
                                 {
                                    "type": "null"
                                 }
                              ],
                              "description": "Zones the passengers may travel through. A ship whose destination is chosen at boarding time names each one. Omitted means the run carries nobody."
                           }
                        },
                        "additionalProperties": false,
                        "required": [
                           "phases"
                        ]
                     },
                     "description": "Scheduled runs it serves, keyed by name. Each takes its turn through its offset."
                  },
                  "ship": {
                     "$ref": "#/$defs/uint32_t",
                     "description": "Entity id of the ship serving this zone, which also names the zone it docks in."
                  }
               },
               "additionalProperties": false,
               "required": [
                  "ship",
                  "runs"
               ]
            },
            {
               "type": "null"
            }
         ],
         "description": "The ship docking in this zone and the runs it serves."
      },
      "type": {
         "anyOf": [
            {
               "type": "array",
               "items": {
                  "type": "string",
                  "title": "ZoneType",
                  "enum": [
                     "unknown",
                     "city",
                     "outdoors",
                     "dungeon",
                     "signet",
                     "sanction",
                     "sigil",
                     "ionis",
                     "dynamis",
                     "instanced"
                  ]
               }
            },
            {
               "type": "null"
            }
         ],
         "description": "Zone classification flags. Defaults to an empty list.",
         "uniqueItems": true
      },
      "zonelines": {
         "anyOf": [
            {
               "type": "object",
               "additionalProperties": {
                  "type": "object",
                  "properties": {
                     "at": {
                        "$ref": "#/$defs/std::vector<float>",
                        "description": "Centre of the arrival box in the destination zone, as x, y, z and optionally a facing in radians."
                     },
                     "from": {
                        "$ref": "#/$defs/std::array<float,3>",
                        "description": "Centre of the trigger box in this zone, as x, y, z."
                     },
                     "scale": {
                        "type": "array",
                        "items": {
                           "$ref": "#/$defs/float"
                        },
                        "description": "Arrival box dimensions along x and z. Players are spread across eight slots along the longer side.",
                        "maxItems": 2
                     },
                     "to": {
                        "$ref": "#/$defs/ZoneId",
                        "description": "Destination zone."
                     }
                  },
                  "additionalProperties": false,
                  "required": [
                     "from",
                     "to",
                     "at",
                     "scale"
                  ]
               }
            },
            {
               "type": "null"
            }
         ],
         "description": "Outbound transitions, keyed by their four-character client id such as z2s0."
      }
   },
