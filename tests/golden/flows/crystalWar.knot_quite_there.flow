trigger Bulwark_Gate                    # Prog 1: 107
finish
trade Bulwark_Gate OneHundredEightKnotQuipu x1 # Prog 1, the quipu: 106
finish                                  # the trade confirmed; Prog 2
trigger Bulwark_Gate                    # Prog 2: 108
finish
warp 314.321,-30.495,-67.15 EastRonfaureS
warp -13.849,1.398,-30.368 SouthernSanDoriaS open # from East Ronfaure [S] at Prog 2: 62
finish                                  # Prog 3
warp 149.733,-2.5,23.788 SouthernSanDoriaS
trigger _6eo                            # Prog 3: 63
finish                                  # completed (Platinum Beastcoin)
trigger _6eo                            # completed: no section: the default GATE_IS_LOCKED
finish-if-event
warp 125.5,-3,222.215 WindurstWatersS
trigger Door_Acolyte_Hostel_down        # completed: no section: its script
