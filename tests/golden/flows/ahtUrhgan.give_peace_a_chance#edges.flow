trigger qm8                             # NIGHT, Prog 2 (not 0): nil
finish-if-event
charvar Quest[6][9]Prog 3               # a GM
warp -10.7,-6,29.371 AhtUrhganWhitegate
fill-inventory
trigger Mishhar                         # Prog 3: 576
finish                                  # full: complete false: Prog 4
trigger Mishhar                         # Prog 4: 589
finish                                  # still full: nothing
free-inventory
trigger Mishhar                         # 589
finish                                  # completed: the Silver Piece; needToZone; Quest[6][30]Stage
