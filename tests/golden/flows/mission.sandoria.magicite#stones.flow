missionstatus Sandoria 3
trigger _6r9                            # the Optistone missing: nothing from the mission
finish-if-event
keyitem MagiciteOptistone
delkeyitem MagiciteAurastone
trigger _6r9                            # the Aurastone missing: nothing from the mission
finish-if-event
keyitem MagiciteAurastone
delkeyitem MagiciteOrastone
trigger _6r9                            # the Orastone missing: nothing from the mission
finish-if-event
warp 20,3,-56 LowerJeuno
trigger Aldo                            # the Optistone and the Aurastone: 183
finish-if-event
delkeyitem MagiciteOptistone
trigger Aldo                            # the Aurastone alone: 183
finish-if-event
delkeyitem MagiciteAurastone
keyitem MagiciteOrastone
trigger Aldo                            # the Orastone alone: 183
finish-if-event
keyitem MagiciteOptistone
delkeyitem MagiciteOrastone
trigger Aldo                            # the Optistone alone: 183
finish-if-event
keyitem MagiciteAurastone
keyitem MagiciteOrastone
warp -32,9,-47 RuludeGardens
trigger _6r9                            # the three stones and the pass: 60 (1, 0)
