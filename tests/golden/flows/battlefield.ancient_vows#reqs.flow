# Ancient Vows, the requirements. A level 75 Warrior of San d'Oria with Ancient Vows current (a GM) at Status 1 (below
# requiredValue 2), in from Riverne - Site #A01: SD_Entrance: no options. Status 2 (a GM): the menu 32000; area 2 (option 2):
# entered; its Mammets (+3..+5) killed: WON, 32001, finished: the mission completes.
lists MonarchLinn/SD_Entrance/onTrigger MonarchLinn/onEventUpdate/32000 MonarchLinn/onEventFinish/32000 MonarchLinn/onEventFinish/32001
char zone=RiverneSiteA01 pos=0,0,0 job=WAR lvl=75 nation=0
mission Cop AncientVows current
charvar Mission[6][248]Status 1
login
warp -39.1,-3.3,-537 MonarchLinn        # from A01, Status 1
trigger SD_Entrance                     # Status 1: no options
finish-if-event
charvar Mission[6][248]Status 2         # a GM
trigger SD_Entrance                     # the menu 32000
update 32000 option=2                   # area 2: entered
finish                                  # in the arena
tick 2000
kill MAMMET_19_EPSILON+3
kill MAMMET_19_EPSILON+4
kill MAMMET_19_EPSILON+5                # allDeath: WON; 32001
finish                                  # the mission completes
tick 11000
tick 10000
