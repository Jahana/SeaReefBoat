# Stamp Hunt (bastok 16): 226 with a full inventory: the Leather Gorget does not fit, so not completed and the sheet
# kept; with room, 226 again completes it. Accepted by GM with all seven stamps (Prog 127) and the sheet.
lists BastokMarkets/Arawn/onTrigger BastokMarkets/onEventFinish/226
char zone=BastokMarkets pos=-121.5,-4,-123.9 job=WAR lvl=10
quest Bastok.StampHunt accepted
charvar Quest[1][16]Prog 127
keyitem StampSheet
login
fill-inventory
trigger Arawn                  # all seven: 226
finish                         # the gorget does not fit: not completed, the sheet kept
free-inventory
trigger Arawn                  # 226 again
finish                         # completed
