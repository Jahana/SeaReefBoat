# Mog House Exposition's zone-in (section 1) against The Enduring Tumult of War, which has no Mog House guard (236),
# in Port Bastok's home Mog House: a char of nation 1, ROV off, both notSeen 1 (a GM).
char zone=PortBastok pos=-140,-7,172 job=WAR lvl=75 nation=1
setting ENABLE_ROV 0
login
mission Cop AncientFlamesBeckon completed # a GM
mission Cop TheEnduringTumultOfWar current # a GM
charvar HQuest[moghouseExpo]notSeen 1   # a GM
charvar HQuest[newCharacterCS]notSeen 1 # a GM
warp -140,-7,172 PortBastok
zoneline PortBastok                     # the home Mog House
finish
