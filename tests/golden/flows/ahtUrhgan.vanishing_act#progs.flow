# Vanishing Act's Prog tests (task 7 review of the mutants): the sickle at Prog 1 is not the quest's (the Harvesting
# Point's own script answers); area 2 at Prog 2 is not the quest's 44 (Prog 1 only).
lists AhtUrhganWhitegate/onTriggerAreaEnter/2 WajaomWoodlands/Harvesting_Point/onTrade WajaomWoodlands/onEventFinish/507
char zone=WajaomWoodlands pos=-587.328,-17.999,-200 job=WAR lvl=75
item Sickle
quest AhtUrhgan.DeliveringTheGoods completed
quest AhtUrhgan.VanishingAct accepted
charvar Quest[6][62]Prog 1
login
trade Harvesting_Point Sickle x1        # Prog 1: nil (the Harvesting Point's own script)
finish-if-event
charvar Quest[6][62]Prog 2              # a GM
warp -80,-6,115 AhtUrhganWhitegate      # south of trigger area 2
tick 1000
tick 1000
tick 1000
walk -80,-6,125                         # into area 2 at Prog 2: nil
finish-if-event
